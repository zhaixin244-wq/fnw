  if [ -f "$score_file" ]; then
    # Extract score from various patterns
    total=$(grep -oP '\*\*(?:总分|加权总分|最终评分)\*\*[^0-9]*(\d+)' "$score_file" | grep -oP '\d+' | tail -1)
