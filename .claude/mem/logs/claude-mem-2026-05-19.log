import os, re

# Final summary counts
wiki_root = 'wiki'

# Total pages
total = 0
for root, dirs, files in os.walk(wiki_root):
    for f in files:
        if f.endswith('.md'):
            total += 1

# Addresses
addr_count = 0
for root, dirs, files in os.walk(wiki_root):
    for f in files:
        if f.endswith('.md'):
            filepath = os.path.join(root, f)
            try:
                with open(filepath, 'r', encoding='utf-8', errors='ignore') as fh:
                    content = fh.read(500)
            except:
                continue
            if re.search(r'^address:\s*[cl]-\d{6}', content, re.MULTILINE):
                addr_count += 1

# Counter
with open('.vault-meta/address-counter.txt', 'r') as f:
    counter = int(f.read().strip())

# Index link count
with open(os.path.join(wiki_root, 'index.md'), 'r', encoding='utf-8') as f:
    idx = f.read()
idx_links = len(re.findall(r'\[\[[^\]]+\]\]', idx))

# Frontmatter completeness
complete = 0
missing = 0
for root, dirs, files in os.walk(wiki_root):
    dirs[:] = [d for d in dirs if d not in ('folds', 'meta')]
    for f in files:
        if not f.endswith('.md'):
            continue
        filepath = os.path.join(root, f)
        try:
            with open(filepath, 'r', encoding='utf-8', errors='ignore') as fh:
                content = fh.read(500)
        except:
            continue
        if not content.startswith('---'):
            missing += 1
            continue
        fm_end = content.find('---', 3)
        if fm_end < 0:
            missing += 1
            continue
        fm = content[3:fm_end]
        has_all = True
        for field in ['type', 'status', 'created', 'tags']:
            if not re.search(rf'^{field}:', fm, re.MULTILINE):
                has_all = False
                break
        if has_all:
            complete += 1
        else:
            missing += 1

print(f'=== FINAL STATS ===')
