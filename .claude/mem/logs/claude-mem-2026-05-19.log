[2026-05-20 13:22:35.775] [INFO ] [QUEUE ] [session-27] ENQUEUED | sessionDbId=27 | messageId=3683 | type=observation | tool=Bash(cd "D:/work/ai/fnw/arch/tools/claude-obsidian" && python -c "
import fitz, os

src_base = '.raw/sources/eda/synopsys'
tools_map = {'dc/2603': 'design-compiler', 'PrimeSuite/2603': 'primetime', 'spyglass/2603': 'spyglass', 'vc_formal/2603': 'vc-formal', 'vc_spyglass/2603': 'vc-spyglass', 'vcs/2603': 'vcs', 'verdi/2603': 'verdi'}

total_pages = 0
total_pdfs = 0
max_pdf = ('', 0)
for src_dir, tool_name in tools_map.items():
    src_path = os.path.join(src_base, src_dir)
    if not os.path.isdir(src_path):
        continue
    tool_pages = 0
    tool_pdfs = 0
    for f in sorted(os.listdir(src_path)):
        if not f.lower().endswith('.pdf'):
            continue
        pdf_path = os.path.join(src_path, f)
        try:
            doc = fitz.open(pdf_path)
            pages = len(doc)
            doc.close()
            tool_pages += pages
            tool_pdfs += 1
            if pages > max_pdf[1]:
                max_pdf = (f, pages)
        except:
            pass
    print(f'{tool_name}: {tool_pdfs} PDFs, {tool_pages} pages')
    total_pages += tool_pages
    total_pdfs += tool_pdfs

print(f'Total: {total_pdfs} PDFs, {total_pages} pages')
print(f'Largest PDF: {max_pdf[0]} ({max_pdf[1]} pages)')
" 2>&1
) | depth=1
