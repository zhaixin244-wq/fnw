    for f in files:
        if f.endswith('.md'):
            pages.add(f[:-3])
            path = os.path.join(root, f)
            rel = path.replace(os.sep, '/').replace('.md', '')
            if rel.startswith('wiki/'):
                rel = rel[5:]
            page_map[rel] = path
            page_map[f[:-3]] = path

