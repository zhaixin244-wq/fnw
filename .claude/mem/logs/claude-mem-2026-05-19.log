import os, re

# Check empty sections (headings with no content)
empty_count = 0
empty_pages = []
meta_files = ['_index.md', 'index.md', 'log.md', 'hot.md', 'overview.md', 'dashboard.md']

for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if f.endswith('.md') and f not in meta_files:
            path = os.path.join(root, f)
            try:
                with open(path, encoding='utf-8', errors='ignore') as fh:
                    lines = fh.readlines()
                for i, line in enumerate(lines):
                    if re.match(r'^#{1,6}\s+', line):
                        # Check if next non-empty line is also a heading or EOF
                        has_content = False
                        for j in range(i+1, min(i+5, len(lines))):
                            stripped = lines[j].strip()
                            if stripped and not re.match(r'^#{1,6}\s+', stripped):
                                has_content = True
                                break
                            elif re.match(r'^#{1,6}\s+', stripped):
                                break
                        if not has_content:
                            empty_count += 1
                            if len(empty_pages) < 15:
                                empty_pages.append((path, line.strip()))
            except:
                pass

print(f'=== EMPTY SECTIONS ({empty_count}) ===')
for path, heading in empty_pages:
    print(f'  - {path}: {heading}')
if empty_count > 15:
    print(f'  ... and {empty_count-15} more')
