        if name.replace('_', '-') in dpdk_name or dpdk_name.replace('-', '_') in name:
            matched += 1
            found = True
            break
    if not found:
        unmatched.append(fname)

print(f'Total .._ prefix pages: {len(prefix_pages)}')
print(f'Matched to dpdk/ pages: {matched}')
print(f'Unmatched: {len(unmatched)}')
for u in unmatched:
