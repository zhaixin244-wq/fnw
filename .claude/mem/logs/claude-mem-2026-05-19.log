import os, re
from collections import Counter

pages = set()
page_map = {}
for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if f.endswith('.md'):
            pages.add(f[:-3])
            path = os.path.join(root, f)
            rel = path.replace(os.sep, '/').replace('.md', '')
            if rel.startswith('wiki/'):
                rel = rel[5:]
            page_map[rel] = path
            page_map[f[:-3]] = path

for root, dirs, files in os.walk('wiki'):
    for f in files:
        if f == '_index.md' or (root.endswith('meta') and f.endswith('.md')):
            path = os.path.join(root, f)
            rel = path.replace(os.sep, '/').replace('.md', '')
            if rel.startswith('wiki/'):
                rel = rel[5:]
            page_map[rel] = path
            page_map[f[:-3]] = path

# Find ALL dead links with their source files
dead_links = []
for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if f.endswith('.md'):
            path = os.path.join(root, f)
            try:
                with open(path, encoding='utf-8', errors='ignore') as fh:
                    content = fh.read()
                links = re.findall(r'\[\[([^\]|#]+?)(?:[|#][^\]]*?)?\]\]', content)
                for l in links:
                    target = l.strip()
                    target_lower = target.lower()
                    if target not in pages and target not in page_map and not any(p.lower() == target_lower for p in pages):
                        dead_links.append((path, target))
            except:
                pass

print(f'Total dead links: {len(dead_links)}')
for path, target in sorted(dead_links, key=lambda x: x[1]):
    print(f'  {path}: [[{target}]]')
