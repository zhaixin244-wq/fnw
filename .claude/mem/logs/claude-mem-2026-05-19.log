import os, re

# Map tool dirs
tool_map = {
    'dc/2603': 'design-compiler',
    'PrimeSuite/2603': 'primetime',
    'SpyGlass/2603': 'spyglass',
    'vc-formal/2603': 'vc-formal',
    'vc-spyglass/2603': 'vc-spyglass',
    'vcs/2603': 'vcs',
    'verdi/2603': 'verdi',
}

wiki_dir = 'wiki/eda/synopsys'
source_dir = '.raw/sources/eda/synopsys'

# Get all wiki source references
wiki_sources = set()
for root, dirs, files in os.walk(wiki_dir):
    for f in files:
        if f.endswith('.md'):
            with open(os.path.join(root, f), 'r', encoding='utf-8') as fh:
                content = fh.read()
                # Extract source field from frontmatter
                m = re.search(r'source:\s*(.+)', content)
                if m:
                    for s in m.group(1).split(','):
                        wiki_sources.add(s.strip().lower())

# Get all source PDFs
source_pdfs = []
for root, dirs, files in os.walk(source_dir):
    for f in files:
        if f.lower().endswith('.pdf'):
            source_pdfs.append(f)

# Check which PDFs are explicitly referenced as source
explicit = []
not_explicit = []
for pdf in sorted(source_pdfs):
    name = pdf.replace('.pdf', '').lower()
    if name + '.pdf' in wiki_sources or name in wiki_sources:
        explicit.append(pdf)
    else:
        not_explicit.append(pdf)

print(f'Source PDFs with explicit wiki source reference: {len(explicit)}/{len(source_pdfs)}')
print(f'Source PDFs without explicit source reference: {len(not_explicit)}/{len(source_pdfs)}')
print()
print('PDFs without explicit source reference:')
for pdf in not_explicit:
    print(f'  - {pdf}')
