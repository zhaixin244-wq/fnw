import subprocess, json, sys, os, time, threading

PACKAGE_DIR = r"D:\work\ai\fnw\arch\tools\PPTAgent\deeppresenter"
WORKSPACE = r"D:\work\ai\fnw\arch\tools\PPTAgent\.cache\test"
CONFIG_FILE = r"D:\work\ai\fnw\arch\tools\PPTAgent\deeppresenter\config.yaml"
venv_python = r"D:\work\ai\fnw\arch\tools\PPTAgent\venv-win\Scripts\python.exe"

env = {**os.environ, "WORKSPACE": WORKSPACE, "HOST_WORKSPACE": WORKSPACE,
       "WORKSPACE_ID": "test", "CONFIG_FILE": CONFIG_FILE, "PACKAGE_DIR": PACKAGE_DIR,
       "FASTMCP_LOG_LEVEL": "WARNING", "PYTHONWARNINGS": "ignore"}

proc = subprocess.Popen(
    [venv_python, os.path.join(PACKAGE_DIR, "tools", "task.py")],
    stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env
)

# MCP initialize
init_msg = json.dumps({"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"test","version":"0.1"}}})

stdout_lines = []
stderr_lines = []

def reader(stream, label, lines):
    for line in iter(stream.readline, b''):
        decoded = line.decode().strip()
        lines.append(decoded)
        print(f"{label}: {decoded}")

t_out = threading.Thread(target=reader, args=(proc.stdout, "STDOUT", stdout_lines), daemon=True)
t_err = threading.Thread(target=reader, args=(proc.stderr, "STDERR", stderr_lines), daemon=True)
t_out.start()
t_err.start()

proc.stdin.write((init_msg + "\n").encode())
proc.stdin.flush()

# Send initialized notification
time.sleep(1)
initialized_msg = json.dumps({"jsonrpc":"2.0","method":"notifications/initialized"})
proc.stdin.write((initialized_msg + "\n").encode())
proc.stdin.flush()

# List tools
time.sleep(1)
list_tools_msg = json.dumps({"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}})
proc.stdin.write((list_tools_msg + "\n").encode())
proc.stdin.flush()

time.sleep(3)
proc.terminate()
try: proc.wait(timeout=3)
except: proc.kill()

t_out.join(timeout=2)
t_err.join(timeout=2)

# Parse responses
for line in stdout_lines:
    try:
        resp = json.loads(line)
        if "result" in resp:
            if "tools" in resp["result"]:
                tools = [t["name"] for t in resp["result"]["tools"]]
                print(f"\nAvailable tools: {tools}")
            elif "protocolVersion" in resp["result"]:
                print(f"\nServer protocol: {resp['result']['protocolVersion']}")
                print(f"Server info: {resp['result'].get('serverInfo', {})}")
    except:
        pass

print(f"\nTotal stdout: {len(stdout_lines)}, stderr: {len(stderr_lines)}")
