import os, re

# Batch add 'updated' field to ALL pages missing it (not just dpdk/qemu)
count = 0
for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if not f.endswith('.md'):
            continue
        path = os.path.join(root, f)
        try:
            with open(path, encoding='utf-8', errors='ignore') as fh:
                content = fh.read()
            
            if not content.startswith('---'):
                continue
            
            fm_end = content.find('---', 3)
            if fm_end == -1:
                continue
            
            fm = content[3:fm_end]
            if 'updated:' in fm:
                continue
            
            # Add updated field
            if 'created:' in fm:
                content = re.sub(r'(created:\s*\d{4}-\d{2}-\d{2}\s*\n)', r'\1updated: 2026-05-25\n', content, count=1)
            else:
                content = re.sub(r'---\n', '---\nupdated: 2026-05-25\n', content, count=1)
            
            with open(path, 'w', encoding='utf-8') as fh:
                fh.write(content)
            count += 1
        except:
            pass

print(f'Added updated field to {count} more pages')
