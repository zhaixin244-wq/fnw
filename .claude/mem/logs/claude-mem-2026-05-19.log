import os

WIKI = "D:/work/ai/fnw/arch/tools/claude-obsidian/wiki/eda/synopsys"
SRC = "D:/work/ai/fnw/arch/tools/claude-obsidian/.raw/sources/eda/synopsys"
EXTRACTED = "D:/work/ai/fnw/arch/tools/claude-obsidian/.raw/extracted/eda/synopsys"

TOOLS = {
    "dc": ("design-compiler", 25),
    "PrimeSuite": ("primetime", 16),
    "spyglass": ("spyglass", 57),
    "vc_formal": ("vc-formal", 29),
    "vc_spyglass": ("vc-spyglass", 21),
    "vcs": ("vcs", 80),
    "verdi": ("verdi", 52),
}

# Read all wiki page content for each tool
for src_tool, (wiki_tool, expected) in TOOLS.items():
    wiki_dir = os.path.join(WIKI, wiki_tool)
    wiki_content = ""
    for f in os.listdir(wiki_dir):
        if f.endswith(".md"):
            with open(os.path.join(wiki_dir, f), "r", encoding="utf-8") as fh:
                wiki_content += fh.read().lower()
    
    # Get source PDF names
    src_dir = os.path.join(SRC, src_tool, "2603")
    pdfs = sorted([f for f in os.listdir(src_dir) if f.endswith(".pdf")])
    
    # Check which PDFs are mentioned in wiki
    covered = []
    missing = []
    for pdf in pdfs:
        base = pdf.replace(".pdf", "").lower().replace(" ", "_").replace(" ", "")
        # Check various forms of the name
        if (base in wiki_content or 
            pdf.lower() in wiki_content or
            base.replace("_", " ") in wiki_content or
            base.replace("-", "_") in wiki_content):
            covered.append(pdf)
        else:
            missing.append(pdf)
    
    print(f"\n=== {src_tool} → {wiki_tool} ({len(pdfs)} PDFs, {len(covered)} referenced in wiki) ===")
    if missing:
        print(f"  NOT explicitly referenced ({len(missing)}):")
        for m in missing:
            print(f"    - {m}")
    else:
        print(f"  ALL {len(pdfs)} PDFs referenced!")
