import os, re

# Check stale index entries: items in index.md that don't exist as pages
wiki_root = 'wiki'
index_path = os.path.join(wiki_root, 'index.md')

with open(index_path, 'r', encoding='utf-8', errors='ignore') as f:
    index_content = f.read()

# Extract all wikilinks from index
link_pattern = re.compile(r'\[\[([^\]|]+?)(?:\|[^\]]+)?\]\]')
index_links = set(link_pattern.findall(index_content))

# Collect all page names
pages = set()
for root, dirs, files in os.walk(wiki_root):
    for f in files:
        if f.endswith('.md'):
            pages.add(f[:-3])

stale = []
for link in sorted(index_links):
    if link not in pages:
        stale.append(link)

print(f'Index links: {len(index_links)}')
print(f'Stale index entries ({len(stale)}):')
for s in stale[:30]:
    print(f'  - [[{s}]]')
if len(stale) > 30:
    print(f'  ... and {len(stale)-30} more')
