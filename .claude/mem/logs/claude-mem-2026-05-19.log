import os, re

WIKI_ROOT = 'D:/work/ai/fnw/arch/tools/claude-obsidian/wiki'
by_dir = {}

for root, dirs, files in os.walk(WIKI_ROOT):
    rel = os.path.relpath(root, WIKI_ROOT)
    if any(rel.startswith(p) for p in ['meta', 'folds', '_templates']):
        continue
    for fname in files:
        if not fname.endswith('.md'):
            continue
        fpath = os.path.join(root, fname)
        rel_path = os.path.relpath(fpath, WIKI_ROOT)
        if fname in ('index.md', 'log.md', 'hot.md', 'overview.md', 'dashboard.md', '_index.md'):
            continue
        
        with open(fpath, 'r', encoding='utf-8') as f:
            lines = f.read().split('\n')
        
        in_fm = False
        in_code = False
        file_empties = 0
        for i, line in enumerate(lines):
            stripped = line.strip()
            if i == 0 and stripped == '---':
                in_fm = True
                continue
            if in_fm:
                if stripped == '---':
                    in_fm = False
                continue
            if stripped.startswith('\`\`\`'):
                in_code = not in_code
                continue
            if in_code:
                continue
            if re.match(r'^#{1,6}\s', stripped):
                heading_level = len(re.match(r'^(#+)', stripped).group(1))
                has_body = False
                for j in range(i + 1, len(lines)):
                    ns = lines[j].strip()
                    if not ns:
                        continue
                    if ns.startswith('\`\`\`'):
                        has_body = True
                        break
                    if re.match(r'^#{1,6}\s', ns):
                        nl = len(re.match(r'^(#+)', ns).group(1))
                        has_body = nl > heading_level
                        break
                    has_body = True
                    break
                if not has_body:
                    file_empties += 1
        
        if file_empties > 0:
            top_dir = rel_path.split(os.sep)[0]
            by_dir[top_dir] = by_dir.get(top_dir, 0) + file_empties

for d, c in sorted(by_dir.items(), key=lambda x: -x[1]):
    print(f'{d}: {c}')
