import os, glob

wiki_root = 'wiki'
fixed = 0

for md_file in glob.glob(os.path.join(wiki_root, 'dpdk', '**', '*.md'), recursive=True):
    with open(md_file, 'r', encoding='utf-8', errors='replace') as f:
        content = f.read()
    
    if content.startswith('---'):
        # Check if status is missing
        end = content.find('---', 3)
        if end > 0:
            frontmatter = content[3:end]
            if 'status:' not in frontmatter:
                # Add status: reference before the closing ---
                new_fm = frontmatter.rstrip() + '\nstatus: reference\n'
                content = '---' + new_fm + '---' + content[end+3:]
                with open(md_file, 'w', encoding='utf-8') as f:
                    f.write(content)
                fixed += 1

for md_file in glob.glob(os.path.join(wiki_root, 'qemu', '**', '*.md'), recursive=True):
    with open(md_file, 'r', encoding='utf-8', errors='replace') as f:
        content = f.read()
    
    if content.startswith('---'):
        end = content.find('---', 3)
        if end > 0:
            frontmatter = content[3:end]
            if 'status:' not in frontmatter:
                new_fm = frontmatter.rstrip() + '\nstatus: reference\n'
                content = '---' + new_fm + '---' + content[end+3:]
                with open(md_file, 'w', encoding='utf-8') as f:
                    f.write(content)
                fixed += 1

print(f'Added status: reference to {fixed} files')
