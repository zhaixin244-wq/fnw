import os, re

wiki_root = 'wiki'

# Collect all page names
pages = set()
for root, dirs, files in os.walk(wiki_root):
    for f in files:
        if f.endswith('.md'):
            pages.add(f[:-3])

# Fix 1: Case mismatches (DFT->dft, PPA->ppa, STA->sta)
case_fixes = {'DFT': 'dft', 'PPA': 'ppa', 'STA': 'sta'}

# Fix 2: Path-style links - replace [[dpdk/guides/.../target]] with [[target]]
# But be smart: if basename matches 'index' or 'overview', keep the path context
path_prefixes = [
    'dpdk/guides/', 'dpdk/', 'eda/synopsys/', 'eda/',
    'qemu/system/', 'qemu/', 'concepts/', 'entities/', 'sources/',
    'sample_app_ug/'
]

link_pattern = re.compile(r'\[\[([^\]|]+?)(\|[^\]]+)?\]\]')
fixed_count = 0
files_modified = 0

for root, dirs, files in os.walk(wiki_root):
    for f in files:
        if not f.endswith('.md'):
            continue
        filepath = os.path.join(root, f)
        try:
            with open(filepath, 'r', encoding='utf-8', errors='ignore') as fh:
                content = fh.read()
        except:
            continue
        
        new_content = content
        changes = []
        
        for match in link_pattern.finditer(content):
            original = match.group(0)
            target = match.group(1)
            suffix = match.group(2) or ''
            
            new_target = None
            
            # Case fix
            if target in case_fixes:
                new_target = case_fixes[target]
            else:
                # Path-style fix
                for prefix in path_prefixes:
                    if target.startswith(prefix):
                        basename = target[len(prefix):]
                        if basename and basename in pages and basename not in ('index', '_index'):
                            new_target = basename
                        break
            
            if new_target and new_target != target:
                new_link = f'[[{new_target}{suffix}]]'
                new_content = new_content.replace(original, new_link, 1)
                changes.append(f'{original} -> {new_link}')
                fixed_count += 1
        
        if changes:
            with open(filepath, 'w', encoding='utf-8') as fh:
                fh.write(new_content)
            files_modified += 1

print(f'Fixed {fixed_count} dead links across {files_modified} files')
