import os, re

# Fix _index links in eda/synopsys/_index.md
# These use [[design-compiler/_index|Design Compiler]] but should use [[eda/synopsys/design-compiler/_index|Design Compiler]]
path = 'wiki/eda/synopsys/_index.md'
with open(path, encoding='utf-8') as f:
    content = f.read()

# Build index map
index_map = {}
for root, dirs, files in os.walk('wiki'):
    for f in files:
        if f == '_index.md':
            full_path = os.path.join(root, f)
            rel = full_path.replace(os.sep, '/').replace('.md', '').replace('wiki/', '')
            parts = rel.split('/')
            if len(parts) >= 2:
                short = parts[-2] + '/_index'
                index_map[short] = rel

new_content = content
for short, full in index_map.items():
    # Fix [[short|display]] -> [[full|display]]
    new_content = re.sub(
        rf'\[\[{re.escape(short)}\|([^\]]+)\]\]',
        rf'[[{full}|\1]]',
        new_content
    )
    # Fix [[short]] -> [[full]]
    new_content = new_content.replace(f'[[{short}]]', f'[[{full}]]')

if new_content != content:
    with open(path, 'w', encoding='utf-8') as f:
        f.write(new_content)
    print(f'Fixed {path}')

# Fix [[_index]] in subpages to use correct parent path
count = 0
for root, dirs, files in os.walk('wiki/eda'):
    for f in files:
        if not f.endswith('.md') or f == '_index.md':
            continue
        path = os.path.join(root, f)
        try:
            with open(path, encoding='utf-8', errors='ignore') as fh:
                content = fh.read()
            if '[[_index]]' in content:
                # Find the parent _index.md
                parent_dir = os.path.dirname(path)
                parent_index = os.path.join(parent_dir, '_index.md')
                if os.path.exists(parent_index):
                    rel = parent_index.replace(os.sep, '/').replace('.md', '').replace('wiki/', '')
                    new_content = content.replace('[[_index]]', f'[[{rel}]]')
                    with open(path, 'w', encoding='utf-8') as fh:
                        fh.write(new_content)
                    count += 1
        except:
            pass

print(f'Fixed [[_index]] in {count} subpages')
