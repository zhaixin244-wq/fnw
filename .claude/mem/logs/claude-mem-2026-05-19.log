for root, dirs, files in os.walk('wiki'):
    for f in files:
        if f == '_index.md':
            path = os.path.join(root, f)
            rel = path.replace(os.sep, '/').replace('.md', '')
            if rel.startswith('wiki/'):
                rel = rel[5:]
            # Extract the short name (last dir/_index)
            parts = rel.split('/')
            if len(parts) >= 2:
                short = parts[-2] + '/_index'
                index_map[short] = rel

