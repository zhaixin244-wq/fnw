import os, re

# Build a map of all page paths for path-based resolution
page_map = {}
for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if f.endswith('.md'):
            path = os.path.join(root, f)
            # Normalize path separators
            rel = path.replace(os.sep, '/').replace('.md', '')
            # Remove wiki/ prefix
            if rel.startswith('wiki/'):
                rel = rel[5:]
            page_map[rel] = path
            # Also add basename
            page_map[f[:-3]] = path

# Check dead links in dpdk/ with path resolution
dead_count = 0
resolved = 0
for root, dirs, files in os.walk('wiki/dpdk'):
    for f in files:
        if f.endswith('.md'):
            path = os.path.join(root, f)
            try:
                with open(path, encoding='utf-8', errors='ignore') as fh:
                    content = fh.read()
                links = re.findall(r'\[\[([^\]|#]+?)(?:[|#][^\]]*?)?\]\]', content)
                for l in links:
                    target = l.strip()
                    if target.startswith('../') or target.startswith('/'):
                        continue
                    if target in page_map:
                        resolved += 1
                    else:
                        dead_count += 1
            except:
                pass

