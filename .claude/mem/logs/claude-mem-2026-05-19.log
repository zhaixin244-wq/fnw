    'wiki/concepts/dft.md': 'c-000006',
    'wiki/concepts/low-power.md': 'c-000007',
    'wiki/concepts/ppa.md': 'c-000008',
    'wiki/chip-design/design-flow-detailed.md': 'c-000009',
    'wiki/chip-design/frontend-design-detailed.md': 'c-000010',
}

for path, addr in pages.items():
    with open(path, encoding='utf-8') as f:
        content = f.read()
    if 'address:' in content[:500]:
        print(f'SKIP {path}: already has address')
        continue
    # Insert address after 'created:' line
    content = re.sub(
        r'(created: .*\n)',
        rf'\1address: {addr}\n',
        content,
        count=1
    )
    with open(path, 'w', encoding='utf-8') as f:
        f.write(content)
    print(f'OK {path}: added address {addr}')
