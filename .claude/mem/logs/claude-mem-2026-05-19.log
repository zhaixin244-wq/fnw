import os, re

# Fix malformed links with trailing backslash
count = 0
for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if not f.endswith('.md'):
            continue
        path = os.path.join(root, f)
        try:
            with open(path, encoding='utf-8', errors='ignore') as fh:
                content = fh.read()
            # Fix [[xxx\_index]] -> [[xxx/_index]]
            new_content = re.sub(r'\[\[([^\]]*)\\([^\]]*)\]\]', r'[[\1\2]]', content)
            # Fix [[/interop/xxx]] -> [[xxx]]
            new_content = re.sub(r'\[\[/([^|\]]+)\]\]', r'[[\1]]', new_content)
            # Fix [[/../xxx]] -> remove
            new_content = re.sub(r'\[\[/\.\./[^\]]*\]\]', '', new_content)
            # Fix [[./index]] -> [[index]]
            new_content = new_content.replace('[[./index]]', '[[index]]')
            
            if new_content != content:
                with open(path, 'w', encoding='utf-8') as fh:
                    fh.write(new_content)
                count += 1
        except:
            pass

print(f'Fixed malformed links in {count} files')
