# Check wiki content for key terms from each PDF
wiki_base = 'wiki/eda/synopsys'
wiki_content = {}
for tool_dir in os.listdir(wiki_base):
    tool_path = os.path.join(wiki_base, tool_dir)
    if os.path.isdir(tool_path) and tool_dir != '__pycache__':
        all_text = ""
        for f in os.listdir(tool_path):
            if f.endswith('.md'):
                with open(os.path.join(tool_path, f), 'r', encoding='utf-8') as fh:
                    all_text += fh.read().lower() + "\n"
        wiki_content[tool_dir] = all_text

# Source PDFs
src_base = '.raw/sources/eda/synopsys'
tools_map = {'dc': 'design-compiler', 'PrimeSuite': 'primetime', 'spyglass': 'spyglass', 'vc_formal': 'vc-formal', 'vc_spyglass': 'vc-spyglass', 'vcs': 'vcs', 'verdi': 'verdi'}

# Extracted text
ext_base = '.raw/extracted/eda/synopsys'

results = {'full': [], 'partial': [], 'missing': []}

for src_dir, tool_name in tools_map.items():
    src_path = os.path.join(src_base, src_dir)
    ext_path = os.path.join(ext_base, tool_name)
    if not os.path.isdir(src_path):
        continue
    
    for f in sorted(os.listdir(src_path)):
        if not f.lower().endswith('.pdf'):
            continue
        
        pdf_name = f.replace('.pdf', '').replace(' ', '_')
        tool_wiki = wiki_content.get(tool_name, '')
        
        # Method 1: Check if PDF name appears in wiki
        name_in_wiki = pdf_name.lower().replace('_', '').replace('-', '') in tool_wiki.replace('-', '').replace('_', '')
        
        # Method 2: Check mapped topics
        mapped_topics = PDF_TOPIC_MAP.get(pdf_name, '').split(',')
        topics_covered = []
        for topic in mapped_topics:
            if topic and topic.strip() in tool_wiki:
                topics_covered.append(topic.strip())
        
        # Method 3: Extract key terms from text and check wiki
        txt_path = os.path.join(ext_path, f"{pdf_name}.txt")
        key_terms_found = 0
        key_terms_total = 0
        if os.path.exists(txt_path):
            with open(txt_path, 'r', encoding='utf-8', errors='ignore') as fh:
                text = fh.read()[:5000]  # First 5000 chars
            # Extract capitalized terms (likely technical terms)
            terms = set(re.findall(r'\b[A-Z][A-Za-z]{3,}\b', text))
            # Filter common words
            common = {'The', 'This', 'That', 'With', 'From', 'Have', 'Been', 'Will', 'When', 'What', 'Note', 'User', 'Guide', 'Chapter', 'Section', 'Figure', 'Table', 'Page', 'Reference', 'Manual', 'Version', 'Release', 'Overview', 'Introduction', 'Description'}
            terms -= common
            key_terms_total = min(len(terms), 30)
            for term in list(terms)[:30]:
                if term.lower() in tool_wiki:
                    key_terms_found += 1
        
        # Determine coverage level
        score = 0
        if name_in_wiki:
            score += 30
        if topics_covered:
            score += 30
        if key_terms_total > 0:
            score += int(40 * key_terms_found / key_terms_total)
        
        entry = {'pdf': f, 'tool': tool_name, 'score': score, 'topics': topics_covered, 'name_in_wiki': name_in_wiki, 'key_terms': f"{key_terms_found}/{key_terms_total}"}
        
        if score >= 70:
            results['full'].append(entry)
        elif score >= 20:
            results['partial'].append(entry)
        else:
            results['missing'].append(entry)

print(f"=== Coverage Summary ===")
print(f"Full coverage (>=70%): {len(results['full'])} ({len(results['full'])*100//280}%)")
print(f"Partial coverage (20-69%): {len(results['partial'])} ({len(results['partial'])*100//280}%)")
print(f"Missing/Weak (<20%): {len(results['missing'])} ({len(results['missing'])*100//280}%)")
print(f"Total: {len(results['full'])+len(results['partial'])+len(results['missing'])}")

print(f"\n=== Missing/Weak Coverage ({len(results['missing'])}) ===")
for e in results['missing']:
    print(f"  [{e['tool']}] {e['pdf']} score={e['score']}% topics={e['topics']} terms={e['key_terms']}")

print(f"\n=== Partial Coverage ({len(results['partial'])}) ===")
for e in results['partial']:
    print(f"  [{e['tool']}] {e['pdf']} score={e['score']}% topics={e['topics']} terms={e['key_terms']}")
