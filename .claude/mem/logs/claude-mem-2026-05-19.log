import os

SRC = "D:/work/ai/fnw/arch/tools/claude-obsidian/.raw/sources/eda/synopsys"
WIKI = "D:/work/ai/fnw/arch/tools/claude-obsidian/wiki/eda/synopsys"
EXTRACTED = "D:/work/ai/fnw/arch/tools/claude-obsidian/.raw/extracted/eda/synopsys"

all_wiki = ""
for root, dirs, files in os.walk(WIKI):
    for f in files:
        if f.endswith(".md"):
            with open(os.path.join(root, f), "r", encoding="utf-8") as fh:
                all_wiki += fh.read().lower()

TOOLS_MAP = {"dc":"design-compiler","PrimeSuite":"primetime","spyglass":"spyglass",
             "vc_formal":"vc-formal","vc_spyglass":"vc-spyglass","vcs":"vcs","verdi":"verdi"}

covered_list = []
partial_list = []
gap_list = []

STOP = {"pages","source","page","figure","table","chapter","section","example","following",
        "however","should","would","could","about","these","those","their","there","where",
        "which","between","through","other","after","before","during","using","based","also",
        "each","from","with","this","that","have","been","were","will","into","your","when",
        "what","some","them","than","more","most","such","only","very","just","does","done",
        "because","while","still","being","here","every","under","never","since","first",
        "second","third","might","shall","makes","using","used","allow","allows","within",
        "without","against","above","below","among","along","across","around","toward"}

for src_tool, wiki_tool in TOOLS_MAP.items():
    ext_dir = os.path.join(EXTRACTED, wiki_tool)
    if not os.path.isdir(ext_dir):
        continue
    for txt in sorted(os.listdir(ext_dir)):
        if not txt.endswith(".txt"):
            continue
        fpath = os.path.join(ext_dir, txt)
        with open(fpath, "r", encoding="utf-8") as fh:
            content = fh.read(3000).lower()
        words = set()
        for w in content.split():
            w = w.strip(".,;:()[]{}\"'")
            if len(w) >= 5 and w.isalpha() and w not in STOP:
                words.add(w)
        if not words:
            covered_list.append(f"{src_tool}/{txt}")
            continue
        wiki_tokens = set(all_wiki.split())
        overlap = words & wiki_tokens
        ratio = len(overlap) / len(words)
        if ratio >= 0.20:
            covered_list.append(f"{src_tool}/{txt}")
        elif ratio >= 0.10:
            partial_list.append(f"{src_tool}/{txt}")
        else:
            gap_list.append(f"{src_tool}/{txt}")

total = len(covered_list) + len(partial_list) + len(gap_list)
cov_pct = len(covered_list) * 100 // total
par_pct = len(partial_list) * 100 // total
gap_pct = len(gap_list) * 100 // total

print("=== 覆盖率分析 ===")
print(f"完全覆盖: {len(covered_list)} ({cov_pct}%)")
print(f"部分覆盖: {len(partial_list)} ({par_pct}%)")
print(f"未覆盖:   {len(gap_list)} ({gap_pct}%)")
print(f"总计:     {total}")

print(f"\n=== 未覆盖文档 ({len(gap_list)}) ===")
for g in gap_list:
    print(f"  - {g}")

print(f"\n=== 部分覆盖文档 ({len(partial_list)}) ===")
for p in partial_list:
    print(f"  - {p}")
