        if fname in ('index.md', 'log.md', 'hot.md', 'overview.md', 'dashboard.md', '_index.md'):
            continue
        
        with open(fpath, 'r', encoding='utf-8') as f:
            content = f.read()
        lines = content.split('\n')
        
        in_fm = False
        in_code = False
        has_empty = False
        for i, line in enumerate(lines):
            stripped = line.strip()
            if i == 0 and stripped == '---':
                in_fm = True
                continue
            if in_fm:
                if stripped == '---':
                    in_fm = False
                continue
            if stripped.startswith('\`\`\`'):
