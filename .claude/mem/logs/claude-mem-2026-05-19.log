import os, re

wiki_root = 'wiki'
exclude_dirs = {'folds', 'meta'}

# Priority 3: Frontmatter backfill
# Rules by folder:
# - dpdk/**: add type=reference, status=seed, created=2026-05-22, tags=[dpdk]
# - qemu/**: add type=reference, status=seed, created=2026-05-22, tags=[qemu]
# - concepts/** with SPDK content: add created=2026-05-13, tags=[spdk]
# - eda/**: add created=2026-05-20, tags=[synopsys, eda]
# - entities/SDAE*: add type=entity, status=mature if missing
# - nics/santorini*: add type=entity, status=developing if missing

fixed = 0
files_modified = 0

def add_field(content, field, value):
    """Add a field to frontmatter if not present."""
    if not content.startswith('---'):
        return content
    fm_end = content.find('---', 3)
    if fm_end < 0:
        return content
    fm = content[3:fm_end]
    if re.search(rf'^{field}:', fm, re.MULTILINE):
        return content  # already has it
    # Insert after first ---
    lines = content.split('\n')
    insert_idx = 1
    if field == 'tags':
        lines = lines[:insert_idx] + [f'tags:\n  - {value}'] + lines[insert_idx:]
    else:
        lines = lines[:insert_idx] + [f'{field}: {value}'] + lines[insert_idx:]
    return '\n'.join(lines)

def get_frontmatter(content):
    if not content.startswith('---'):
        return ''
    fm_end = content.find('---', 3)
    if fm_end < 0:
        return ''
    return content[3:fm_end]

for root, dirs, files in os.walk(wiki_root):
    dirs[:] = [d for d in dirs if d not in exclude_dirs]
    for f in files:
        if not f.endswith('.md'):
            continue
        filepath = os.path.join(root, f)
        rel = os.path.relpath(filepath, wiki_root).replace(os.sep, '/')
        try:
            with open(filepath, 'r', encoding='utf-8', errors='ignore') as fh:
                content = fh.read()
        except:
            continue
        
        fm = get_frontmatter(content)
        if not fm:
            continue
        
        new_content = content
        changes = []
        
        # Determine folder context
        parts = rel.split('/')
        folder = parts[0] if len(parts) > 1 else ''
        
        # Get existing fields
        has_type = bool(re.search(r'^type:', fm, re.MULTILINE))
        has_status = bool(re.search(r'^status:', fm, re.MULTILINE))
        has_created = bool(re.search(r'^created:', fm, re.MULTILINE))
        has_tags = bool(re.search(r'^tags:', fm, re.MULTILINE))
        
        # Skip if already complete
        if has_type and has_status and has_created and has_tags:
            continue
        
        # DPDK pages
        if folder == 'dpdk' or rel.startswith('dpdk/'):
            if not has_type:
                new_content = add_field(new_content, 'type', 'reference')
                changes.append('type=reference')
            if not has_status:
                new_content = add_field(new_content, 'status', 'seed')
                changes.append('status=seed')
            if not has_created:
                new_content = add_field(new_content, 'created', '2026-05-22')
                changes.append('created=2026-05-22')
            if not has_tags:
                new_content = add_field(new_content, 'tags', 'dpdk')
                changes.append('tags=dpdk')
        
        # QEMU pages
        elif folder == 'qemu' or rel.startswith('qemu/'):
            if not has_type:
                new_content = add_field(new_content, 'type', 'reference')
                changes.append('type=reference')
            if not has_status:
                new_content = add_field(new_content, 'status', 'seed')
                changes.append('status=seed')
            if not has_created:
                new_content = add_field(new_content, 'created', '2026-05-22')
                changes.append('created=2026-05-22')
            if not has_tags:
                new_content = add_field(new_content, 'tags', 'qemu')
                changes.append('tags=qemu')
        
        # EDA pages
        elif folder == 'eda' or rel.startswith('eda/'):
            if not has_created:
                new_content = add_field(new_content, 'created', '2026-05-20')
                changes.append('created=2026-05-20')
            if not has_tags:
                new_content = add_field(new_content, 'tags', 'synopsys')
                changes.append('tags=synopsys')
        
        # Concepts pages (SPDK-related)
        elif folder == 'concepts' or rel.startswith('concepts/'):
            if not has_created:
                new_content = add_field(new_content, 'created', '2026-05-13')
                changes.append('created=2026-05-13')
        
        # SDAE entities
        elif 'SDAE' in f:
            if not has_type:
                new_content = add_field(new_content, 'type', 'entity')
                changes.append('type=entity')
            if not has_status:
                new_content = add_field(new_content, 'status', 'mature')
                changes.append('status=mature')
        
        # NIC pages
        elif 'santorini' in rel.lower():
            if not has_type:
                new_content = add_field(new_content, 'type', 'entity')
                changes.append('type=entity')
            if not has_status:
                new_content = add_field(new_content, 'status', 'developing')
                changes.append('status=developing')
        
        # prog_guide, linux_gsg, etc (DPDK subfolders)
        elif parts[0] in ('prog_guide', 'linux_gsg', 'freebsd_gsg', 'windows_gsg', 
                          'sample_app_ug', 'testpmd_app_ug', 'compressdevs', 'cryptodevs',
                          'nics', 'tools'):
            if not has_type:
                new_content = add_field(new_content, 'type', 'reference')
                changes.append('type=reference')
            if not has_status:
                new_content = add_field(new_content, 'status', 'seed')
                changes.append('status=seed')
            if not has_created:
                new_content = add_field(new_content, 'created', '2026-05-22')
                changes.append('created=2026-05-22')
        
        if changes:
            with open(filepath, 'w', encoding='utf-8') as fh:
                fh.write(new_content)
            files_modified += 1
            fixed += len(changes)

print(f'Frontmatter backfill: {fixed} fields added across {files_modified} files')
