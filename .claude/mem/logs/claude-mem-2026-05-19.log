[2026-05-22 21:12:55.712] [INFO ] [QUEUE ] [session-53] ENQUEUED | sessionDbId=53 | messageId=7281 | type=observation | tool=Bash(wsl -e python3 -c "
import re

with open('/mnt/d/work/ai/fnw/arch/work/sw_sdae_work/qemu_src/hw/misc/sdae.c', 'r') as f:
    code = f.read()

# Fix 1: sdae_ic_timeout - use proper pointer arithmetic
code = code.replace(
    'SDAEState *s = container_of(q, SDAEState, queues[q - s->queues]);',
    'SDAEState *s = (SDAEState *)((char *)q - offsetof(SDAEState, queues[0]));'
)

# Fix 2: Add #include for offsetof if not present
if 'stddef.h' not in code and 'offsetof' in code:
    code = code.replace('#include \"sdae_reg.h\"',
                        '#include <stddef.h>\n#include \"sdae_reg.h\"')

# Fix 3: Remove duplicate sdae_class_init function (keep sdae_pf_class_init)
# Find and remove the standalone sdae_class_init block
pattern = r'/\* =+\n \*  PF Class Init\n \* =+ \*/\nstatic void sdae_class_init\(ObjectClass \*klass, void \*data\)\n\{.*?\n\}\n'
code = re.sub(pattern, '', code, flags=re.DOTALL)

# Fix 4: Fix sdae_sriov_realize - replace old API with QEMU 8.2 API
old_sriov = '''    /* Enable SR-IOV: up to 127 VFs */
    int rc = pcie_sriov_init(pci_dev, SDAE_MAX_FUNCTIONS - 1, TYPE_SDAE_VF);
    if (rc < 0) {
        error_setg_errno(errp, -rc, \"Failed to init SR-IOV\");
        return;
    }
    pcie_sriov_set_PF_BAR_size(pci_dev, 0, SDAE_BAR0_SIZE);'''
new_sriov = '''    /* Enable SR-IOV: up to 127 VFs */
    pcie_sriov_pf_init(pci_dev, 0, TYPE_SDAE_VF,
                       SDAE_PCI_DEVICE_ID_VF,
                       SDAE_MAX_FUNCTIONS - 1,
                       SDAE_MAX_FUNCTIONS - 1, 0, 1);
    pcie_sriov_pf_init_vf_bar(pci_dev, 0,
                              PCI_BASE_ADDRESS_SPACE_MEMORY,
                              SDAE_BAR0_SIZE);'''
code = code.replace(old_sriov, new_sriov)

# Fix 5: Add k->exit to sdae_vf_class_init
code = code.replace(
    '''    dc->desc = \"Jaguar Micro SDAE DMA Accelerator (VF)\";
    dc->realize = sdae_vf_realize;
    dc->reset = sdae_reset;
}''',
    '''    dc->desc = \"Jaguar Micro SDAE DMA Accelerator (VF)\";
    dc->reset = sdae_reset;
    k->realize = sdae_vf_realize;
    k->exit = sdae_exit;
}'''
)

# Fix 6: Add k->exit to sdae_pf_class_init, change dc->realize to k->realize
code = code.replace(
    '''    dc->desc = \"Jaguar Micro SDAE DMA Accelerator (PF)\";
    dc->realize = sdae_sriov_realize;
    dc->reset = sdae_reset;
    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
}''',
    '''    dc->desc = \"Jaguar Micro SDAE DMA Accelerator (PF)\";
    dc->reset = sdae_reset;
    k->realize = sdae_sriov_realize;
    k->exit = sdae_exit;
    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
}'''
)

# Fix 7: Remove unused error_setg_errno include if not needed elsewhere
# (keep it - might be used elsewhere)

with open('/mnt/d/work/ai/fnw/arch/work/sw_sdae_work/qemu_src/hw/misc/sdae.c', 'w') as f:
    f.write(code)

print('All fixes applied successfully')
