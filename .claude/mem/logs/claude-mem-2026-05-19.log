import vsdx
import os

vsdx_path = '.raw/sources/jm-chip-str/nic/数据流图_STR_NIC.vsdx'
out_path = '.raw/sources/jm-chip-str/nic/_converted/数据流图_STR_NIC.md'

try:
    vis = vsdx.VisioFile(vsdx_path)
    lines = ['# 数据流图_STR_NIC', '']
    
    for page in vis.pages:
        lines.append(f'## Page: {page.name}')
        lines.append('')
        for shape in page.child_shapes:
            if hasattr(shape, 'text') and shape.text:
                text = shape.text.strip()
                if text:
                    lines.append(f'- {text}')
        lines.append('')
    
    with open(out_path, 'w', encoding='utf-8') as f:
        f.write('\n'.join(lines))
    print(f'OK: {len(lines)} lines extracted')
    vis.close()
except Exception as e:
    print(f'Error: {e}')
    import traceback
    traceback.print_exc()
