import os, re, glob
from collections import Counter

wiki_root = 'wiki'

existing = set()
for f in glob.glob(os.path.join(wiki_root, '**', '*.md'), recursive=True):
    rel = f.replace(os.sep, '/').replace('.md', '')
    if rel.startswith('wiki/'):
        rel = rel[5:]
    existing.add(rel)

all_links = set()
for f in glob.glob(os.path.join(wiki_root, '**', '*.md'), recursive=True):
    with open(f, 'r', encoding='utf-8', errors='replace') as fh:
        content = fh.read()
    for m in re.finditer(r'\[\[([^\]|]+)', content):
        all_links.add(m.group(1))

dead = [l for l in all_links if l not in existing]
root_dead = [l for l in dead if '/' not in l]

real_dead = []
rst_inline = []
garbage = []

for l in root_dead:
    ls = l.strip()
    if not ls:
        continue
    if '<' in ls and ls.endswith('>'):
        rst_inline.append(ls)
    elif any(c in ls for c in ['&&', '$', '"', "'", '(', ')', '{', '}']):
        garbage.append(ls)
    elif re.match(r'^\d{4}-\d{2}-\d{2}', ls):
        garbage.append(ls)
    elif re.match(r'^\d+\.', ls):
        garbage.append(ls)
    else:
        real_dead.append(ls)

# Check which real_dead actually exist with different names
existing_names = set()
for e in existing:
    name = e.split('/')[-1]
    existing_names.add(name)

matched = []
unmatched = []
for l in sorted(set(real_dead)):
    if l in existing_names:
        matched.append(l)
    else:
        unmatched.append(l)

print(f'Total dead links: {len(dead)}')
print(f'Root dead: {len(root_dead)}')
print(f'  Real page refs: {len(set(real_dead))}')
print(f'  RST inline links: {len(rst_inline)}')
print(f'  Garbage: {len(garbage)}')
print(f'  Matched to existing pages: {len(matched)}')
print(f'  Truly missing: {len(unmatched)}')

print('\nTruly missing pages (first 30):')
for l in unmatched[:30]:
    print(f'  {l}')

print('\nRST inline links (first 20):')
for l in sorted(rst_inline)[:20]:
    print(f'  {l}')
