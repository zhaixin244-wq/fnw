    "primetime": ["report_timing", "set_noise_parameters", "eco_net", "AOCV", "POCV", "CRPR", "crosstalk", "noise", "slack", "setup", "hold", "SDC", "GCA", "pt_shell", "ptc_shell"],
    "spyglass": ["sg_shell", "SGDC", "CDC", "lint", "waiver", "goal", "DFT", "ATPG", "MBIST", "PowerVerify", "low_power", "metastability", "synchronizer", "GuideWare"],
    "vc-formal": ["FPV", "FCA", "UNR", "AIP", "AXI", "AHB", "APB", "ACE", "CHI", "SVA", "property", "assert", "assume", "cover", "Orchestration", "signoff"],
    "vc-spyglass": ["CDC", "RDC", "lint", "connectivity", "power_lint", "SGDC", "VC_SpyGlass", "Goal", "Tag", "corruption", "waiver"],
    "vcs": ["vcs", "UVM", "SVA", "coverage", "FSDB", "UCLI", "NLP", "UPF", "simv", "compile", "simulate", "plusarg", "Siloti", "xprop", "race"],
    "verdi": ["nTrace", "nWave", "FSDB", "NPI", "UVM", "coverage", "UPF", "TCL", "debussy", "verdi", "waveform", "signal", "driver", "load"],
}

for tool, terms in TOOLS.items():
    wiki_dir = os.path.join(WIKI, tool)
    wiki_content = ""
    for f in os.listdir(wiki_dir):
        if f.endswith(".md"):
            with open(os.path.join(wiki_dir, f), "r", encoding="utf-8") as fh:
                wiki_content += fh.read().lower()
    
    found = [t for t in terms if t.lower() in wiki_content]
    missing = [t for t in terms if t.lower() not in wiki_content]
    pct = len(found) * 100 // len(terms)
    print(f"{tool}: {len(found)}/{len(terms)} key terms ({pct}%)")
    if missing:
        print(f"  Missing terms: {missing}")
