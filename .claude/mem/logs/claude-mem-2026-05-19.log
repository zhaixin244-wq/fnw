    "ch1_intro": (138, 151),        # Chapter 1 Introduction
    "ch2_txn_overview": (152, 170), # Transaction Layer overview
    "ch3_dll_overview": (320, 340), # Data Link Layer overview  
    "ch4_phy_overview": (362, 385), # Physical Layer overview
    "ch8_electrical": (1504, 1525), # Electrical overview
    "ch11_tdisp": (1734, 1755),     # TDISP security
}

for name, (start, end) in sections.items():
