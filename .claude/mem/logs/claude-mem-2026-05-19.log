import os, re

wiki_root = 'wiki'
exclude_dirs = {'folds', 'meta'}
exclude_files = {'_index.md', 'index.md', 'log.md', 'hot.md', 'overview.md', 'dashboard.md', 'dashboard.base', 'Wiki Map.md', 'getting-started.md'}

# Build page name -> path mapping
pages = {}
for root, dirs, files in os.walk(wiki_root):
    dirs[:] = [d for d in dirs if d not in exclude_dirs]
    for f in files:
        if f.endswith('.md') and f not in exclude_files:
            name = f[:-3]
            rel = os.path.relpath(os.path.join(root, f), wiki_root).replace(os.sep, '/')
            pages[name] = rel

# Find all dead links and their locations
link_pattern = re.compile(r'\[\[([^\]|]+?)(?:\|[^\]]+)?\]\]')
dead_links = {}  # (filepath, link_text) -> target

for root, dirs, files in os.walk(wiki_root):
    dirs[:] = [d for d in dirs if d not in exclude_dirs]
    for f in files:
        if f.endswith('.md') and f not in exclude_files:
            filepath = os.path.join(root, f)
            try:
                with open(filepath, 'r', encoding='utf-8', errors='ignore') as fh:
                    content = fh.read()
            except:
                continue
            for match in link_pattern.finditer(content):
                target = match.group(1)
                # Check if it's a dead link
                if target not in pages and '#' not in target:
                    # Try case-insensitive match
                    target_lower = target.lower()
                    match_found = False
                    for pname in pages:
                        if pname.lower() == target_lower:
                            match_found = True
                            break
                    if not match_found:
                        # Try stripping path prefix
                        if '/' in target:
                            basename = target.split('/')[-1]
                            if basename in pages:
                                match_found = True
                    if not match_found:
                        rel = os.path.relpath(filepath, wiki_root).replace(os.sep, '/')
                        dead_links[(rel, target)] = target

# Categorize
case_mismatches = {}
path_links = {}
truly_missing = {}

for (filepath, target), _ in dead_links.items():
    target_lower = target.lower()
    # Check case-insensitive
    found_case = None
    for pname in pages:
        if pname.lower() == target_lower:
            found_case = pname
            break
    if found_case:
        case_mismatches[target] = found_case
        continue
    # Check path-style
    if '/' in target:
        basename = target.split('/')[-1]
        if basename in pages:
            path_links[target] = basename
            continue
    truly_missing[target] = filepath

print(f'=== FIXABLE: Case mismatches ({len(case_mismatches)}) ===')
for wrong, correct in sorted(case_mismatches.items()):
    print(f'  [[{wrong}]] -> [[{correct}]]')

print(f'\n=== FIXABLE: Path-style links ({len(path_links)}) ===')
for wrong, correct in sorted(path_links.items())[:20]:
    print(f'  [[{wrong}]] -> [[{correct}]]')
if len(path_links) > 20:
    print(f'  ... and {len(path_links)-20} more')

print(f'\n=== TRULY MISSING ({len(truly_missing)}) ===')
for target, filepath in sorted(truly_missing.items())[:20]:
    print(f'  [[{target}]] in {filepath}')
if len(truly_missing) > 20:
    print(f'  ... and {len(truly_missing)-20} more')
