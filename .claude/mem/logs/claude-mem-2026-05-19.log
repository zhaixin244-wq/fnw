# Check if .._ prefix pages are duplicates of dpdk/ pages
prefix_dir = 'wiki/concepts'
dpdk_pages = {}
for root, dirs, files in os.walk('wiki/dpdk'):
    for f in files:
        if f.endswith('.md'):
            name = f[:-3]
            dpdk_pages[name.lower()] = os.path.join(root, f)

# Check .._ prefix pages
prefix_pages = []
for f in os.listdir(prefix_dir):
    if f.startswith('.._') and f.endswith('.md'):
        name = f[3:-3]  # strip .._ prefix and .md
        prefix_pages.append((f, name))

