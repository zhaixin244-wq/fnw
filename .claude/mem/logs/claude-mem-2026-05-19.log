import os, re

# Correct source paths with 2603 subdirectory
src_base = '.raw/sources/eda/synopsys'
tools_map = {'dc/2603': 'design-compiler', 'PrimeSuite/2603': 'primetime', 'spyglass/2603': 'spyglass', 'vc_formal/2603': 'vc-formal', 'vc_spyglass/2603': 'vc-spyglass', 'vcs/2603': 'vcs', 'verdi/2603': 'verdi'}

# Load wiki content per tool
wiki_base = 'wiki/eda/synopsys'
wiki_content = {}
for tool_dir in os.listdir(wiki_base):
    tool_path = os.path.join(wiki_base, tool_dir)
    if os.path.isdir(tool_path) and tool_dir != '__pycache__':
        all_text = ""
        for f in os.listdir(tool_path):
            if f.endswith('.md'):
                with open(os.path.join(tool_path, f), 'r', encoding='utf-8') as fh:
                    all_text += fh.read().lower() + "\n"
        wiki_content[tool_dir] = all_text

# Load extracted text per PDF
ext_base = '.raw/extracted/eda/synopsys'
ext_texts = {}
for tool_name in tools_map.values():
    ext_path = os.path.join(ext_base, tool_name)
    if os.path.isdir(ext_path):
        for f in os.listdir(ext_path):
            if f.endswith('.txt'):
                with open(os.path.join(ext_path, f), 'r', encoding='utf-8', errors='ignore') as fh:
                    ext_texts[f"{tool_name}/{f}"] = fh.read()[:8000].lower()

results = {'full': [], 'partial': [], 'weak': [], 'missing': []}

for src_dir, tool_name in tools_map.items():
    src_path = os.path.join(src_base, src_dir)
    if not os.path.isdir(src_path):
        continue
    tool_wiki = wiki_content.get(tool_name, '')
    
    for f in sorted(os.listdir(src_path)):
        if not f.lower().endswith('.pdf'):
            continue
        pdf_name = f.replace('.pdf', '').replace(' ', '_')
        
        # Check 1: PDF filename keywords in wiki
        name_keywords = re.findall(r'[a-z]{4,}', pdf_name.lower())
        name_hits = sum(1 for kw in name_keywords if kw in tool_wiki)
        name_score = name_hits / max(len(name_keywords), 1)
        
        # Check 2: Extracted text key terms in wiki
        ext_key = f"{tool_name}/{pdf_name}.txt"
        ext_text = ext_texts.get(ext_key, '')
        terms_in_text = set(re.findall(r'\b[a-z_]{5,}\b', ext_text)) - {'the', 'this', 'that', 'with', 'from', 'have', 'been', 'will', 'when', 'what', 'user', 'guide', 'chapter', 'section', 'figure', 'table', 'page', 'reference', 'manual', 'version', 'release', 'overview', 'introduction', 'description', 'should', 'following', 'example', 'command', 'option', 'default', 'specify', 'using', 'information', 'supported', 'available', 'configure', 'parameter', 'settings'}
        terms_in_text = list(terms_in_text)[:50]
        if terms_in_text:
            wiki_hits = sum(1 for t in terms_in_text if t in tool_wiki)
            term_score = wiki_hits / len(terms_in_text)
        else:
            term_score = 0
        
        # Combined score
        score = int(name_score * 40 + term_score * 60)
        
        entry = {
            'pdf': f,
            'tool': tool_name,
            'score': score,
            'name_score': int(name_score*100),
            'term_score': int(term_score*100),
            'ext_chars': len(ext_text),
        }
        
        if score >= 60:
            results['full'].append(entry)
        elif score >= 30:
            results['partial'].append(entry)
        elif score >= 10:
            results['weak'].append(entry)
        else:
            results['missing'].append(entry)

total = len(results['full']) + len(results['partial']) + len(results['weak']) + len(results['missing'])
print(f"=== Coverage Summary (280 PDFs) ===")
print(f"Full coverage (>=60%):   {len(results['full']):3d} ({len(results['full'])*100//total}%)")
print(f"Partial coverage (30-59%): {len(results['partial']):3d} ({len(results['partial'])*100//total}%)")
print(f"Weak coverage (10-29%):  {len(results['weak']):3d} ({len(results['weak'])*100//total}%)")
print(f"Missing coverage (<10%):  {len(results['missing']):3d} ({len(results['missing'])*100//total}%)")

if results['missing']:
    print(f"\n=== Missing Coverage ({len(results['missing'])}) ===")
    for e in sorted(results['missing'], key=lambda x: x['tool']):
        print(f"  [{e['tool']:20s}] {e['pdf']:50s} score={e['score']:3d}% name={e['name_score']}% terms={e['term_score']}% ext={e['ext_chars']}")

if results['weak']:
    print(f"\n=== Weak Coverage ({len(results['weak'])}) ===")
    for e in sorted(results['weak'], key=lambda x: x['tool']):
        print(f"  [{e['tool']:20s}] {e['pdf']:50s} score={e['score']:3d}% name={e['name_score']}% terms={e['term_score']}% ext={e['ext_chars']}")

print(f"\n=== Per-Tool Summary ===")
for tool in sorted(set(e['tool'] for e in results['full']+results['partial']+results['weak']+results['missing'])):
    t_full = len([e for e in results['full'] if e['tool']==tool])
    t_partial = len([e for e in results['partial'] if e['tool']==tool])
    t_weak = len([e for e in results['weak'] if e['tool']==tool])
    t_missing = len([e for e in results['missing'] if e['tool']==tool])
    t_total = t_full + t_partial + t_weak + t_missing
    print(f"  {tool:20s}: full={t_full:2d} partial={t_partial:2d} weak={t_weak:2d} missing={t_missing:2d} / {t_total}")
