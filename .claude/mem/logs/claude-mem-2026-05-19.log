from pptx import Presentation
prs = Presentation('.cache/pptoutput/pcie_physical_layer.pptx')
for i, slide in enumerate(prs.slides):
    if i >= 3: break
    print(f'Slide {i+1}: {len(list(slide.shapes))} shapes')
    shapes = list(slide.shapes)
    for j, shape in enumerate(shapes):
        w_in = shape.width / 914400
        h_in = shape.height / 914400
        is_full = w_in > 12 and h_in > 6
        if is_full or j < 2 or j >= len(shapes) - 2:
            txt = ''
            if hasattr(shape, 'text'):
                txt = shape.text[:40]
