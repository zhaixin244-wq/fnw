)

init_msg = json.dumps({"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"test","version":"0.1"}}})

stdout_lines = []
stderr_lines = []

def reader(stream, label, lines):
    for line in iter(stream.readline, b''):
        decoded = line.decode().strip()
        lines.append(decoded)
        print(f"{label}: {decoded}")

t_out = threading.Thread(target=reader, args=(proc.stdout, "STDOUT", stdout_lines), daemon=True)
t_err = threading.Thread(target=reader, args=(proc.stderr, "STDERR", stderr_lines), daemon=True)
t_out.start()
t_err.start()

proc.stdin.write((init_msg + "\n").encode())
proc.stdin.flush()

time.sleep(5)
proc.terminate()
try: proc.wait(timeout=3)
except: proc.kill()

t_out.join(timeout=2)
