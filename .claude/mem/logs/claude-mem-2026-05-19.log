import os

ext_base = '.raw/extracted/eda/synopsys'
total_files = 0
total_chars = 0
for tool in sorted(os.listdir(ext_base)):
    tool_path = os.path.join(ext_base, tool)
    if not os.path.isdir(tool_path):
        continue
    files = [f for f in os.listdir(tool_path) if f.endswith('.txt')]
    chars = 0
    for f in files:
        with open(os.path.join(tool_path, f), 'r', encoding='utf-8', errors='ignore') as fh:
            chars += len(fh.read())
    total_files += len(files)
    total_chars += chars
    print(f'{tool}: {len(files)} files, {chars//1024//1024}MB')

print(f'Total: {total_files} files, {total_chars//1024//1024}MB')
