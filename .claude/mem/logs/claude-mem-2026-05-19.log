import os, asyncio
from deeppresenter.utils.config import DeepPresenterConfig
from deeppresenter.agents.env import DeepPresenterEnv

config = DeepPresenterConfig.load_from_file()
env = DeepPresenterEnv(config, 'test-workspace')

async def test():
    await env.client.connect_server('sandbox', config.mcp_servers['sandbox'])
    # Test write_file inside Docker
    result = await env.client.tool_execute('sandbox', 'write_file', {
        'path': '/root/.cache/deeppresenter/test-workspace/test.md',
        'content': '# Test\nHello'
    })
    print('write_file result:', result)
    
    # Check if file exists from host
    import pathlib
    p = pathlib.Path('/root/.cache/deeppresenter/test-workspace/test.md')
    print('File exists on host:', p.exists())
    
    # Also try execute_command to check
    result2 = await env.client.tool_execute('sandbox', 'execute_command', {
        'command': 'cat /root/.cache/deeppresenter/test-workspace/test.md'
    })
    print('execute_command result:', result2)
    
    await env.client.cleanup()

asyncio.run(test())
