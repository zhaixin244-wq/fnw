import sys, io
sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')
import fitz

PDF = 'D:/work/ai/fnw/arch/tools/claude-obsidian/.raw/sources/pice/NCB-PCI_Express_Base_7.0.pdf'
doc = fitz.open(PDF)

# Extract key chapters for ingest
# Chapter 1: Introduction (p.139-151)
# Chapter 2: Transaction Layer (p.153-320) 
# Chapter 3: Data Link Layer (p.321-362)
# Chapter 4: Physical Layer Logical Block (p.363-710)
# Chapter 8: Electrical Sub-Block (p.1505-1638)

# First: overview pages (intro + TOC structure)
