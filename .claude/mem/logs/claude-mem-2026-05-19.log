[2026-05-22 20:35:07.008] [INFO ] [QUEUE ] [session-53] ENQUEUED | sessionDbId=53 | messageId=7099 | type=observation | tool=Bash(wsl -d Ubuntu -- bash -c "
# 1. Rename test file (QEMU uses hyphens)
mv /tmp/qemu-sdae/tests/qtest/sdae_test.c /tmp/qemu-sdae/tests/qtest/sdae-test.c

# 2. Add SDAE to hw/misc/meson.build
echo '' >> /tmp/qemu-sdae/hw/misc/meson.build
echo '# SDAE device' >> /tmp/qemu-sdae/hw/misc/meson.build
echo \"system_ss.add(when: 'CONFIG_SDAE', if_true: files('sdae.c'))\" >> /tmp/qemu-sdae/hw/misc/meson.build

# 3. Add SDAE to hw/misc/Kconfig
cat >> /tmp/qemu-sdae/hw/misc/Kconfig << 'EOF'

config SDAE
    bool
    default y if TEST_DEVICES
    depends on PCI
EOF

# 4. Add sdae-test to qtests_x86_64
# Find the line 'qtests_x86_64 = qtests_i386' and add after it
sed -i '/^qtests_x86_64 = qtests_i386$/a\qtests_x86_64 += [\"sdae-test\"]' /tmp/qemu-sdae/tests/qtest/meson.build

echo 'Integration done. Verifying:'
grep -n 'sdae' /tmp/qemu-sdae/hw/misc/meson.build
echo '---'
grep -n 'SDAE' /tmp/qemu-sdae/hw/misc/Kconfig
echo '---'
grep -n 'sdae' /tmp/qemu-sdae/tests/qtest/meson.build
") | depth=12
