import fitz, os

base = 'D:/work/ai/fnw/arch/tools/claude-obsidian/.raw/sources/eda/synopsys/'
tools = ['dc/2603', 'PrimeSuite/2603', 'spyglass/2603', 'vc_formal/2603', 'vc_spyglass/2603', 'vcs/2603', 'verdi/2603']
for t in tools:
    d = os.path.join(base, t)
    if not os.path.exists(d):
        continue
    total_img = 0
    total_page = 0
    pdf_count = 0
    for f in sorted(os.listdir(d)):
        if not f.endswith('.pdf'):
            continue
        try:
            doc = fitz.open(os.path.join(d, f))
            img_pages = sum(1 for p in doc if p.get_images())
            total_img += img_pages
            total_page += len(doc)
            pdf_count += 1
            doc.close()
        except:
            pass
    print(f'{t}: {pdf_count} PDFs, {total_page} pages, {total_img} pages with images')
