import os, re, json

wiki_root = 'wiki'
exclude_dirs = {'folds', 'meta'}

# Collect all addresses
addresses = {}  # address -> [paths]
post_rollout_no_address = []
legacy_no_address = []
bad_format = []
rollout_date = '2026-04-23'

for root, dirs, files in os.walk(wiki_root):
    dirs[:] = [d for d in dirs if d not in exclude_dirs]
    for f in files:
        if f.endswith('.md'):
            filepath = os.path.join(root, f)
            rel = os.path.relpath(filepath, wiki_root).replace(os.sep, '/')
            try:
                with open(filepath, 'r', encoding='utf-8', errors='ignore') as fh:
                    content = fh.read(1000)
            except:
                continue
            if not content.startswith('---'):
                continue
            fm_end = content.find('---', 3)
            if fm_end < 0:
                continue
            fm = content[3:fm_end]
            
            # Check for meta/fold type
            type_match = re.search(r'^type:\s*(.+)', fm, re.MULTILINE)
            if type_match:
                t = type_match.group(1).strip().strip('\"').lower()
                if t in ('meta', 'fold'):
                    continue
            
            # Get created date
            created_match = re.search(r'^created:\s*(.+)', fm, re.MULTILINE)
            created = created_match.group(1).strip() if created_match else None
            
            # Get address
            addr_match = re.search(r'^address:\s*(.+)', fm, re.MULTILINE)
            addr = addr_match.group(1).strip().strip('\"') if addr_match else None
            
            # Classify
            is_post_rollout = False
            if created and created >= rollout_date:
                is_post_rollout = True
            
            if addr:
                # Validate format
                if not re.match(r'^[cl]-\d{6}$', addr):
                    bad_format.append((rel, addr))
                # Track for uniqueness
                if addr not in addresses:
                    addresses[addr] = []
                addresses[addr].append(rel)
            else:
                if is_post_rollout:
                    post_rollout_no_address.append((rel, created))
                else:
                    legacy_no_address.append(rel)

# Check uniqueness
collisions = {a: paths for a, paths in addresses.items() if len(paths) > 1}

# Find highest c- address
c_addrs = sorted([a for a in addresses if a.startswith('c-')])
highest_c = c_addrs[-1] if c_addrs else 'none'

print(f'=== ADDRESS VALIDATION ===')
print(f'Total addresses found: {len(addresses)}')
print(f'Highest c- address: {highest_c}')
print()
print(f'Bad format ({len(bad_format)}):')
for path, addr in bad_format[:10]:
    print(f'  - {path}: \"{addr}\"')
print()
print(f'Collisions ({len(collisions)}):')
for addr, paths in collisions.items():
    print(f'  - {addr}: {paths}')
print()
print(f'Post-rollout missing address ({len(post_rollout_no_address)}):')
for path, created in post_rollout_no_address[:15]:
    print(f'  - {path} (created: {created})')
if len(post_rollout_no_address) > 15:
    print(f'  ... and {len(post_rollout_no_address)-15} more')
print()
print(f'Legacy missing address (informational): {len(legacy_no_address)} pages')
