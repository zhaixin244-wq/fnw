import os, re, glob
from collections import Counter

wiki_root = 'wiki'

# Build index of all existing pages
existing = set()
for f in glob.glob(os.path.join(wiki_root, '**', '*.md'), recursive=True):
    rel = f.replace(os.sep, '/').replace('.md', '')
    if rel.startswith('wiki/'):
        rel = rel[5:]
    existing.add(rel)

# Collect all links
all_links = set()
for f in glob.glob(os.path.join(wiki_root, '**', '*.md'), recursive=True):
    with open(f, 'r', encoding='utf-8', errors='replace') as fh:
        content = fh.read()
    for m in re.finditer(r'\[\[([^\]|]+)', content):
        all_links.add(m.group(1))

# Find dead links
dead = []
for link in sorted(all_links):
    if link not in existing:
        dead.append(link)

print(f'Total dead links: {len(dead)}')

# Categorize
cats = Counter()
for d in dead:
    parts = d.split('/')
    if len(parts) >= 2:
        cats[parts[0]] += 1
    else:
        cats['_root'] += 1

print('\\nBy category:')
for cat, count in cats.most_common(20):
    print(f'  {cat}: {count}')

# Show samples per category
print('\\nSamples:')
for cat in list(cats.keys())[:8]:
    samples = [d for d in dead if d.startswith(cat + '/') or (cat == '_root' and '/' not in d)][:3]
    for s in samples:
        print(f'  {s}')
