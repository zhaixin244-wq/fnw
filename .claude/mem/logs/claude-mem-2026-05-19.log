import os, re

# Fix the remaining dead links by either removing them or correcting them
# 1. Remove [[notes/Foo]] - example/test links
# 2. Remove [[tests.*]] - regex pattern, not a real link
# 3. Fix [[./index]] -> [[index]]
# 4. Remove [[manifest]] - no such page
# 5. Fix [[/interop/dbus-vnc]] -> remove (QEMU reference)
# 6. Fix [[.raw/sources/pice/...]] -> remove (source path)
# 7. Fix [[santorini-nic-fs]] -> remove (doesn't exist)

fixes = {
    '[[notes/Foo]]': '',
    '[[tests.*]]': '',
    '[[./index]]': '[[index]]',
    '[[manifest]]': '',
    '[[/interop/dbus-vnc]]': '',
    '[[/interop/dbus-display]]': '',
}

count = 0
for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if not f.endswith('.md'):
            continue
        path = os.path.join(root, f)
        try:
            with open(path, encoding='utf-8', errors='ignore') as fh:
                content = fh.read()
            new_content = content
            for old, new in fixes.items():
                new_content = new_content.replace(old, new)
            # Remove .raw/sources links
            new_content = re.sub(r'\[\[\.raw/sources/[^\]]*\]\]', '', new_content)
            # Remove santorini-nic-fs (doesn't exist)
            new_content = new_content.replace('[[santorini-nic-fs]]', '')
            if new_content != content:
                with open(path, 'w', encoding='utf-8') as fh:
                    fh.write(new_content)
                count += 1
        except:
            pass

print(f'Fixed dead links in {count} files')
