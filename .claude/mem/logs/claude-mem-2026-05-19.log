import os

SRC = "D:/work/ai/fnw/arch/tools/claude-obsidian/.raw/sources/eda/synopsys"

# Categorize all 280 PDFs by type
categories = {
    "UserGuide": [],
    "Reference": [],
    "Methodology": [],
    "AppNote": [],
    "ReleaseNotes": [],
    "Pin_Signal": [],
    "LCA_Guide": [],
    "Rules": [],
    "Other": [],
}

for tool_dir in ["dc/2603", "PrimeSuite/2603", "spyglass/2603", "vc_formal/2603", "vc_spyglass/2603", "vcs/2603", "verdi/2603"]:
    path = os.path.join(SRC, tool_dir)
    if not os.path.isdir(path):
        continue
    tool = tool_dir.split("/")[0]
    for f in sorted(os.listdir(path)):
        if not f.endswith(".pdf"):
            continue
        fl = f.lower()
        if "release" in fl or "rn" == fl.split(".")[-2][-2:].lower():
            categories["ReleaseNotes"].append(f"{tool}/{f}")
        elif "appnote" in fl or "app_note" in fl:
            categories["AppNote"].append(f"{tool}/{f}")
        elif "lca" in fl:
            categories["LCA_Guide"].append(f"{tool}/{f}")
        elif "pin" in fl and ("_pin" in fl or "pin_" in fl):
            categories["Pin_Signal"].append(f"{tool}/{f}")
        elif "rules" in fl or "rule" in fl:
            categories["Rules"].append(f"{tool}/{f}")
        elif "methodology" in fl or "guide" in fl and "user" not in fl:
            categories["Methodology"].append(f"{tool}/{f}")
        elif "userguide" in fl or "user_guide" in fl or "ug" == fl.split(".")[-2][-2:].lower():
            categories["UserGuide"].append(f"{tool}/{f}")
        elif "reference" in fl or "ref" in fl:
            categories["Reference"].append(f"{tool}/{f}")
        else:
            categories["Other"].append(f"{tool}/{f}")

print("=== PDF 分类统计 ===\n")
total = 0
for cat, files in sorted(categories.items(), key=lambda x: -len(x[1])):
    print(f"{cat}: {len(files)} 个")
    for f in files[:5]:
        print(f"  - {f}")
    if len(files) > 5:
        print(f"  ... +{len(files)-5} more")
    total += len(files)
print(f"\n总计: {total} 个 PDF")
