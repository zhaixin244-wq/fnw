import subprocess, json, sys, os, time, threading

PACKAGE_DIR = r"D:\work\ai\fnw\arch\tools\PPTAgent\deeppresenter"
WORKSPACE = r"D:\work\ai\fnw\arch\tools\PPTAgent\.cache\test"
WORKSPACE_ID = "test"
CONFIG_FILE = r"D:\work\ai\fnw\arch\tools\PPTAgent\config.yaml"

script_path = os.path.join(PACKAGE_DIR, "tools", "task.py")
print(f"Script exists: {os.path.exists(script_path)}")
print(f"Python: {sys.executable}")

full_env = {**os.environ, "WORKSPACE": WORKSPACE, "HOST_WORKSPACE": WORKSPACE,
            "WORKSPACE_ID": WORKSPACE_ID, "CONFIG_FILE": CONFIG_FILE, "PACKAGE_DIR": PACKAGE_DIR,
            "FASTMCP_LOG_LEVEL": "CRITICAL", "PYTHONWARNINGS": "ignore"}

proc = subprocess.Popen(
    [sys.executable, script_path],
    stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=full_env
)

init_msg = json.dumps({"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"test","version":"0.1"}}})

stdout_lines = []
stderr_lines = []

def reader(stream, label, lines):
    for line in iter(stream.readline, b''):
        decoded = line.decode().strip()
        lines.append(decoded)
        print(f"{label}: {decoded}")

t_out = threading.Thread(target=reader, args=(proc.stdout, "STDOUT", stdout_lines), daemon=True)
t_err = threading.Thread(target=reader, args=(proc.stderr, "STDERR", stderr_lines), daemon=True)
t_out.start()
t_err.start()

proc.stdin.write((init_msg + "\n").encode())
proc.stdin.flush()

time.sleep(5)
proc.terminate()
try: proc.wait(timeout=3)
except: proc.kill()

t_out.join(timeout=2)
t_err.join(timeout=2)
print(f"\nExit code: {proc.returncode}")
print(f"Total stdout lines: {len(stdout_lines)}")
print(f"Total stderr lines: {len(stderr_lines)}")
