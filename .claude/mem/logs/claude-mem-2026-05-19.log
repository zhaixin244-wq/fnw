# Check index.md for stale entries (links to non-existent pages)
index_path = 'wiki/index.md'
pages = set()
for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if f.endswith('.md'):
            pages.add(f[:-3])

with open(index_path, encoding='utf-8', errors='ignore') as f:
    content = f.read()

links = re.findall(r'\[\[([^\]|#]+?)(?:[|#][^\]]*?)?\]\]', content)
stale = [l for l in links if l.strip() not in pages]
print(f'=== STALE INDEX ENTRIES ({len(stale)}) ===')
for s in sorted(set(stale))[:30]:
    print(f'  - [[{s}]]')
if len(set(stale)) > 30:
    print(f'  ... and {len(set(stale))-30} more')
