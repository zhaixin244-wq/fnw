[2026-05-22 22:17:16.839] [INFO ] [QUEUE ] [session-54] ENQUEUED | sessionDbId=54 | messageId=7393 | type=observation | tool=Bash(cd "D:/work/ai/fnw/arch/tools/claude-obsidian" && python3 -c "
import os, glob

wiki_root = 'wiki'
fixed = 0

for md_file in glob.glob(os.path.join(wiki_root, '**', '*.md'), recursive=True):
    with open(md_file, 'r', encoding='utf-8', errors='replace') as f:
        content = f.read()
    
    if not content.startswith('---'):
        continue
    
    end = content.find('---', 3)
    if end < 0:
        continue
    
    frontmatter = content[3:end]
    if 'status:' in frontmatter:
        continue
    
    # Determine appropriate status based on path
    rel_path = md_file.replace(os.sep, '/')
    if 'dpdk/' in rel_path or 'qemu/' in rel_path:
        status = 'reference'
    elif 'concepts/' in rel_path:
        status = 'seed'
    elif 'chip-design/' in rel_path:
        status = 'developing'
    else:
        status = 'seed'
    
    new_fm = frontmatter.rstrip() + f'\nstatus: {status}\n'
    content = '---' + new_fm + '---' + content[end+3:]
    with open(md_file, 'w', encoding='utf-8') as f:
        f.write(content)
    fixed += 1

print(f'Fixed {fixed} frontmatter gaps')
") | depth=1
