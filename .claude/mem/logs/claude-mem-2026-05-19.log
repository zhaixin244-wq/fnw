import os, re

# Fix relative path links in dpdk/ pages
# Convert [[../xxx/yyy]] to [[yyy]] (use basename)
fixed_count = 0
fixed_files = set()

for root, dirs, files in os.walk('wiki/dpdk'):
    for f in files:
        if f.endswith('.md'):
            path = os.path.join(root, f)
            try:
                with open(path, encoding='utf-8', errors='ignore') as fh:
                    content = fh.read()
                
                # Find relative path links
                def fix_link(m):
                    full = m.group(0)
                    target = m.group(1)
                    if target.startswith('../'):
                        # Extract basename
                        basename = target.split('/')[-1]
                        return f'[[{basename}]]'
                    return full
                
                new_content = re.sub(r'\[\[([^\]|#]+?)(?:[|#][^\]]*?)?\]\]', fix_link, content)
                
                if new_content != content:
                    with open(path, 'w', encoding='utf-8') as fh:
                        fh.write(new_content)
                    fixed_count += 1
                    fixed_files.add(path)
            except:
                pass

print(f'Fixed relative path links in {fixed_count} files')
