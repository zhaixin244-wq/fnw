import os, re

WIKI_ROOT = 'D:/work/ai/fnw/arch/tools/claude-obsidian/wiki'
count = 0
samples = []

for root, dirs, files in os.walk(WIKI_ROOT):
    rel = os.path.relpath(root, WIKI_ROOT)
    if any(rel.startswith(p) for p in ['meta', 'folds', '_templates']):
        continue
    for fname in files:
        if not fname.endswith('.md'):
            continue
        fpath = os.path.join(root, fname)
        rel_path = os.path.relpath(fpath, WIKI_ROOT)
        if fname in ('index.md', 'log.md', 'hot.md', 'overview.md', 'dashboard.md', '_index.md'):
            continue
        
        with open(fpath, 'r', encoding='utf-8') as f:
            lines = f.read().split('\n')
        
        in_fm = False
        in_code = False
        for i, line in enumerate(lines):
            stripped = line.strip()
            # Track frontmatter
            if i == 0 and stripped == '---':
                in_fm = True
                continue
            if in_fm:
                if stripped == '---':
                    in_fm = False
                continue
            # Track code blocks
            if stripped.startswith('\`\`\`'):
                in_code = not in_code
                continue
            if in_code:
                continue
            # Check for heading
            if re.match(r'^#{1,6}\s', stripped):
                heading_level = len(re.match(r'^(#+)', stripped).group(1))
                # Check if next non-empty line is same/higher heading or EOF
                has_body = False
                for j in range(i + 1, len(lines)):
                    next_stripped = lines[j].strip()
                    if not next_stripped:
                        continue
                    if next_stripped.startswith('\`\`\`'):
                        # code block counts as content
                        has_body = True
                        break
                    if re.match(r'^#{1,6}\s', next_stripped):
                        next_level = len(re.match(r'^(#+)', next_stripped).group(1))
                        if next_level <= heading_level:
                            has_body = False
                        else:
                            has_body = True  # sub-heading
                        break
                    has_body = True
                    break
                if not has_body:
                    count += 1
                    if len(samples) < 15:
                        samples.append(f'{rel_path}:{i+1} {stripped[:80]}')

print(f'Truly empty sections (outside code blocks): {count}')
for s in samples:
    print(s)
