import os, re

# Find all post-rollout pages missing address, with their folders
wiki_root = 'wiki'
exclude_dirs = {'folds', 'meta'}
rollout_date = '2026-04-23'
missing = {}  # folder -> count

for root, dirs, files in os.walk(wiki_root):
    dirs[:] = [d for d in dirs if d not in exclude_dirs]
    for f in files:
        if f.endswith('.md'):
            filepath = os.path.join(root, f)
            rel = os.path.relpath(filepath, wiki_root).replace(os.sep, '/')
            try:
                with open(filepath, 'r', encoding='utf-8', errors='ignore') as fh:
                    content = fh.read(500)
            except:
                continue
            if not content.startswith('---'):
                continue
            fm_end = content.find('---', 3)
            if fm_end < 0:
                continue
            fm = content[3:fm_end]
            
            type_match = re.search(r'^type:\s*(.+)', fm, re.MULTILINE)
            if type_match:
                t = type_match.group(1).strip().strip('\"').lower()
                if t in ('meta', 'fold'):
                    continue
            
            created_match = re.search(r'^created:\s*(.+)', fm, re.MULTILINE)
            created = created_match.group(1).strip() if created_match else None
            
            addr_match = re.search(r'^address:', fm, re.MULTILINE)
            
            if created and created >= rollout_date and not addr_match:
                folder = rel.split('/')[0] if '/' in rel else 'root'
                missing[folder] = missing.get(folder, 0) + 1

print('Post-rollout pages missing address by folder:')
for folder, count in sorted(missing.items(), key=lambda x: -x[1]):
    print(f'  {folder}: {count}')
print(f'  Total: {sum(missing.values())}')
