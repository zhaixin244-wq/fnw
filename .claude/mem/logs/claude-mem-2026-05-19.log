import os, re, glob

wiki_root = 'wiki'
fixes = 0

for md_file in glob.glob(os.path.join(wiki_root, '**', '*.md'), recursive=True):
    with open(md_file, 'r', encoding='utf-8', errors='replace') as f:
        content = f.read()
    
    file_dir = os.path.dirname(md_file)
    
    def resolve_relative(match):
        global fixes
        link_text = match.group(1)
        # Skip if not a relative path
        if not link_text.startswith('../'):
            return match.group(0)
        
        # Resolve relative path
        parts = link_text.split('/')
        resolved = file_dir
        for part in parts:
            if part == '..':
                resolved = os.path.dirname(resolved)
            elif part:
                resolved = os.path.join(resolved, part)
        
        # Convert to wiki-relative path
        resolved = resolved.replace(os.sep, '/')
        if resolved.startswith('wiki/'):
            resolved = resolved[5:]  # Remove 'wiki/' prefix
        
        fixes += 1
        return f'[[{resolved}]]'
    
    new_content = re.sub(r'\[\[([^\]]*)\]\]', resolve_relative, content)
    
    if new_content != content:
        with open(md_file, 'w', encoding='utf-8') as f:
            f.write(new_content)

print(f'Fixed {fixes} relative links')
