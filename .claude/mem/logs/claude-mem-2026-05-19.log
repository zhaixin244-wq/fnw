import os, re

# Check naming conventions: filenames should be Title Case with spaces
wiki_root = 'wiki'
exclude_dirs = {'folds', 'meta', '.omc', 'canvases', '_templates'}
bad_names = []

for root, dirs, files in os.walk(wiki_root):
    dirs[:] = [d for d in dirs if d not in exclude_dirs]
    for f in files:
        if f.endswith('.md'):
            name = f[:-3]
            rel = os.path.relpath(os.path.join(root, f), wiki_root).replace(os.sep, '/')
            # Skip special files
            if name in ('_index', 'index', 'log', 'hot', 'overview', 'dashboard', 'Wiki Map', 'getting-started'):
                continue
            # Check for common issues
            if name.startswith('.'):
                bad_names.append((rel, 'hidden file'))
            elif '_' in name and '-' in name:
                pass  # mixed is OK for some domains
            elif name.islower() and ' ' not in name and '-' not in name:
                bad_names.append((rel, 'all lowercase, no separators'))

print(f'=== NAMING ISSUES ({len(bad_names)}) ===')
for path, issue in bad_names[:20]:
    print(f'  - {path}: {issue}')
if len(bad_names) > 20:
    print(f'  ... and {len(bad_names)-20} more')
