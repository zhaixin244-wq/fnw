import os, re

# Count pages by type for summary
wiki_root = 'wiki'
exclude_dirs = {'folds', 'meta'}
type_counts = {}
status_counts = {}
no_type = 0
total = 0

for root, dirs, files in os.walk(wiki_root):
    dirs[:] = [d for d in dirs if d not in exclude_dirs]
    for f in files:
        if f.endswith('.md'):
            total += 1
            filepath = os.path.join(root, f)
            try:
                with open(filepath, 'r', encoding='utf-8', errors='ignore') as fh:
                    content = fh.read(500)
            except:
                continue
            if content.startswith('---'):
                fm_end = content.find('---', 3)
                if fm_end > 0:
                    fm = content[3:fm_end]
                    type_match = re.search(r'^type:\s*(.+)', fm, re.MULTILINE)
                    status_match = re.search(r'^status:\s*(.+)', fm, re.MULTILINE)
                    if type_match:
                        t = type_match.group(1).strip().strip('\"')
                        type_counts[t] = type_counts.get(t, 0) + 1
                    else:
                        no_type += 1
                    if status_match:
                        s = status_match.group(1).strip().strip('\"')
                        status_counts[s] = status_counts.get(s, 0) + 1

print(f'Total pages: {total}')
print(f'Pages without type: {no_type}')
print()
print('By type:')
for t, c in sorted(type_counts.items(), key=lambda x: -x[1]):
    print(f'  {t}: {c}')
print()
print('By status:')
for s, c in sorted(status_counts.items(), key=lambda x: -x[1]):
    print(f'  {s}: {c}')
