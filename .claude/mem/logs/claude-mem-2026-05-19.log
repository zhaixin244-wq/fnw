import os, re

# Get all existing page names
pages = set()
for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if f.endswith('.md'):
            pages.add(f[:-3])

# Read index.md
with open('wiki/index.md', encoding='utf-8') as f:
    lines = f.readlines()

# Find dead link lines
new_lines = []
removed = 0
for line in lines:
    links = re.findall(r'\[\[([^\]|#]+?)(?:[|#][^\]]*?)?\]\]', line)
    if links:
        all_dead = all(l.strip() not in pages for l in links)
        if all_dead and links:
            removed += 1
            continue
    new_lines.append(line)

print(f'Removed {removed} dead link lines from index.md')
print(f'Original: {len(lines)} lines -> New: {len(new_lines)} lines')

with open('wiki/index.md', 'w', encoding='utf-8') as f:
    f.writelines(new_lines)
" 2>&1) | depth=1
