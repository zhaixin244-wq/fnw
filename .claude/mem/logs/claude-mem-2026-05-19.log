import olefile

doc_path = '.raw/sources/jm-chip-str/nic/Santorini-NIC软硬件接口梳理.doc'
out_path = '.raw/sources/jm-chip-str/nic/_converted/Santorini-NIC软硬件接口梳理.md'

try:
    ole = olefile.OleFileIO(doc_path)
    print('Streams:', ole.listdir())
    
    # Try WordDocument stream
    if ole.exists('WordDocument'):
        stream = ole.openstream('WordDocument')
        data = stream.read()
        # Try to extract readable text
        text = data.decode('gbk', errors='ignore')
        lines = []
        for line in text.split('\r'):
            line = line.strip()
            if line and len(line) > 1 and not line.startswith('\x00'):
                # Filter out binary garbage
                if any(c.isalnum() or c in '.,;:!?()[]{}' for c in line):
                    lines.append(line)
        
        with open(out_path, 'w', encoding='utf-8') as f:
            f.write('\n'.join(lines[:1000]))
        print(f'OK: extracted {min(len(lines), 1000)} lines')
    else:
        print('No WordDocument stream')
    ole.close()
except Exception as e:
    print(f'Error: {e}')
    import traceback
    traceback.print_exc()
