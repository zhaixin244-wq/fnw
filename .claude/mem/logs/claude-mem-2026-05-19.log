for f in glob.glob(os.path.join(wiki_root, '**', '*.md'), recursive=True):
    basename = os.path.splitext(os.path.basename(f))[0]
    rel = f.replace(os.sep, '/').replace('.md', '')
    if rel.startswith('wiki/'):
        rel = rel[5:]
    existing_full.add(rel)
    if basename not in existing_basenames:
        existing_basenames[basename] = []
    existing_basenames[basename].append(rel)

# Read index.md
