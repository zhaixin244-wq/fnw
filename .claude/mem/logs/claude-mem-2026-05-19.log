        text += doc[i].get_text()
    outpath = f'/tmp/pcie7_{name}.txt'
    with open(outpath, 'w', encoding='utf-8') as f:
        f.write(text)
    print(f"{name}: pages {start+1}-{end}, {len(text)} chars -> {outpath}")

doc.close()
