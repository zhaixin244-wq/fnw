import os, re, sys

wiki_root = 'wiki'
exclude_dirs = {'folds', 'meta'}
exclude_files = {'_index.md', 'index.md', 'log.md', 'hot.md', 'overview.md', 'dashboard.md', 'dashboard.base', 'Wiki Map.md', 'getting-started.md'}

# Collect all page names (without .md extension)
pages = set()
page_paths = {}
for root, dirs, files in os.walk(wiki_root):
    # Skip excluded dirs
    dirs[:] = [d for d in dirs if d not in exclude_dirs]
    for f in files:
        if f.endswith('.md') and f not in exclude_files:
            name = f[:-3]
            pages.add(name)
            rel = os.path.relpath(os.path.join(root, f), wiki_root).replace(os.sep, '/')
            page_paths[name] = rel

# Extract all wikilinks from all pages
link_pattern = re.compile(r'\[\[([^\]|]+?)(?:\|[^\]]+)?\]\]')
all_links = {}  # page -> set of linked names
linked_by = {}  # page -> set of pages that link to it

for root, dirs, files in os.walk(wiki_root):
    dirs[:] = [d for d in dirs if d not in exclude_dirs]
    for f in files:
        if f.endswith('.md') and f not in exclude_files:
            src_name = f[:-3]
            filepath = os.path.join(root, f)
            try:
                with open(filepath, 'r', encoding='utf-8', errors='ignore') as fh:
                    content = fh.read()
            except:
                continue
            links = set(link_pattern.findall(content))
            all_links[src_name] = links
            for target in links:
                if target not in linked_by:
                    linked_by[target] = set()
                linked_by[target].add(src_name)

# 1. Orphan pages (no inbound links, not in index.md)
orphans = []
for name in sorted(pages):
    if name not in linked_by or len(linked_by[name]) == 0:
        orphans.append(name)

# 2. Dead links (target not in pages)
dead_links = {}
for src, targets in all_links.items():
    for t in targets:
        if t not in pages and t not in exclude_files:
            if t not in dead_links:
                dead_links[t] = []
            dead_links[t].append(src)

print(f'Total pages: {len(pages)}')
print(f'Total unique links: {sum(len(v) for v in all_links.values())}')
print()
print(f'=== ORPHAN PAGES ({len(orphans)}) ===')
for o in orphans[:50]:
    print(f'  - {o} ({page_paths.get(o, \"?\")})')
if len(orphans) > 50:
    print(f'  ... and {len(orphans)-50} more')
print()
print(f'=== DEAD LINKS ({len(dead_links)}) ===')
for target, sources in sorted(dead_links.items())[:50]:
    print(f'  - [[{target}]] referenced in: {\", \".join(sorted(sources)[:3])}')
if len(dead_links) > 50:
    print(f'  ... and {len(dead_links)-50} more')
