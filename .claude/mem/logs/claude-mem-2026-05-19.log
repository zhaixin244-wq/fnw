import os

files = [
    'wiki/qemu/interop/qemu-ga-ref.md',
    'wiki/qemu/interop/qemu-ga.md',
    'wiki/qemu/interop/qemu-qmp-ref.md',
    'wiki/qemu/interop/qemu-storage-daemon-qmp-ref.md',
    'wiki/qemu/interop/vfio-user.md',
    'wiki/qemu/interop/vhost-user-gpu.md',
    'wiki/qemu/interop/vhost-user.md',
    'wiki/qemu/interop/vhost-vdpa.md',
    'wiki/qemu/interop/vnc-ledstate-pseudo-encoding.md',
]

for f in files:
    with open(f, 'r', encoding='utf-8', errors='replace') as fh:
        content = fh.read()
    
    # Extract title from first heading
    title = ''
    for line in content.split('\n'):
        if line.startswith('# '):
            title = line[2:].strip()
            break
    
    rel = f.replace('wiki/', '').replace(os.sep, '/')
    fm = f'''---
source: qemu/{rel.replace('.md', '.rst')}
title: \"{title}\"
type: reference
status: reference
---

'''
    with open(f, 'w', encoding='utf-8') as fh:
        fh.write(fm + content)
    print(f'Fixed: {f}')
") | depth=1
