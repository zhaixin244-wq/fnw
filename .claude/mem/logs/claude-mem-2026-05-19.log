import os, re

# Fix escaped pipe in wikilinks: [[target\|display]] -> [[target|display]]
count = 0
for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if not f.endswith('.md'):
            continue
        path = os.path.join(root, f)
        try:
            with open(path, encoding='utf-8', errors='ignore') as fh:
                content = fh.read()
            # Fix [[xxx\|yyy]] -> [[xxx|yyy]]
            new_content = content.replace('\\|', '|')
            if new_content != content:
                with open(path, 'w', encoding='utf-8') as fh:
                    fh.write(new_content)
                count += 1
        except:
            pass

print(f'Fixed escaped pipes in {count} files')
