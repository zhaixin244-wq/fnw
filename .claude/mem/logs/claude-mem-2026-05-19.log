import os, re

# Analyze dead links in dpdk/ pages - categorize by type
dead_links = []
for root, dirs, files in os.walk('wiki/dpdk'):
    for f in files:
        if f.endswith('.md'):
            path = os.path.join(root, f)
            try:
                with open(path, encoding='utf-8', errors='ignore') as fh:
                    content = fh.read()
                links = re.findall(r'\[\[([^\]|#]+?)(?:[|#][^\]]*?)?\]\]', content)
                for l in links:
                    dead_links.append((path, l.strip()))
            except:
                pass

# Categorize
rel_path = [l for l in dead_links if l[1].startswith('../')]
abs_path = [l for l in dead_links if l[1].startswith('/')]
other = [l for l in dead_links if not l[1].startswith('../') and not l[1].startswith('/')]

print(f'Total links in dpdk/: {len(dead_links)}')
print(f'Relative path (../): {len(rel_path)}')
print(f'Absolute path (//): {len(abs_path)}')
print(f'Other: {len(other)}')

# Show unique relative path targets
rel_targets = set()
for _, l in rel_path:
    rel_targets.add(l)
print(f'\nUnique relative path targets: {len(rel_targets)}')
for t in sorted(rel_targets)[:15]:
    print(f'  {t}')
" 2>&1) | depth=1
