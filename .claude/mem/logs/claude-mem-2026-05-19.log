import os, re
from collections import Counter

pages = set()
page_map = {}
for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if f.endswith('.md'):
            pages.add(f[:-3])
            path = os.path.join(root, f)
            rel = path.replace(os.sep, '/').replace('.md', '')
            if rel.startswith('wiki/'):
                rel = rel[5:]
            page_map[rel] = path
            page_map[f[:-3]] = path

# Also add _index pages (excluded from main scan but exist)
for root, dirs, files in os.walk('wiki'):
    for f in files:
        if f == '_index.md':
            path = os.path.join(root, f)
            rel = path.replace(os.sep, '/').replace('.md', '').replace('wiki/', '')
            page_map[rel] = path

dead_targets = Counter()
for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if f.endswith('.md'):
            path = os.path.join(root, f)
            try:
                with open(path, encoding='utf-8', errors='ignore') as fh:
                    content = fh.read()
                links = re.findall(r'\[\[([^\]|#]+?)(?:[|#][^\]]*?)?\]\]', content)
                for l in links:
