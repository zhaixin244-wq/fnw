import os, re

wiki_root = 'wiki'

# Collect pages by domain
dpdk_pages = []
qemu_pages = []
eda_by_tool = {
    'Design Compiler': [],
    'PrimeTime': [],
    'SpyGlass': [],
    'VC Formal': [],
    'VC SpyGlass': [],
    'VCS': [],
    'Verdi': [],
    '总览': [],
}

for root, dirs, files in os.walk(wiki_root):
    for f in files:
        if not f.endswith('.md'):
            continue
        rel = os.path.relpath(os.path.join(root, f), wiki_root).replace(os.sep, '/')
        name = f[:-3]
        
        # DPDK top-level pages
        if rel.startswith('dpdk/') and '/' not in rel[5:]:
            dpdk_pages.append(name)
        
        # QEMU top-level pages  
        if rel.startswith('qemu/') and rel.count('/') == 1:
            qemu_pages.append(name)
        
        # EDA pages
        if rel.startswith('eda/synopsys/'):
            parts = rel.split('/')
            if len(parts) >= 3:
                tool_dir = parts[2]
                if tool_dir == 'design-compiler':
                    eda_by_tool['Design Compiler'].append(name)
                elif tool_dir == 'primetime':
                    eda_by_tool['PrimeTime'].append(name)
                elif tool_dir == 'spyglass':
                    eda_by_tool['SpyGlass'].append(name)
                elif tool_dir == 'vc-formal':
                    eda_by_tool['VC Formal'].append(name)
                elif tool_dir == 'vc-spyglass':
                    eda_by_tool['VC SpyGlass'].append(name)
                elif tool_dir == 'vcs':
                    eda_by_tool['VCS'].append(name)
                elif tool_dir == 'verdi':
                    eda_by_tool['Verdi'].append(name)
                elif len(parts) == 3:  # top-level eda page
                    eda_by_tool['总览'].append(name)

print(f'DPDK top-level: {len(dpdk_pages)}')
print(f'QEMU top-level: {len(qemu_pages)}')
for tool, pages in eda_by_tool.items():
    if pages:
        print(f'EDA {tool}: {len(pages)}')

# Read index
with open(os.path.join(wiki_root, 'index.md'), 'r', encoding='utf-8') as f:
    content = f.read()

# Fill QEMU section
qemu_section = '\n### QEMU 模拟器\n\n'
for name in sorted(qemu_pages)[:20]:
    qemu_section += f'- [[{name}]]\n'
if len(qemu_pages) > 20:
    qemu_section += f'\n*... 共 {len(qemu_pages)} 个页面*\n'

# Fill DPDK section
dpdk_section = '\n### DPDK 数据平面开发套件\n\n'
for name in sorted(dpdk_pages)[:20]:
    dpdk_section += f'- [[{name}]]\n'
if len(dpdk_pages) > 20:
    dpdk_section += f'\n*... 共 {len(dpdk_pages)} 个页面*\n'

# Replace empty sections
content = content.replace('\n### QEMU 模拟器\n\n\n### DPDK', 
                          qemu_section + '\n### DPDK')
content = content.replace('\n### DPDK 数据平面开发套件\n\n\n---',
                          dpdk_section + '\n---')

# Fill EDA subsections
for tool, pages in eda_by_tool.items():
    if not pages:
        continue
    # Find the empty section and fill it
    old = f'\n### {tool}（'
    if tool == '总览':
        old = f'\n### {tool}\n\n\n### Design Compiler'
    # Find the section header
    if tool != '总览':
        # Match the section header through to the next section
        pattern = rf'(### {re.escape(tool)}（[^)]*）)\n\n\n(### )'
        match = re.search(pattern, content)
        if match:
            header = match.group(1)
            next_header = match.group(2)
            pages_text = '\n'.join(f'- [[{p}]]' for p in sorted(pages)[:15])
            if len(pages) > 15:
                pages_text += f'\n- *... 共 {len(pages)} 个页面*'
            replacement = f'{header}\n\n{pages_text}\n\n\n{next_header}'
            content = content[:match.start()] + replacement + content[match.end():]
    else:
        # 总览 section - fill before Design Compiler
        pattern = r'(### 总览)\n\n\n(### Design Compiler)'
        match = re.search(pattern, content)
        if match:
            header = match.group(1)
            next_header = match.group(2)
            pages_text = '\n'.join(f'- [[{p}]]' for p in sorted(pages)[:10])
            replacement = f'{header}\n\n{pages_text}\n\n\n{next_header}'
            content = content[:match.start()] + replacement + content[match.end():]

with open(os.path.join(wiki_root, 'index.md'), 'w', encoding='utf-8') as f:
    f.write(content)

print('Index sections filled.')
