import os, re

# Count pages by type for summary
types = {}
no_fm = 0
meta_files = ['_index.md', 'index.md', 'log.md', 'hot.md', 'overview.md', 'dashboard.md']

for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if f.endswith('.md') and f not in meta_files:
            path = os.path.join(root, f)
            try:
                with open(path, encoding='utf-8', errors='ignore') as fh:
                    content = fh.read()
                if content.startswith('---'):
                    fm_end = content.find('---', 3)
                    if fm_end != -1:
                        fm = content[3:fm_end]
                        m = re.search(r'^type:\s*(.+)', fm, re.MULTILINE)
                        if m:
                            t = m.group(1).strip().strip('\"').strip(\"'\")
                            types[t] = types.get(t, 0) + 1
                        else:
                            no_fm += 1
            except:
                pass

print('=== PAGE TYPES ===')
for t, c in sorted(types.items(), key=lambda x: -x[1]):
    print(f'  {t}: {c}')
print(f'  (no type): {no_fm}')
