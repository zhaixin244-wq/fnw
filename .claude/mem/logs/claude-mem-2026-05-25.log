import os, re

wiki_root = 'wiki'

# Collect ALL page names (including meta, folds)
pages = set()
for root, dirs, files in os.walk(wiki_root):
    for f in files:
        if f.endswith('.md'):
            pages.add(f[:-3])

# Find all dead links across ALL files
link_pattern = re.compile(r'\[\[([^\]|]+?)(?:\|[^\]]+)?\]\]')
dead = {}  # target -> [source files]

for root, dirs, files in os.walk(wiki_root):
    for f in files:
        if f.endswith('.md'):
            filepath = os.path.join(root, f)
            rel = os.path.relpath(filepath, wiki_root).replace(os.sep, '/')
            try:
                with open(filepath, 'r', encoding='utf-8', errors='ignore') as fh:
                    content = fh.read()
            except:
                continue
            for match in link_pattern.finditer(content):
                target = match.group(1)
                if '#' in target:
                    target = target.split('#')[0]
                if target and target not in pages:
                    if target not in dead:
                        dead[target] = []
                    dead[target].append(rel)

# Categorize
case_fix = {}
path_fix = {}
truly_missing = {}

for target in dead:
    target_lower = target.lower()
    # Case-insensitive match
    found = None
    for p in pages:
        if p.lower() == target_lower:
            found = p
            break
    if found:
        case_fix[target] = found
        continue
    # Path-style: strip prefix
    if '/' in target:
        basename = target.split('/')[-1]
        if basename in pages:
            path_fix[target] = basename
            continue
    truly_missing[target] = dead[target]

print(f'Total dead link targets: {len(dead)}')
print(f'Case mismatch fixable: {len(case_fix)}')
print(f'Path-style fixable: {len(path_fix)}')
print(f'Truly missing: {len(truly_missing)}')

print(f'\n=== CASE FIXES ({len(case_fix)}) ===')
for wrong, correct in sorted(case_fix.items()):
    print(f'  [[{wrong}]] -> [[{correct}]] ({len(dead[wrong])} refs)')

print(f'\n=== PATH FIXES ({len(path_fix)}) ===')
for wrong, correct in sorted(path_fix.items()):
    print(f'  [[{wrong}]] -> [[{correct}]] ({len(dead[wrong])} refs)')
