import os, re

# Priority 4: Add index sections for DPDK, QEMU, EDA
# First, collect all pages in each domain

wiki_root = 'wiki'
domains = {
    'dpdk': [],
    'qemu': [],
    'eda': [],
}

for root, dirs, files in os.walk(wiki_root):
    for f in files:
        if not f.endswith('.md'):
            continue
        rel = os.path.relpath(os.path.join(root, f), wiki_root).replace(os.sep, '/')
        name = f[:-3]
        
        if rel.startswith('dpdk/') and not rel.startswith('dpdk/guides/'):
            domains['dpdk'].append((name, rel))
        elif rel.startswith('dpdk/guides/'):
            # Skip sub-guides for now, they're too many
            pass
        elif rel.startswith('qemu/') and rel.count('/') == 1:
            domains['qemu'].append((name, rel))
        elif rel.startswith('eda/') and rel.count('/') <= 2:
            domains['eda'].append((name, rel))

# Read index.md
index_path = os.path.join(wiki_root, 'index.md')
with open(index_path, 'r', encoding='utf-8', errors='ignore') as f:
    index_content = f.read()

# Find existing sections to avoid duplicates
new_sections = []

# DPDK section - check if already exists
if '## DPDK' not in index_content and '### DPDK' not in index_content:
    dpdk_pages = sorted(domains['dpdk'], key=lambda x: x[0])
    if dpdk_pages:
        section = '\n## DPDK 数据平面开发套件\n\n'
        section += '> 自动生成的 DPDK API 参考页面\n\n'
        for name, rel in dpdk_pages[:30]:
            section += f'- [[{name}]]\n'
        if len(dpdk_pages) > 30:
            section += f'\n*... 共 {len(dpdk_pages)} 个页面*\n'
        new_sections.append(('DPDK', section))

# QEMU section
if '## QEMU' not in index_content and '### QEMU' not in index_content:
    qemu_pages = sorted(domains['qemu'], key=lambda x: x[0])
    if qemu_pages:
        section = '\n## QEMU 模拟器\n\n'
        section += '> 自动生成的 QEMU 文档页面\n\n'
        for name, rel in qemu_pages[:20]:
            section += f'- [[{name}]]\n'
        if len(qemu_pages) > 20:
            section += f'\n*... 共 {len(qemu_pages)} 个页面*\n'
        new_sections.append(('QEMU', section))

# EDA section - already partially exists, fill in the tools
if '### Design Compiler' in index_content:
    # Check if the subsections are empty
    eda_tools = {
        'Design Compiler': [],
        'PrimeTime': [],
        'SpyGlass': [],
        'VC Formal': [],
        'VC SpyGlass': [],
        'VCS': [],
        'Verdi': [],
    }
    
    for name, rel in sorted(domains['eda']):
        if 'design-compiler' in rel or 'dc-' in name.lower():
            eda_tools['Design Compiler'].append(name)
        elif 'primetime' in rel or 'pt-' in name.lower():
            eda_tools['PrimeTime'].append(name)
        elif 'spyglass' in rel or 'sg-' in name.lower():
            eda_tools['SpyGlass'].append(name)
        elif 'vc-formal' in rel or 'vcf-' in name.lower():
            eda_tools['VC Formal'].append(name)
        elif 'vc-spyglass' in rel or 'vcsg-' in name.lower():
            eda_tools['VC SpyGlass'].append(name)
        elif 'vcs' in rel:
            eda_tools['VCS'].append(name)
        elif 'verdi' in rel:
            eda_tools['Verdi'].append(name)
    
    # Read index and fill in empty EDA subsections
    for tool, pages in eda_tools.items():
        if not pages:
            continue
        # Check if section is empty
        pattern = rf'### {re.escape(tool)}.*?\n\n'
        match = re.search(pattern, index_content, re.DOTALL)
        if match:
            section_text = match.group(0)
            # Check if it's empty (no list items)
            if '- [[' not in section_text:
                # Insert page list
                pages_text = '\n'.join(f'- [[{p}]]' for p in sorted(pages)[:15])
                if len(pages) > 15:
                    pages_text += f'\n- *... 共 {len(pages)} 个页面*'
                new_content = section_text.rstrip('\n') + '\n\n' + pages_text + '\n'
                index_content = index_content.replace(section_text, new_content)

# Insert new sections before the final ---
if new_sections:
    insert_point = index_content.rfind('---\n\n*Report')
    if insert_point < 0:
        insert_point = index_content.rfind('<!-- Add new domain entries')
    if insert_point < 0:
        insert_point = len(index_content)
    
    for domain_name, section_text in new_sections:
        index_content = index_content[:insert_point] + section_text + index_content[insert_point:]
        insert_point += len(section_text)

with open(index_path, 'w', encoding='utf-8') as f:
    f.write(index_content)

print(f'Index updated with {len(new_sections)} new sections')
for name, _ in new_sections:
    print(f'  Added: {name}')

# Report EDA tool counts
for tool, pages in eda_tools.items():
    if pages:
        print(f'  EDA {tool}: {len(pages)} pages linked')
PYEOF)
