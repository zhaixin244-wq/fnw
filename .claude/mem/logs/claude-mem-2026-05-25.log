import os, re

# Batch add 'updated' field to DPDK/QEMU pages missing it
count = 0
for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    # Only process dpdk/ and qemu/ directories
    rel_root = root.replace(os.sep, '/').replace('wiki/', '')
    if not (rel_root.startswith('dpdk') or rel_root.startswith('qemu')):
        continue
    
    for f in files:
        if not f.endswith('.md'):
            continue
        path = os.path.join(root, f)
        try:
            with open(path, encoding='utf-8', errors='ignore') as fh:
                content = fh.read()
            
            if not content.startswith('---'):
                continue
            
            fm_end = content.find('---', 3)
            if fm_end == -1:
                continue
            
            fm = content[3:fm_end]
            if 'updated:' in fm:
                continue
            
            # Add updated field after created: or type:
            if 'created:' in fm:
                content = content.replace('created: 2026-05-22', 'created: 2026-05-22\nupdated: 2026-05-25', 1)
            elif 'type:' in fm:
                content = re.sub(r'(type:.*\n)', r'\1updated: 2026-05-25\n', content, count=1)
            else:
                # Add after first ---
                content = content.replace('---\n', '---\nupdated: 2026-05-25\n', 1)
            
            with open(path, 'w', encoding='utf-8') as fh:
                fh.write(content)
            count += 1
        except:
            pass

print(f'Added updated field to {count} pages')
