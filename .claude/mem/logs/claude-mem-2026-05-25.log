import re

# Check manifest address_map consistency
import json
with open('.raw/.manifest.json', encoding='utf-8') as f:
    manifest = json.load(f)

amap = manifest.get('address_map', {})
print(f'=== MANIFEST ADDRESS_MAP ({len(amap)} entries) ===')

import os
errors = []
for page_path, expected_addr in amap.items():
    full_path = os.path.join('.', page_path)
    if not os.path.exists(full_path):
        errors.append(f'MISSING: {page_path} mapped to {expected_addr} but file does not exist')
        continue
    try:
        with open(full_path, encoding='utf-8', errors='ignore') as fh:
            content = fh.read()
        if content.startswith('---'):
            fm_end = content.find('---', 3)
            if fm_end != -1:
                fm = content[3:fm_end]
                m = re.search(r'^address:\s*(.+)', fm, re.MULTILINE)
                if m:
                    actual = m.group(1).strip().strip(\"'\").strip('\"')
                    if actual != expected_addr:
                        errors.append(f'MISMATCH: {page_path} map={expected_addr} frontmatter={actual}')
                else:
                    errors.append(f'NO ADDRESS: {page_path} mapped to {expected_addr} but no address in frontmatter')
    except:
        pass

if errors:
    print(f'Errors ({len(errors)}):')
    for e in errors:
        print(f'  - {e}')
else:
    print('All address_map entries consistent.')
" 2>&1)
