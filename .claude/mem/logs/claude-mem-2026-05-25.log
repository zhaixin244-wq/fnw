import os

# Categorize orphan pages
orphans_by_dir = {}
for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if f.endswith('.md'):
            path = os.path.join(root, f)
            d = os.path.dirname(path)
            orphans_by_dir.setdefault(d, []).append(f)

# Show top directories with orphan-like files
for d in sorted(orphans_by_dir.keys()):
    prefix_files = [f for f in orphans_by_dir[d] if f.startswith('.._')]
    if prefix_files:
        print(f'{d}: {len(prefix_files)} prefix files')
        for f in prefix_files[:5]:
            print(f'  {f}')
        if len(prefix_files) > 5:
            print(f'  ... +{len(prefix_files)-5}')
" 2>&1)
