import olefile, re
path = '.raw/sources/jm-chip-str/nic/Santorini-NIC软硬件接口梳理.doc'
ole = olefile.OleFileIO(path)
# Try the main stream
for s in ole.listdir():
    name = '/'.join(s)
    if 'Word' in name or 'Table' in name:
        print(f'Stream: {name} size={ole.get_size(name)}')
ole.close()

# Try extracting with different approach
ole = olefile.OleFileIO(path)
stream = ole.openstream('WordDocument')
data = stream.read()

# The Word binary format stores text in different places
# Let's try to find the text by looking for UTF-16LE encoded Chinese
import codecs
# Try UTF-16LE decoding
try:
    text16 = data.decode('utf-16-le', errors='ignore')
    # Filter printable
    clean = ''.join(c for c in text16 if c.isprintable() or c in '\n\r\t')
    lines = [l.strip() for l in clean.split('\n') if len(l.strip()) > 8]
    # Print first 100 meaningful lines
    count = 0
    for l in lines:
        if count > 100:
            break
        print(l)
        count += 1
except Exception as e:
    print(f'UTF-16 failed: {e}')
ole.close()
" 2>&1 | head -120
