import os, re

wiki_root = 'wiki'
pages = set()
for root, dirs, files in os.walk(wiki_root):
    for f in files:
        if f.endswith('.md'):
            pages.add(f[:-3])

link_pattern = re.compile(r'\[\[([^\]|]+?)(?:\|[^\]]+)?\]\]')
dead = {}  # target -> count

for root, dirs, files in os.walk(wiki_root):
    for f in files:
        if not f.endswith('.md'):
            continue
        filepath = os.path.join(root, f)
        try:
            with open(filepath, 'r', encoding='utf-8', errors='ignore') as fh:
                content = fh.read()
        except:
            continue
        for match in link_pattern.finditer(content):
            target = match.group(1)
            if '#' in target:
                target = target.split('#')[0]
            if target and target not in pages:
                dead[target] = dead.get(target, 0) + 1

# Categorize remaining
index_links = {t: c for t, c in dead.items() if t.endswith('/index')}
index2_links = {t: c for t, c in dead.items() if t.endswith('/_index')}
other = {t: c for t, c in dead.items() if not t.endswith('/index') and not t.endswith('/_index')}

print(f'Remaining dead: {len(dead)} targets, {sum(dead.values())} refs')
print(f'\n- /index links ({len(index_links)}): {sum(index_links.values())} refs')
for t, c in sorted(index_links.items()):
    print(f'  [[{t}]] ({c} refs)')
print(f'\n- /_index links ({len(index2_links)}): {sum(index2_links.values())} refs')
for t, c in sorted(index2_links.items()):
    print(f'  [[{t}]] ({c} refs)')
print(f'\n- Other ({len(other)}): {sum(other.values())} refs')
for t, c in sorted(other.items()):
    print(f'  [[{t}]] ({c} refs)')
