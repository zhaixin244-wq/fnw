import os, re

wiki_root = 'wiki'

# Re-check dead links
pages = set()
for root, dirs, files in os.walk(wiki_root):
    for f in files:
        if f.endswith('.md'):
            pages.add(f[:-3])

link_pattern = re.compile(r'\[\[([^\]|]+?)(?:\|[^\]]+)?\]\]')
dead_count = 0
dead_targets = set()

for root, dirs, files in os.walk(wiki_root):
    for f in files:
        if f.endswith('.md'):
            filepath = os.path.join(root, f)
            try:
                with open(filepath, 'r', encoding='utf-8', errors='ignore') as fh:
                    content = fh.read()
            except:
                continue
            for match in link_pattern.finditer(content):
                target = match.group(1)
                if '#' in target:
                    target = target.split('#')[0]
                if target and target not in pages:
                    dead_targets.add(target)
                    dead_count += 1

print(f'=== POST-FIX: Dead links ===')
print(f'Remaining dead link targets: {len(dead_targets)}')
print(f'Total dead link references: {dead_count}')

# Re-check frontmatter gaps
required = ['type', 'status', 'created', 'tags']
missing_count = 0
for root, dirs, files in os.walk(wiki_root):
    dirs[:] = [d for d in dirs if d not in ('folds', 'meta')]
    for f in files:
        if f.endswith('.md'):
            filepath = os.path.join(root, f)
            try:
                with open(filepath, 'r', encoding='utf-8', errors='ignore') as fh:
                    content = fh.read(500)
            except:
                continue
            if not content.startswith('---'):
                missing_count += 1
                continue
            fm_end = content.find('---', 3)
            if fm_end < 0:
                missing_count += 1
                continue
            fm = content[3:fm_end]
            for field in required:
                if not re.search(rf'^{field}:', fm, re.MULTILINE):
                    missing_count += 1
                    break

print(f'\n=== POST-FIX: Frontmatter ===')
print(f'Pages still missing required fields: {missing_count}')

# Re-check addresses
no_addr = 0
exclude_dirs = {'folds', 'meta'}
for root, dirs, files in os.walk(wiki_root):
    dirs[:] = [d for d in dirs if d not in exclude_dirs]
    for f in files:
        if f.endswith('.md'):
            filepath = os.path.join(root, f)
            try:
                with open(filepath, 'r', encoding='utf-8', errors='ignore') as fh:
                    content = fh.read(500)
            except:
                continue
            if not content.startswith('---'):
                continue
            fm_end = content.find('---', 3)
            if fm_end < 0:
                continue
            fm = content[3:fm_end]
            
            type_match = re.search(r'^type:\s*(.+)', fm, re.MULTILINE)
            if type_match:
                t = type_match.group(1).strip().strip('"').lower()
                if t in ('meta', 'fold'):
                    continue
            
            created_match = re.search(r'^created:\s*(.+)', fm, re.MULTILINE)
            created = created_match.group(1).strip() if created_match else None
            
            if created and created >= '2026-04-23':
                if not re.search(r'^address:', fm, re.MULTILINE):
                    no_addr += 1

print(f'\n=== POST-FIX: Addresses ===')
print(f'Post-rollout pages still missing address: {no_addr}')

# Count total addresses
addr_count = 0
for root, dirs, files in os.walk(wiki_root):
    for f in files:
        if f.endswith('.md'):
            filepath = os.path.join(root, f)
            try:
                with open(filepath, 'r', encoding='utf-8', errors='ignore') as fh:
                    content = fh.read(500)
            except:
                continue
            if re.search(r'^address:\s*c-\d{6}', content, re.MULTILINE):
                addr_count += 1

print(f'Total pages with c- addresses: {addr_count}')
