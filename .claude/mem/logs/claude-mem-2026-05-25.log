import os, re

wiki_root = 'wiki'
exclude_dirs = {'folds', 'meta'}
exclude_files = {'_index.md', 'index.md', 'log.md', 'hot.md', 'overview.md', 'dashboard.md', 'dashboard.base', 'Wiki Map.md', 'getting-started.md'}

empty_sections = []

for root, dirs, files in os.walk(wiki_root):
    dirs[:] = [d for d in dirs if d not in exclude_dirs]
    for f in files:
        if f.endswith('.md') and f not in exclude_files:
            filepath = os.path.join(root, f)
            rel = os.path.relpath(filepath, wiki_root).replace(os.sep, '/')
            try:
                with open(filepath, 'r', encoding='utf-8', errors='ignore') as fh:
                    lines = fh.readlines()
            except:
                continue
            in_frontmatter = False
            for i, line in enumerate(lines):
                stripped = line.strip()
                if stripped == '---':
                    in_frontmatter = not in_frontmatter
                    continue
                if in_frontmatter:
                    continue
                if re.match(r'^#{1,4}\s+', stripped):
                    heading = stripped
                    # Check if next non-empty line is another heading or EOF
                    has_content = False
                    for j in range(i+1, min(i+5, len(lines))):
                        next_stripped = lines[j].strip()
                        if not next_stripped:
                            continue
                        if re.match(r'^#{1,4}\s+', next_stripped):
                            break  # another heading, no content
                        has_content = True
                        break
                    if not has_content:
                        empty_sections.append((rel, heading))

print(f'=== EMPTY SECTIONS ({len(empty_sections)}) ===')
# Group by file
by_file = {}
for path, heading in empty_sections:
    if path not in by_file:
        by_file[path] = []
    by_file[path].append(heading)

for path in sorted(by_file.keys())[:30]:
    headings = by_file[path]
    print(f'  {path}: {len(headings)} empty sections')
    for h in headings[:3]:
        print(f'    - {h}')
    if len(headings) > 3:
        print(f'    ... and {len(headings)-3} more')
if len(by_file) > 30:
    print(f'  ... and {len(by_file)-30} more files')
print(f'  Total: {len(empty_sections)} empty sections across {len(by_file)} files')
" 2>&1)
