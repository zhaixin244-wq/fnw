import asyncio, os, sys
from mcp import ClientSession, StdioServerParameters
from mcp.client.stdio import stdio_client

async def test():
    env = os.environ.copy()
    env['WORKSPACE'] = '/workspace/test'
    env['HOST_WORKSPACE'] = '/c/test'
    env['WORKSPACE_ID'] = 'test'
    env['CONFIG_FILE'] = 'C:/Users/link_/.config/deeppresenter/config.yaml'
    env['PACKAGE_DIR'] = 'D:/work/ai/fnw/arch/tools/PPTAgent/deeppresenter'
    env['PYTHONUTF8'] = '1'
    
    params = StdioServerParameters(
        command=sys.executable,
        args=['D:/work/ai/fnw/arch/tools/PPTAgent/deeppresenter/tools/task.py'],
        env=env
    )
    try:
        async with stdio_client(params) as (read, write):
            async with ClientSession(read, write) as session:
                await asyncio.wait_for(session.initialize(), timeout=10)
                tools = await session.list_tools()
                print('Tools:', [t.name for t in tools.tools])
    except Exception as e:
        print(f'Error: {type(e).__name__}: {e}')

asyncio.run(test())
" 2>&1)
