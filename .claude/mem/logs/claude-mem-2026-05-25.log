import os, re

wiki_root = 'wiki'
exclude_dirs = {'folds', 'meta'}
exclude_files = {'_index.md', 'index.md', 'log.md', 'hot.md', 'overview.md', 'dashboard.md', 'dashboard.base', 'Wiki Map.md', 'getting-started.md'}

required_fields = ['type', 'status', 'created', 'updated', 'tags']
missing = {}

for root, dirs, files in os.walk(wiki_root):
    dirs[:] = [d for d in dirs if d not in exclude_dirs]
    for f in files:
        if f.endswith('.md') and f not in exclude_files:
            filepath = os.path.join(root, f)
            rel = os.path.relpath(filepath, wiki_root).replace(os.sep, '/')
            try:
                with open(filepath, 'r', encoding='utf-8', errors='ignore') as fh:
                    content = fh.read()
            except:
                continue
            # Check for frontmatter
            if not content.startswith('---'):
                missing[rel] = ['NO FRONTMATTER']
                continue
            fm_end = content.find('---', 3)
            if fm_end < 0:
                missing[rel] = ['MALFORMED FRONTMATTER']
                continue
            fm = content[3:fm_end]
            absent = []
            for field in required_fields:
                if not re.search(rf'^{field}:', fm, re.MULTILINE):
                    absent.append(field)
            if absent:
                missing[rel] = absent

print(f'=== FRONTMATTER GAPS ({len(missing)} pages) ===')
# Group by missing field combo
combos = {}
for path, fields in missing.items():
    key = ', '.join(fields)
    if key not in combos:
        combos[key] = []
    combos[key].append(path)

for combo, paths in sorted(combos.items(), key=lambda x: -len(x[1])):
    print(f'  Missing [{combo}]: {len(paths)} pages')
    for p in paths[:5]:
        print(f'    - {p}')
    if len(paths) > 5:
        print(f'    ... and {len(paths)-5} more')
