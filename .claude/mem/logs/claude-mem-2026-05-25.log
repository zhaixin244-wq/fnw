import olefile, struct, re

path = '.raw/sources/jm-chip-str/nic/Santorini-NIC软硬件接口梳理.doc'
ole = olefile.OleFileIO(path)

# Read WordDocument stream
wd = ole.openstream('WordDocument').read()

# Parse FIB (File Information Block)
# Offset 0x0018: ccpText (character count of main text)
# The text is stored starting after the FIB
# Let's try to find text by scanning for Chinese character patterns in the raw data

# Alternative: try to decode the raw bytes as gbk and filter
import codecs
text = wd.decode('gbk', errors='replace')
# Remove null bytes and control chars
text = text.replace('\x00', '')
text = re.sub(r'[\x01-\x08\x0b\x0c\x0e-\x1f]', ' ', text)

# Split into potential lines and filter
lines = text.split('\r')
good = []
for l in lines:
    l = l.strip()
    if len(l) > 10:
        # Count Chinese chars
        cn = len(re.findall(r'[一-鿿]', l))
        alphanum = len(re.findall(r'[a-zA-Z0-9]', l))
        if cn > 3 or alphanum > 8:
            good.append(l)

print(f'Found {len(good)} meaningful lines')
for l in good[:80]:
    print(l)

ole.close()
" 2>&1 | head -100
)
