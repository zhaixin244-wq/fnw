# Check what the 'other' dead links in dpdk/ actually are
pages = set()
for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if f.endswith('.md'):
            pages.add(f[:-3])

dead_other = []
for root, dirs, files in os.walk('wiki/dpdk'):
    for f in files:
        if f.endswith('.md'):
            path = os.path.join(root, f)
            try:
                with open(path, encoding='utf-8', errors='ignore') as fh:
                    content = fh.read()
                links = re.findall(r'\[\[([^\]|#]+?)(?:[|#][^\]]*?)?\]\]', content)
                for l in links:
                    target = l.strip()
                    if not target.startswith('../') and not target.startswith('/') and target not in pages:
                        dead_other.append(target)
            except:
                pass

from collections import Counter
counts = Counter(dead_other)
print(f'Unique dead link targets (other): {len(counts)}')
print(f'Total occurrences: {len(dead_other)}')
print()
for target, cnt in counts.most_common(30):
    print(f'  [{cnt}] {target}')
