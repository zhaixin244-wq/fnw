import os, re

# Build DPDK index content
wiki_root = 'wiki'
dpdk_by_dir = {}

for root, dirs, files in os.walk(os.path.join(wiki_root, 'dpdk')):
    for f in files:
        if not f.endswith('.md'):
            continue
        rel = os.path.relpath(os.path.join(root, f), wiki_root).replace(os.sep, '/')
        parts = rel.split('/')
        subdir = parts[1] if len(parts) > 1 else 'root'
        name = f[:-3]
        if subdir not in dpdk_by_dir:
            dpdk_by_dir[subdir] = []
        dpdk_by_dir[subdir].append(name)

# Build section
lines = []
for subdir in sorted(dpdk_by_dir):
    pages = sorted(dpdk_by_dir[subdir])
    count = len(pages)
    if subdir == 'guides':
        lines.append(f'- **guides/** — {count} 个指南页面')
        # Show a few key ones
        key_guides = [p for p in pages if p in ('intro', 'linux_gsg', 'prog_guide', 'nics', 'cryptodevs', 'compressdevs')]
        for g in key_guides[:5]:
            lines.append(f'  - [[{g}]]')
    elif subdir == 'api':
        lines.append(f'- **api/** — {count} 个 API 参考页面')
        for p in pages[:3]:
            lines.append(f'  - [[{p}]]')
    else:
        for p in pages:
            lines.append(f'- [[{p}]]')

dpdk_content = '\n'.join(lines)

# Now update index.md
index_path = os.path.join(wiki_root, 'index.md')
with open(index_path, 'r', encoding='utf-8') as f:
    content = f.read()

# Replace empty DPDK section
old_dpdk = '### DPDK 数据平面开发套件\n\n\n---'
new_dpdk = f'### DPDK 数据平面开发套件\n\n> 507 个页面，主要来自 DPDK 官方文档批量导入\n\n{dpdk_content}\n\n---'
content = content.replace(old_dpdk, new_dpdk)

with open(index_path, 'w', encoding='utf-8') as f:
    f.write(content)

print('DPDK index section populated.')
