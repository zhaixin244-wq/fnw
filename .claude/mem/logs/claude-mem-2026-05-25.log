import os, re
from collections import Counter

# Build comprehensive page map
pages = set()
page_map = {}
for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if f.endswith('.md'):
            path = os.path.join(root, f)
            # Add basename
            pages.add(f[:-3])
            page_map[f[:-3]] = path
            # Add relative path from wiki/
            rel = path.replace(os.sep, '/').replace('.md', '')
            if rel.startswith('wiki/'):
                rel = rel[5:]
            page_map[rel] = path
            # Also add without wiki/ prefix
            page_map[rel] = path

# Also add _index.md files (they exist but are excluded from main scan)
for root, dirs, files in os.walk('wiki'):
    for f in files:
        if f == '_index.md':
            path = os.path.join(root, f)
            rel = path.replace(os.sep, '/').replace('.md', '')
            if rel.startswith('wiki/'):
                rel = rel[5:]
            page_map[rel] = path

# Add meta pages to page_map
for root, dirs, files in os.walk('wiki/meta'):
    for f in files:
        if f.endswith('.md'):
            path = os.path.join(root, f)
            rel = path.replace(os.sep, '/').replace('.md', '')
            if rel.startswith('wiki/'):
                rel = rel[5:]
            page_map[rel] = path
            page_map[f[:-3]] = path

# Now count dead links with proper resolution
dead_targets = Counter()
resolved = 0
for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if f.endswith('.md'):
            path = os.path.join(root, f)
            try:
                with open(path, encoding='utf-8', errors='ignore') as fh:
                    content = fh.read()
                links = re.findall(r'\[\[([^\]|#]+?)(?:[|#][^\]]*?)?\]\]', content)
                for l in links:
                    target = l.strip()
                    target_lower = target.lower()
                    if target in pages or target in page_map:
                        resolved += 1
                    elif any(p.lower() == target_lower for p in pages):
                        resolved += 1
                    else:
                        dead_targets[target] += 1
            except:
                pass

total_dead = sum(dead_targets.values())
print(f'Resolved: {resolved}')
print(f'Remaining dead links: {total_dead}')
for t, cnt in dead_targets.most_common(20):
    print(f'  [{cnt}] {t}')
