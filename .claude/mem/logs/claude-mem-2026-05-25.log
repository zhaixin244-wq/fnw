import olefile, sys
path = '.raw/sources/jm-chip-str/nic/Santorini-NIC软硬件接口梳理.doc'
try:
    ole = olefile.OleFileIO(path)
    stream = ole.openstream('WordDocument')
    data = stream.read()
    # Try to extract readable text
    import re
    # Extract text between null bytes
    text = data.decode('gbk', errors='ignore')
    # Filter out control characters but keep Chinese
    clean = re.sub(r'[\x00-\x08\x0b\x0c\x0e-\x1f]', '', text)
    # Remove lines that are mostly garbage
    lines = clean.split('\n')
    good_lines = []
    for l in lines:
        l = l.strip()
        if len(l) > 5:
            # Check if line has reasonable Chinese/ASCII content
            chinese = len(re.findall(r'[一-鿿]', l))
            ascii_chars = len(re.findall(r'[a-zA-Z0-9]', l))
            if chinese > 2 or ascii_chars > 5:
                good_lines.append(l)
    print('\n'.join(good_lines[:200]))
    ole.close()
except Exception as e:
    print(f'Error: {e}')
"
)
