import os, re

wiki_root = 'wiki'
exclude_dirs = {'folds', 'meta'}
rollout_date = '2026-04-23'

# Read current counter
with open('.vault-meta/address-counter.txt', 'r') as f:
    counter = int(f.read().strip())

print(f'Starting counter: {counter}')
assigned = 0

for root, dirs, files in os.walk(wiki_root):
    dirs[:] = [d for d in dirs if d not in exclude_dirs]
    for f in sorted(files):
        if not f.endswith('.md'):
            continue
        filepath = os.path.join(root, f)
        try:
            with open(filepath, 'r', encoding='utf-8', errors='ignore') as fh:
                content = fh.read()
        except:
            continue
        
        if not content.startswith('---'):
            continue
        fm_end = content.find('---', 3)
        if fm_end < 0:
            continue
        fm = content[3:fm_end]
        
        # Skip meta/fold types
        type_match = re.search(r'^type:\s*(.+)', fm, re.MULTILINE)
        if type_match:
            t = type_match.group(1).strip().strip('"').lower()
            if t in ('meta', 'fold'):
                continue
        
        # Check created date
        created_match = re.search(r'^created:\s*(.+)', fm, re.MULTILINE)
        created = created_match.group(1).strip() if created_match else None
        
        # Check if already has address
        if re.search(r'^address:', fm, re.MULTILINE):
            continue
        
        # Must be post-rollout
        if not created or created < rollout_date:
            continue
        
        # Assign address
        counter += 1
        addr = f'c-{counter:06d}'
        
        # Insert address after first --- line (after frontmatter start)
        lines = content.split('\n')
        # Find where to insert - after the first line (which is ---)
        insert_idx = 1
        new_lines = lines[:insert_idx] + [f'address: {addr}'] + lines[insert_idx:]
        new_content = '\n'.join(new_lines)
        
        with open(filepath, 'w', encoding='utf-8') as fh:
            fh.write(new_content)
        assigned += 1

# Update counter
with open('.vault-meta/address-counter.txt', 'w') as f:
    f.write(str(counter))

print(f'Assigned {assigned} addresses. Counter now at: {counter}')
PYEOF)
