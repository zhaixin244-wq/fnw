import os, re

# Check frontmatter gaps - pages missing required fields
required = ['type', 'tags', 'created', 'updated']
missing = []
meta_files = ['_index.md', 'index.md', 'log.md', 'hot.md', 'overview.md', 'dashboard.md']

for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if f.endswith('.md') and f not in meta_files:
            path = os.path.join(root, f)
            try:
                with open(path, encoding='utf-8', errors='ignore') as fh:
                    content = fh.read()
                # Check if it has frontmatter
                if not content.startswith('---'):
                    missing.append((path, ['no frontmatter']))
                    continue
                fm_end = content.find('---', 3)
                if fm_end == -1:
                    missing.append((path, ['broken frontmatter']))
                    continue
                fm = content[3:fm_end]
                absent = []
                for field in required:
                    if not re.search(rf'^{field}:', fm, re.MULTILINE):
                        absent.append(field)
                if absent:
                    missing.append((path, absent))
            except:
                pass

print(f'=== FRONTMATTER GAPS ({len(missing)} pages) ===')
for path, fields in sorted(missing)[:40]:
    print(f'  - {path}: missing {fields}')
if len(missing) > 40:
    print(f'  ... and {len(missing)-40} more')
" 2>&1)
