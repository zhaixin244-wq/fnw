import os, re

# Get all wiki page names (basename without .md)
pages = set()
page_paths = {}
for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if f.endswith('.md'):
            name = f[:-3]
            pages.add(name)
            path = os.path.join(root, f)
            page_paths[name] = path

# Get all wikilinks
link_targets = set()
for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if f.endswith('.md'):
            path = os.path.join(root, f)
            try:
                with open(path, encoding='utf-8', errors='ignore') as fh:
                    content = fh.read()
                    links = re.findall(r'\[\[([^\]|#]+?)(?:[|#][^\]]*?)?\]\]', content)
                    for l in links:
                        link_targets.add(l.strip())
            except:
                pass

# Orphans: pages that exist but nothing links to them
orphans = sorted(pages - link_targets)
print(f'=== ORPHAN PAGES ({len(orphans)}) ===')
for o in orphans[:50]:
    print(f'  - {o}: {page_paths.get(o, \"?\")}')
if len(orphans) > 50:
    print(f'  ... and {len(orphans)-50} more')
print()

# Dead links: links that point to non-existent pages
dead = sorted(link_targets - pages)
print(f'=== DEAD LINKS ({len(dead)}) ===')
for d in dead[:50]:
    print(f'  - [[{d}]]')
if len(dead) > 50:
    print(f'  ... and {len(dead)-50} more')
" 2>&1 | head -120)
