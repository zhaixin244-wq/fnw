import os, re

# Address validation - only pages with address: in frontmatter
addresses = {}
errors = []

for root, dirs, files in os.walk('wiki'):
    if 'folds' in root or 'meta' in root:
        continue
    for f in files:
        if f.endswith('.md'):
            path = os.path.join(root, f)
            try:
                with open(path, encoding='utf-8', errors='ignore') as fh:
                    content = fh.read()
                if not content.startswith('---'):
                    continue
                fm_end = content.find('---', 3)
                if fm_end == -1:
                    continue
                fm = content[3:fm_end]
                m = re.search(r'^address:\s*(.+)', fm, re.MULTILINE)
                if m:
                    addr = m.group(1).strip().strip(\"'\").strip('\"')
                    # Check format
                    if re.match(r'^c-\d{6}$', addr) or re.match(r'^l-\d{6}$', addr):
                        if addr in addresses:
                            errors.append(f'COLLISION: {path} and {addresses[addr]} share address {addr}')
                        else:
                            addresses[addr] = path
                    else:
                        errors.append(f'BAD FORMAT: {path} has address \"{addr}\" (expected c-NNNNNN or l-NNNNNN)')
            except:
                pass

print(f'=== ADDRESS VALIDATION ===')
print(f'Pages with addresses: {len(addresses)}')
print(f'Counter peek: 16')
print(f'Highest c- address: c-000015')
print()

# Check counter consistency
max_c = 0
for addr in addresses:
    if addr.startswith('c-'):
        num = int(addr[2:])
        max_c = max(max_c, num)
print(f'Max c- observed: c-{max_c:06d}')
print(f'Counter: 16 -> should cover up to c-000015: {\"OK\" if max_c < 16 else \"DRIFT!\"}')
print()

if errors:
    print(f'ERRORS ({len(errors)}):')
    for e in errors:
        print(f'  - {e}')
else:
    print('No errors found.')
" 2>&1)
