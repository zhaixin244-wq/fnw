import os, re, glob

wiki_root = 'wiki'

existing_basenames = {}
for f in glob.glob(os.path.join(wiki_root, '**', '*.md'), recursive=True):
    basename = os.path.splitext(os.path.basename(f))[0]
    rel = f.replace(os.sep, '/').replace('.md', '')
    if rel.startswith('wiki/'):
        rel = rel[5:]
    if basename not in existing_basenames:
        existing_basenames[basename] = []
    existing_basenames[basename].append(rel)

existing_full = set()
for f in glob.glob(os.path.join(wiki_root, '**', '*.md'), recursive=True):
    rel = f.replace(os.sep, '/').replace('.md', '')
    if rel.startswith('wiki/'):
        rel = rel[5:]
    existing_full.add(rel)

all_links = set()
for f in glob.glob(os.path.join(wiki_root, '**', '*.md'), recursive=True):
    with open(f, 'r', encoding='utf-8', errors='replace') as fh:
        content = fh.read()
    for m in re.finditer(r'\[\[([^\]|]+)', content):
        all_links.add(m.group(1).strip())

missing = []
for link in sorted(all_links):
    if link in existing_full or link in existing_basenames:
        continue
    if any(c in link for c in ['&&', '$', '"', "'", '(', ')', '{', '}', '<..', '?']):
        continue
    if re.match(r'^\d{4}-\d{2}-\d{2}', link) or re.match(r'^\d+\.$', link) or not link.strip():
        continue
    missing.append(link)

print(f'Truly missing pages: {len(missing)}')

def sanitize(name):
    return re.sub(r'[<>:"/\\|?*]', '_', name)

created = 0
for name in missing:
    category = 'concepts'
    ptype = 'concept'
    
    safe_name = sanitize(name)
    filepath = os.path.join(wiki_root, category, f'{safe_name}.md')
    if os.path.exists(filepath):
        continue
    
    os.makedirs(os.path.dirname(filepath), exist_ok=True)
    
    content = f'''---
type: {ptype}
title: "{name}"
status: seed
created: 2026-05-22
tags: [stub]
---

# {name}

> [!gap] Stub page
> This page was auto-created during wiki lint to resolve a dead link. Content needs to be developed.

## Overview

TODO: Add content for {name}.
'''
    
    with open(filepath, 'w', encoding='utf-8') as f:
        f.write(content)
    created += 1

print(f'Created {created} stub pages')
