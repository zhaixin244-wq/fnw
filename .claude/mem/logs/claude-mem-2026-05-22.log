import os
import re

WIKI_ROOT = "D:/work/ai/fnw/arch/tools/claude-obsidian/wiki"
DRY_RUN = False

stats = {"scanned": 0, "fixed_cleaned": 0, "fixed_seeded": 0, "skipped": 0}

def is_empty_section(content_lines, start_idx):
    """Check if a heading at start_idx has no content before the next heading or EOF."""
    heading_level = len(re.match(r'^(#+)', content_lines[start_idx]).group(1))
    for i in range(start_idx + 1, len(content_lines)):
        line = content_lines[i].strip()
        if not line:
            continue
        if re.match(r'^#+\s', line):
            next_level = len(re.match(r'^(#+)', line).group(1))
            if next_level <= heading_level:
                return True
            # Sub-heading counts as content for parent
            return False
        return False
    return True  # heading at end of file with nothing after

def remove_empty_sections(lines):
    """Remove empty headings and return cleaned lines + count removed."""
    result = []
    removed = 0
    i = 0
    while i < len(lines):
        if re.match(r'^#+\s', lines[i]) and is_empty_section(lines, i):
            removed += 1
            i += 1
            continue
        result.append(lines[i])
        i += 1
    return result, removed

def add_seed_status(content):
    """Add status: seed to frontmatter if missing status."""
    if 'status:' in content:
        content = re.sub(r'status:\s*\S+', 'status: seed', content, count=1)
    else:
        # Add after first --- block start
        content = content.replace('---\n', '---\nstatus: seed\n', 1)
    return content

for root, dirs, files in os.walk(WIKI_ROOT):
    # Skip meta, folds, _templates
    rel = os.path.relpath(root, WIKI_ROOT)
    if any(rel.startswith(p) for p in ['meta', 'folds', '_templates']):
        continue
    
    for fname in files:
        if not fname.endswith('.md'):
            continue
        fpath = os.path.join(root, fname)
        rel_path = os.path.relpath(fpath, WIKI_ROOT)
        
        # Skip index/meta files
        if fname in ('index.md', 'log.md', 'hot.md', 'overview.md', 'dashboard.md', '_index.md'):
            continue
        
        stats["scanned"] += 1
        
        with open(fpath, 'r', encoding='utf-8') as f:
            content = f.read()
        
        lines = content.split('\n')
        
        # Find empty sections
        empty_count = 0
        i = 0
        in_frontmatter = False
        while i < len(lines):
            if i == 0 and lines[i].strip() == '---':
                in_frontmatter = True
                i += 1
                continue
            if in_frontmatter:
                if lines[i].strip() == '---':
                    in_frontmatter = False
                i += 1
                continue
            if re.match(r'^#+\s', lines[i]) and is_empty_section(lines, i):
                empty_count += 1
            i += 1
        
        if empty_count == 0:
            stats["skipped"] += 1
            continue
        
        # Determine strategy: reference pages → clean empty sections; concept pages → seed
        is_reference = '/dpdk/' in rel_path or '/qemu/' in rel_path
        
        if is_reference:
            # Remove empty sections from reference pages
            new_lines, removed = remove_empty_sections(lines)
            new_content = '\n'.join(new_lines)
            if not DRY_RUN:
                with open(fpath, 'w', encoding='utf-8') as f:
                    f.write(new_content)
            stats["fixed_cleaned"] += 1
        else:
            # For concept/other pages: mark as seed if not already
            if 'status: seed' not in content and 'status: developing' not in content:
                new_content = add_seed_status(content)
                if not DRY_RUN:
                    with open(fpath, 'w', encoding='utf-8') as f:
                        f.write(new_content)
            stats["fixed_seeded"] += 1

print(f"Scanned: {stats['scanned']}")
print(f"Cleaned empty sections (reference pages): {stats['fixed_cleaned']}")
print(f"Marked as seed: {stats['fixed_seeded']}")
print(f"No empty sections: {stats['skipped']}")
