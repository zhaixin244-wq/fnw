                        has_body = nl > heading_level
                        break
                    has_body = True
                    break
                if not has_body:
                    file_empties += 1
        
        if file_empties > 0:
            top_dir = rel_path.split(os.sep)[0]
            by_dir[top_dir] = by_dir.get(top_dir, 0) + file_empties

for d, c in sorted(by_dir.items(), key=lambda x: -x[1]):
    print(f'{d}: {c}')
