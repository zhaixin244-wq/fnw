import os, re, glob

wiki_root = 'wiki'

# Build index of all pages by basename and full path
existing_basenames = {}
existing_full = set()
for f in glob.glob(os.path.join(wiki_root, '**', '*.md'), recursive=True):
    basename = os.path.splitext(os.path.basename(f))[0]
    rel = f.replace(os.sep, '/').replace('.md', '')
    if rel.startswith('wiki/'):
        rel = rel[5:]
    existing_full.add(rel)
    if basename not in existing_basenames:
        existing_basenames[basename] = []
    existing_basenames[basename].append(rel)

# Read index.md
with open('wiki/index.md', 'r', encoding='utf-8') as f:
    index_content = f.read()

# Find all links in index
stale = []
for m in re.finditer(r'\[\[([^\]|]+)', index_content):
    link = m.group(1).strip()
    if link in existing_full:
        continue
    if link in existing_basenames:
        continue
    stale.append(link)

print(f'Stale index entries: {len(stale)}')
for s in stale:
    print(f'  {s}')
" 2>&1)
