        line = lines[i].strip()
        if not line:
            continue
        if re.match(r'^#+\s', line):
            next_level = len(re.match(r'^(#+)', line).group(1))
            if next_level <= heading_level:
                return False  # empty - next same/higher heading
            else:
                # Has sub-heading, check if sub-heading has content
                return has_content_after(lines, i)
