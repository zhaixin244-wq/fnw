        continue
    for fname in files:
        if not fname.endswith('.md'):
            continue
        fpath = os.path.join(root, fname)
        rel_path = os.path.relpath(fpath, WIKI_ROOT)
        if fname in ('index.md', 'log.md', 'hot.md', 'overview.md', 'dashboard.md', '_index.md'):
            continue
        
        with open(fpath, 'r', encoding='utf-8') as f:
            lines = f.read().split('\n')
        
        in_fm = False
        in_code = False
        file_empties = 0
        for i, line in enumerate(lines):
            stripped = line.strip()
            if i == 0 and stripped == '---':
                in_fm = True
                continue
            if in_fm:
                if stripped == '---':
                    in_fm = False
                continue
            if stripped.startswith('\`\`\`'):
                in_code = not in_code
                continue
            if in_code:
                continue
            if re.match(r'^#{1,6}\s', stripped):
                heading_level = len(re.match(r'^(#+)', stripped).group(1))
                has_body = False
                for j in range(i + 1, len(lines)):
                    ns = lines[j].strip()
                    if not ns:
