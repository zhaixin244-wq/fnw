    'wiki/qemu/interop/vhost-vdpa.md',
    'wiki/qemu/interop/vnc-ledstate-pseudo-encoding.md',
]

for f in files:
    with open(f, 'r', encoding='utf-8', errors='replace') as fh:
        content = fh.read()
    
    # Extract title from first heading
    title = ''
    for line in content.split('\n'):
        if line.startswith('# '):
            title = line[2:].strip()
            break
    
