import os, re, glob

wiki_root = 'wiki'
fixed = 0

for md_file in glob.glob(os.path.join(wiki_root, '**', '*.md'), recursive=True):
    with open(md_file, 'r', encoding='utf-8', errors='replace') as f:
        content = f.read()
    
    # Remove garbage wikilinks (code fragments, numbered items, session logs)
    def clean_garbage(m):
        global fixed
        inner = m.group(1).strip()
        # Skip valid-looking links
        if not inner or len(inner) > 200:
            fixed += 1
            return ''
        # Code fragments
        if any(c in inner for c in ['&&', '$', '"', "'", '{', '}', '<..']):
            fixed += 1
            return inner  # Return just the text without wikilink brackets
        # Session logs
        if re.match(r'^\d{4}-\d{2}-\d{2}', inner):
            fixed += 1
            return inner
        # Numbered items
        if re.match(r'^\d+\.$', inner):
            fixed += 1
            return inner
        return m.group(0)
    
    new_content = re.sub(r'\[\[([^\]]+)\]\]', clean_garbage, content)
    
    if new_content != content:
        with open(md_file, 'w', encoding='utf-8') as f:
            f.write(new_content)

print(f'Cleaned {fixed} garbage links')
