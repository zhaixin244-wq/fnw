import os, re, glob

wiki_root = 'wiki'
fixed = 0

for md_file in glob.glob(os.path.join(wiki_root, '**', '*.md'), recursive=True):
    with open(md_file, 'r', encoding='utf-8', errors='replace') as f:
        content = f.read()
    
    # Fix RST inline links: [[text <target>]] -> [[target|text]]
    def fix_rst_link(m):
        global fixed
        inner = m.group(1)
        # Match 'text <target>' pattern
        match = re.match(r'^(.+?)\s*<([^>]+)>$', inner)
        if match:
            text = match.group(1).strip()
            target = match.group(2).strip()
            fixed += 1
            return f'[[{target}|{text}]]'
        return m.group(0)
    
    new_content = re.sub(r'\[\[([^\]]+)\]\]', fix_rst_link, content)
    
    if new_content != content:
        with open(md_file, 'w', encoding='utf-8') as f:
            f.write(new_content)

print(f'Fixed {fixed} RST inline links')
