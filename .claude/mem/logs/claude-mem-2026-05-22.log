import os, re, glob

wiki_root = 'wiki'

# Build index
existing = set()
for f in glob.glob(os.path.join(wiki_root, '**', '*.md'), recursive=True):
    rel = f.replace(os.sep, '/').replace('.md', '')
    if rel.startswith('wiki/'):
        rel = rel[5:]
    existing.add(rel)

# Find and fix DPDK dead links
fixed = 0
for md_file in glob.glob(os.path.join(wiki_root, 'dpdk', '**', '*.md'), recursive=True):
    with open(md_file, 'r', encoding='utf-8', errors='replace') as f:
        content = f.read()
    
    file_dir = os.path.dirname(md_file)
    
    def fix_link(m):
        global fixed
        link = m.group(1)
        display = m.group(2) if m.group(2) else link
        
        # Skip if already valid
        if link in existing:
            return m.group(0)
        
        # Try to find the target
        # For DPDK guides links, try adding dpdk/guides/ prefix
        candidates = [
            f'dpdk/guides/{link}',
            f'dpdk/{link}',
            f'dpdk/api/{link}',
        ]
        
        for candidate in candidates:
            if candidate in existing:
                fixed += 1
                if display != link:
                    return f'[[{candidate}|{display}]]'
