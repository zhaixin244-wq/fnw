import os, re, glob

wiki_root = 'wiki'

# Build index of all pages and their basenames
pages = []
for f in glob.glob(os.path.join(wiki_root, '**', '*.md'), recursive=True):
    rel = f.replace(os.sep, '/').replace('.md', '')
    if rel.startswith('wiki/'):
        rel = rel[5:]
    pages.append(rel)

# Collect all link targets
linked = set()
for f in glob.glob(os.path.join(wiki_root, '**', '*.md'), recursive=True):
    with open(f, 'r', encoding='utf-8', errors='replace') as fh:
        content = fh.read()
    for m in re.finditer(r'\[\[([^\]|]+)', content):
        linked.add(m.group(1).strip())

# Find orphans
orphans = []
for page in pages:
    basename = page.split('/')[-1]
    # Skip meta files
    if basename in ['_index', 'index', 'log', 'hot', 'overview', 'dashboard', 'lint-report-2026-05-22']:
        continue
    # Check if any link points to this page
    if page not in linked and basename not in linked:
        orphans.append(page)

print(f'Total orphans: {len(orphans)}')
for o in sorted(orphans)[:30]:
    print(f'  {o}')
