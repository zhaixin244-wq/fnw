    # Also try execute_command to check
    result2 = await env.client.tool_execute('sandbox', 'execute_command', {
        'command': 'cat /root/.cache/deeppresenter/test-workspace/test.md'
    })
    print('execute_command result:', result2)
    
    await env.client.cleanup()

asyncio.run(test())
\" 2>&1 | tail -20")
