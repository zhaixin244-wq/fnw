import os, re

# Map tool dirs
tool_map = {
    'dc/2603': 'design-compiler',
    'PrimeSuite/2603': 'primetime',
    'SpyGlass/2603': 'spyglass',
    'vc-formal/2603': 'vc-formal',
    'vc-spyglass/2603': 'vc-spyglass',
    'vcs/2603': 'vcs',
    'verdi/2603': 'verdi',
}

# Get all wiki content per tool
wiki_dir = 'wiki/eda/synopsys'
tool_wiki = {}
for tool in tool_map.values():
    tool_path = os.path.join(wiki_dir, tool)
    text = ''
    if os.path.isdir(tool_path):
        for f in os.listdir(tool_path):
            if f.endswith('.md'):
                with open(os.path.join(tool_path, f), 'r', encoding='utf-8') as fh:
                    text += fh.read() + '\n'
    tool_wiki[tool] = text.lower()

# Get extracted text per tool
extracted_dir = '.raw/extracted/eda/synopsys'
tool_extracted = {}
for src_dir, tool in tool_map.items():
    ext_path = os.path.join(extracted_dir, tool)
    files = []
    if os.path.isdir(ext_path):
        for f in os.listdir(ext_path):
            if f.endswith('.txt'):
                files.append(f)
    tool_extracted[tool] = files

# For each extracted file, check if wiki has key terms from it
def get_key_terms(filepath, max_lines=50):
    terms = set()
    try:
        with open(filepath, 'r', encoding='utf-8') as f:
            for i, line in enumerate(f):
                if i > max_lines:
                    break
                # Extract capitalized words (likely commands/variables)
                for word in re.findall(r'[A-Z][a-zA-Z_]{3,}', line):
                    terms.add(word.lower())
                # Extract command-like strings
                for word in re.findall(r'[a-z_]{5,}', line):
                    terms.add(word)
    except:
        pass
    return terms

results = {}
for src_dir, tool in tool_map.items():
    ext_path = os.path.join(extracted_dir, tool)
    wiki_text = tool_wiki.get(tool, '')
    covered = 0
    partial = 0
    missing = 0
    missing_files = []
    
    for txt_file in tool_extracted.get(tool, []):
        filepath = os.path.join(ext_path, txt_file)
        terms = get_key_terms(filepath)
        if not terms:
            continue
        # Count how many key terms appear in wiki
        hits = sum(1 for t in terms if t in wiki_text)
        ratio = hits / len(terms) if terms else 0
        
        if ratio > 0.3:
            covered += 1
        elif ratio > 0.1:
            partial += 1
        else:
            missing += 1
            missing_files.append(txt_file)
    
    results[tool] = {
        'covered': covered,
        'partial': partial,
        'missing': missing,
        'missing_files': missing_files
    }

total_c = sum(r['covered'] for r in results.values())
total_p = sum(r['partial'] for r in results.values())
total_m = sum(r['missing'] for r in results.values())
total = total_c + total_p + total_m

print(f'Content-based coverage analysis:')
print(f'  Well covered (>30% terms): {total_c}/{total} ({total_c*100//total}%)')
print(f'  Partially covered (10-30%): {total_p}/{total} ({total_p*100//total}%)')
print(f'  Low coverage (<10%): {total_m}/{total} ({total_m*100//total}%)')
print()

for tool, r in results.items():
    if r['missing'] > 0:
        print(f'{tool}: {r[\"covered\"]} covered, {r[\"partial\"]} partial, {r[\"missing\"]} low')
        for f in r['missing_files'][:5]:
            print(f'  - {f}')
        if len(r['missing_files']) > 5:
            print(f'  ... and {len(r[\"missing_files\"])-5} more')
" 2>&1)
