    'vcs-debug.md': 'vcs_cmd_ref.pdf, vcs_ucli_ug.pdf',
    'vcs-tcl.md': 'vcs_ucli_ug.pdf, vcs_cmd_ref.pdf',
    'vcs-cmd-ref.md': 'vcs_cmd_ref.pdf',
    'vcs-coverage.md': 'cov_ref.pdf, cov_ug_vcsmx.pdf, vcs_rt_using_cov_with_vcs.pdf',
    'vcs-coverage-detail.md': 'cov_ref.pdf, vcs_rt_magng_cov_data_n_tests.pdf, vcs_rt_merging_cov_from_one_env_to_another.pdf, vcs_rt_recmmnded_cov_set_for_a_new_proj.pdf',
    'vcs-sva.md': 'vcs_sva_qref.pdf, sva_checkerlib.pdf',
    'vcs-sva-detail.md': 'vcs_sva_qref.pdf, vcs_sva_qref_cov_lev.pdf, vcs_sva_checklib_cg_rm.pdf, Controlling_SystemVerilog_Assertions_and_Reporting_Disabled_Assertions.pdf',
    'vcs-uvm.md': 'uvm_users_guide_1.1.pdf, vcs_uvmgen_userguide.pdf',
    'vcs-uvm-detail.md': 'UVM_Class_Reference_Manual_1.2.pdf, uvm_users_guide_1.1.pdf, vcs_uvm_ralgen_ug.pdf',
    'vcs-vmm.md': 'vmm_user_guide.pdf, vcs_vmm_ral_ug.pdf, vcs_vmm_sb_ug.pdf',
    'vcs-performance.md': 'improving_performance.pdf, identifying_simulation_performance_bottleneck.pdf, perf_user_guide.pdf',
    'vcs-install.md': 'vcs_install_guide.pdf, vcs_lca_guide.pdf',
    'vcs-upf.md': 'supported_unified_power_format_commands.pdf, power_aware_gate_level_netlist_simulation_flow.pdf',
    'vcs-low-power-detail.md': 'low_power_techniques.pdf, low_power_messaging.pdf, low_power_debug_using_verdi.pdf',
    'vcs-ams.md': 'vcs_primesim_ams_user_guide.pdf, vcs_vmm_ams_ug.pdf',
    'vcs-systemc.md': 'vcs_systemc_ug.pdf, systemC_transferring_payload_extensions.pdf',
    'vcs-sv.md': 'supported_rtl_constructs.pdf, rtl_coding_guidelines.pdf',
    'vcs-unr.md': 'vcs_unr_ug.pdf',
    'vcs-errors.md': 'vcs_err_msg.pdf, controlling_vcs_error_messages.pdf, simon_message_reference_guide.pdf',
    'vcs-vsoai.md': 'vso_ai_user_guide.pdf, vso_ai_lca_guide.pdf',
}

wiki_dir = 'wiki/eda/synopsys/vcs'
updated = 0
for fname, sources in source_map.items():
    fpath = os.path.join(wiki_dir, fname)
    if not os.path.isfile(fpath):
        continue
    with open(fpath, 'r', encoding='utf-8') as f:
        content = f.read()
    if 'source:' in content:
        continue
    # Add source after tags line
    if 'tags:' in content:
        content = content.replace('tags:', f'source: {sources}\ntags:', 1)
        with open(fpath, 'w', encoding='utf-8') as f:
            f.write(content)
        updated += 1
        print(f'Updated: {fname}')
    else:
        print(f'Skipped (no tags): {fname}')

print(f'\nTotal updated: {updated}')
" 2>&1)
