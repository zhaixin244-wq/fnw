import os

# Count wiki pages per tool
wiki_base = 'wiki/eda/synopsys'
tools_wiki = {}
for item in os.listdir(wiki_base):
    path = os.path.join(wiki_base, item)
    if os.path.isdir(path) and item != '__pycache__':
        mds = [f for f in os.listdir(path) if f.endswith('.md')]
        tools_wiki[item] = sorted(mds)

# Count source PDFs per tool
src_base = '.raw/sources/eda/synopsys'
tools_map = {'dc': 'design-compiler', 'PrimeSuite': 'primetime', 'spyglass': 'spyglass', 'vc_formal': 'vc-formal', 'vc_spyglass': 'vc-spyglass', 'vcs': 'vcs', 'verdi': 'verdi'}
tools_src = {}
for src_dir, tool_name in tools_map.items():
    src_path = os.path.join(src_base, src_dir)
    if os.path.isdir(src_path):
        pdfs = []
        for root, dirs, files in os.walk(src_path):
            for f in sorted(files):
                if f.lower().endswith('.pdf'):
                    pdfs.append(f)
        tools_src[tool_name] = pdfs

print('=== Wiki Pages ===')
for t in sorted(tools_wiki.keys()):
