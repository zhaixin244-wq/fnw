import os, re

wiki_dir = 'wiki/eda/synopsys'
source_dir = '.raw/sources/eda/synopsys'

# Collect all PDF names mentioned in wiki (case-insensitive)
wiki_pdfs = set()
for root, dirs, files in os.walk(wiki_dir):
    for f in files:
        if f.endswith('.md'):
            with open(os.path.join(root, f), 'r', encoding='utf-8') as fh:
                content = fh.read()
                for pdf_name in re.findall(r'[\w\-\(\)\. ]+\.pdf', content, re.IGNORECASE):
                    wiki_pdfs.add(pdf_name.lower().strip())

# Get all source PDFs
source_pdfs = {}
for root, dirs, files in os.walk(source_dir):
    for f in files:
        if f.lower().endswith('.pdf'):
            source_pdfs[f.lower()] = f

# Check coverage
covered = set()
missing = []
for pdf_lower, pdf_actual in source_pdfs.items():
    if pdf_lower in wiki_pdfs:
        covered.add(pdf_lower)
    else:
        # Try without (1) suffix
        clean = re.sub(r'\s*\(\d+\)\.pdf$', '.pdf', pdf_lower)
        if clean in wiki_pdfs:
            covered.add(pdf_lower)
        else:
            missing.append(pdf_actual)

print(f'Total source PDFs: {len(source_pdfs)}')
print(f'Referenced in wiki: {len(covered)}')
print(f'Not referenced: {len(missing)}')
print(f'Coverage: {len(covered)*100//len(source_pdfs)}%')
if missing:
    print()
    print('Still missing:')
    for m in sorted(missing):
        print(f'  - {m}')
