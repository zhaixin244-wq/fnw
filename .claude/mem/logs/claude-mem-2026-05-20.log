import os

WIKI = "D:/work/ai/fnw/arch/tools/claude-obsidian/wiki/eda/synopsys"
EXTRACTED = "D:/work/ai/fnw/arch/tools/claude-obsidian/.raw/extracted/eda/synopsys"

TOOLS = {
    "design-compiler": "design-compiler",
    "primetime": "primetime",
    "spyglass": "spyglass",
    "vc-formal": "vc-formal",
    "vc-spyglass": "vc-spyglass",
    "vcs": "vcs",
    "verdi": "verdi",
}

# For each tool, extract key terms from source PDFs and check if wiki covers them
for wiki_tool, extracted_tool in TOOLS.items():
    wiki_dir = os.path.join(WIKI, wiki_tool)
    ext_dir = os.path.join(EXTRACTED, extracted_tool)
    
    # Read all wiki content
    wiki_content = ""
    for f in os.listdir(wiki_dir):
        if f.endswith(".md"):
            with open(os.path.join(wiki_dir, f), "r", encoding="utf-8") as fh:
                wiki_content += fh.read().lower()
    
    # Get source PDF list
    pdfs = sorted([f.replace(".txt","") for f in os.listdir(ext_dir) if f.endswith(".txt")])
    
    # Check coverage by looking for key content from each PDF
    # Instead of filename, check if the PDF's key concepts are in wiki
    covered = 0
    gaps = []
    for pdf in pdfs:
        ext_file = os.path.join(ext_dir, pdf + ".txt")
        if not os.path.exists(ext_file):
            gaps.append(pdf)
            continue
        
        # Read first 2000 chars of extracted PDF to get key terms
        with open(ext_file, "r", encoding="utf-8") as fh:
            head = fh.read(2000).lower()
        
        # Extract unique terms (3+ word phrases, commands, etc.)
        # Simple check: are 30%+ of the PDF's distinctive words in wiki?
        words = set(w for w in head.split() if len(w) > 4 and w.isalpha())
        if not words:
            covered += 1
            continue
        
        wiki_words = set(wiki_content.split())
        overlap = words & wiki_words
        ratio = len(overlap) / len(words) if words else 0
        
        if ratio > 0.15:  # 15% word overlap threshold
            covered += 1
        else:
            gaps.append(pdf)
    
    pct = covered * 100 // len(pdfs) if pdfs else 0
    print(f"\n{wiki_tool}: {covered}/{len(pdfs)} ({pct}%) covered")
    if gaps:
        print(f"  Potential gaps ({len(gaps)}):")
        for g in gaps[:10]:
            print(f"    - {g}")
        if len(gaps) > 10:
            print(f"    ... and {len(gaps)-10} more")
