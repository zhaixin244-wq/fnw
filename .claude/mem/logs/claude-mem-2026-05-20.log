import os, re

wiki_dir = 'wiki/eda/synopsys'
source_dir = '.raw/sources/eda/synopsys'

# Collect all source references from wiki (frontmatter source fields + index 源文档清单)
wiki_sources = set()
for root, dirs, files in os.walk(wiki_dir):
    for f in files:
        if f.endswith('.md'):
            with open(os.path.join(root, f), 'r', encoding='utf-8') as fh:
                content = fh.read()
                # Extract source field
                m = re.search(r'source:\s*(.+)', content)
                if m:
                    for s in m.group(1).split(','):
                        s = s.strip().lower()
                        if s.endswith('.pdf') or s.endswith('.txt'):
                            wiki_sources.add(s.replace('.txt', '.pdf'))
                # Also find PDF names mentioned anywhere in the file
                for pdf_name in re.findall(r'[\w\-\(\)]+\.pdf', content, re.IGNORECASE):
                    wiki_sources.add(pdf_name.lower())

# Get all source PDFs
source_pdfs = set()
for root, dirs, files in os.walk(source_dir):
    for f in files:
        if f.lower().endswith('.pdf'):
            source_pdfs.add(f.lower())

# Check coverage
covered = source_pdfs & wiki_sources
missing = source_pdfs - wiki_sources

print(f'Total source PDFs: {len(source_pdfs)}')
print(f'Referenced in wiki: {len(covered)}')
print(f'Not referenced: {len(missing)}')
print(f'Coverage: {len(covered)*100//len(source_pdfs)}%')
print()
if missing:
    print('PDFs not explicitly referenced:')
    for m in sorted(missing):
        print(f'  - {m}')
