import os, re

# Map source PDFs to wiki pages
wiki_dir = 'wiki/eda/synopsys'
source_dir = '.raw/sources/eda/synopsys'

# Get all wiki content
wiki_text = ''
for root, dirs, files in os.walk(wiki_dir):
    for f in files:
        if f.endswith('.md'):
            with open(os.path.join(root, f), 'r', encoding='utf-8') as fh:
                wiki_text += fh.read() + '\n'

# Get all source PDF filenames
source_pdfs = []
for root, dirs, files in os.walk(source_dir):
    for f in files:
        if f.lower().endswith('.pdf'):
            source_pdfs.append(f)

# Check which PDFs are referenced in wiki
missing = []
covered = []
for pdf in sorted(source_pdfs):
    name = pdf.replace('.pdf', '')
    if name.lower() in wiki_text.lower():
        covered.append(pdf)
    else:
        missing.append(pdf)

print(f'Total source PDFs: {len(source_pdfs)}')
print(f'Covered in wiki: {len(covered)}')
print(f'Missing from wiki: {len(missing)}')
print()
if missing:
    print('Missing PDFs:')
    for m in missing:
        print(f'  - {m}')
else:
    print('All PDFs covered!')
