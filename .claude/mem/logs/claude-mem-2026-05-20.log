import fitz, os
base = os.path.join(os.getcwd(), 'tools', 'claude-obsidian', '.raw', 'sources', 'eda', 'synopsys')
total_pages = 0
total_pdfs = 0
truncated = 0
for tool_dir in os.listdir(base):
    tool_path = os.path.join(base, tool_dir, '2603')
    if not os.path.isdir(tool_path):
        continue
    for f in os.listdir(tool_path):
        if f.lower().endswith('.pdf'):
            try:
                doc = fitz.open(os.path.join(tool_path, f))
                p = len(doc)
                doc.close()
                total_pages += p
                total_pdfs += 1
                if p > 50:
                    truncated += 1
            except: pass
print(f'Total PDFs: {total_pdfs}')
print(f'Total pages: {total_pages}')
print(f'Truncated (>50): {truncated}')
print(f'Pages lost (est): {total_pages - total_pdfs * 50}')
")
