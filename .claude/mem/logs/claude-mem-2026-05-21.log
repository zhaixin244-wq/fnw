[2026-05-21 11:17:09.934] [INFO ] [HOOK  ] → PostToolUse: Bash(python3 << 'PYEOF'
import re

# Step 1: Parse lint log
with open('.claude/skills/rtl-lint-resolver/test_spyglass.log', 'r') as f:
    log_lines = f.readlines()

violations = []
for line in log_lines:
    line = line.strip()
    m = re.match(r'(Warning|Error|Info)\s+\[(\S+)\]\s+(\S+):(\d+)\s+(.*)', line)
    if m:
        violations.append({
            'severity': m.group(1),
            'rule': m.group(2),
            'file': m.group(3),
            'line': m.group(4),
            'message': m.group(5)
        })

print(f"Parsed {len(violations)} violations")

# Step 2: Map rule -> JMTAG
with open('.claude/skills/rtl-lint-resolver/lint-jmtag-mapping.md', 'r', encoding='utf-8') as f:
    mapping_content = f.read()

# Build mapping dict
rule_to_jmtag = {}
for line in mapping_content.split('\n'):
    m = re.match(r'\|\s*(\S+)\s*\|\s*(JM_\S+)\s*\|', line)
    if m:
        rule_to_jmtag[m.group(1)] = m.group(2)

# Step 3: Classify violations
for v in violations:
    v['jmtag'] = rule_to_jmtag.get(v['rule'], 'UNKNOWN')

# Print classification
from collections import Counter
jmtag_counts = Counter(v['jmtag'] for v in violations)
print("\nClassification:")
for tag, count in sorted(jmtag_counts.items()):
    print(f"  {tag}: {count}")

# Print details
print("\nViolation Details:")
for v in violations:
    print(f"  [{v['jmtag']}] {v['rule']} @ {v['file']}:{v['line']} - {v['message'][:60]}")
PYEOF)
