import re

with open('.claude/skills/rtl-lint-resolver/lint-jmtag-mapping.md', 'r', encoding='utf-8') as f:
    content = f.read()

levels = ['JM_E0', 'JM_E1', 'JM_E2', 'JM_E3', 'JM_Warning', 'JM_Info', 'JM_HARDEN']
total = 0
for level in levels:
    pattern = r'\| (\S+) \| ' + level + r' \|'
    matches = re.findall(pattern, content)
    count = len(matches)
    total += count
    print(f'{level}: {count} rules')

print(f'Total mapped: {total} rules')

with open('.claude/skills/rtl-lint-resolver/SKILL.md', 'r', encoding='utf-8') as f:
    skill = f.read()

if skill.startswith('---'):
    end = skill.index('---', 3)
    fm = skill[3:end]
    print(f'Frontmatter OK ({len(fm)} chars)')
    has_name = 'name:' in fm
    has_desc = 'description:' in fm
    print(f'name: {has_name}, description: {has_desc}')
"
)
