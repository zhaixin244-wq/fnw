import json
with open('.claude/shared/flow/e-stage-detail.json', encoding='utf-8') as f:
    data = json.load(f)
    tt = data.get('tree_todolist', {}).get('standardized_template', {})
    if 'rule_reload_mechanism' in tt:
        rrm = tt['rule_reload_mechanism']
        r02 = [f for f in rrm.get('reload_files', []) if f.get('id') == 'R-02']
        if r02:
            print('R-02 found in tree_todolist.standardized_template.rule_reload_mechanism')
            print('Has note:', 'note' in r02[0])
        else:
            print('R-02 not found in reload_files')
    else:
        # Search all keys recursively
        def find_key(d, target, path=''):
            if isinstance(d, dict):
                for k, v in d.items():
                    if k == target:
                        print(f'Found {target} at {path}.{k}')
                        return v
                    r = find_key(v, target, f'{path}.{k}')
                    if r is not None:
                        return r
            elif isinstance(d, list):
                for i, v in enumerate(d):
                    r = find_key(v, target, f'{path}[{i}]')
                    if r is not None:
                        return r
            return None
        result = find_key(data, 'rule_reload_mechanism')
        if result:
            r02 = [f for f in result.get('reload_files', []) if f.get('id') == 'R-02']
            if r02:
                print('R-02 has note:', 'note' in r02[0])
"
)
