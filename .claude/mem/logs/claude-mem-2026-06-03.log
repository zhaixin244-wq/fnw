import json, sys, re
sys.stdout.reconfigure(encoding='utf-8')

# 3. stageB phase2
with open('.claude/shared/flow/stageB-detail.json', 'r', encoding='utf-8') as f:
    sbd = json.load(f)
p = sbd['post_stageB_brainstorming']['new_req_persistence']
print('=== 3. stageB phase2 写入目标 ===')
print(f'  rule: {p[\"rule\"]}')
print(f'  blocking: {p[\"blocking_rule\"]}')
ok = 'flow/' in p['rule'] and 'pr' in p['rule'].lower()
print(f'  consistent: {ok}')

# 4. stageD 执行顺序
with open('.claude/shared/flow/stageD-detail.json', 'r', encoding='utf-8') as f:
    sdd = json.load(f)
rec = sdd['recommended_execution_order']
print()
print('=== 4. stageD 执行顺序 ===')
print(f'  iron_law: {\"铁律\" in rec[\"description\"]}')
g2 = rec['stageD group2']
print(f'  group2: {g2}')
idx4 = g2.index('stageD group2-step4')
idx3 = g2.index('stageD group2-step3')
print(f'  step4({idx4}) before step3({idx3}): {idx4 < idx3}')

# 5. e-stage
with open('.claude/shared/flow/e-stage-detail.json', 'r', encoding='utf-8') as f:
    esd = json.load(f)
tpl = esd['tree_todolist']['standardized_template']['template']
devs = esd['submodule_deliverables']['required_files']
fb = esd['e_stage_definition'].get('max_recursion_depth_fallback','')
print()
print('=== 5. e-stage 模板 ===')
print(f'  parent_sync_in_template: {\"parent_requirement_sync\" in tpl}')
print(f'  deliverable_count: {len(devs)}')
print(f'  has_todolist: {any(\"todolist\" in d.get(\"filename\",\"\").lower() for d in devs)}')
print(f'  recursion_fallback: {bool(fb)}')

# 6. 评估标准
with open('.claude/evaluation_criteria/chip-requirement-arch-eva.md', 'r', encoding='utf-8') as f:
    eva = f.read()
m1 = re.search(r'G-17.*?≥(\d+)', eva)
m2 = re.search(r'Q&A\s*≥\s*(\d+)', eva)
m3 = re.search(r'G-08.*?≥(\d+)', eva)
print()
print('=== 6. 评估阈值 ===')
print(f'  G-17: >= {m1.group(1) if m1 else \"?\"}')
print(f'  D4.2: >= {m2.group(1) if m2 else \"?\"}')
print(f'  G-08: >= {m3.group(1) if m3 else \"?\"}')

# 7. PPA
with open('.claude/shared/change-propagation-v2.md', 'r', encoding='utf-8') as f:
    cp = f.read()
print()
print('=== 7. PPA 阈值 ===')
print(f'  >20% present: {\">20%\" in cp}')
print(f'  大幅+>20%: {\"大幅调整（>20%\" in cp}')

# 8. Others
with open('.claude/shared/requirement-template.json', 'r', encoding='utf-8') as f:
    rt = json.load(f)
term = sbd['post_stageB_brainstorming']['multi_round_rules'].get('forced_termination_behavior','')
rules = rt['flow']['input_triage']['rules']
exc = rt['flow']['exception_handling']
print()
print('=== 8. 杂项 ===')
print(f'  forced_termination: {bool(term)}')
print(f'  input_triage_dim: {any(\"约束维度\" in r for r in rules)}')
print(f'  step_mode_enforcement: {any(e.get(\"step_mode_enforcement\") for e in exc)}')

# 9. DFT standalone check
print()
print('=== 9. 独立 DFT 残留 ===')
check_files = [
    ('e-stage-detail', '.claude/shared/flow/e-stage-detail.json'),
    ('requirement-template', '.claude/shared/requirement-template.json'),
    ('requirement-checklist', '.claude/shared/requirement-checklist.json'),
    ('conflict-rules', '.claude/shared/conflict-detection-rules.json'),
]
for name, path in check_files:
    with open(path, 'r', encoding='utf-8') as f:
        content = f.read()
    # Find standalone DFT (not part of DFX)
    lines_with_dft = [l.strip() for l in content.split('\\n') if 'DFT' in l and 'DFX' not in l]
    if lines_with_dft:
        for l in lines_with_dft[:3]:
            print(f'  {name}: {l[:80]}')
    else:
        # Check in raw content
        if 'DFT' in content:
            print(f'  {name}: has DFT in raw JSON (may be in DFX/DFT combo)')
")
