import json, os

results = []

# OPT-12: stageD split
for i in range(1, 6):
    path = f'.claude/shared/flow/stageD-group{i}.json'
    assert os.path.exists(path), f'{path} missing'
    with open(path, encoding='utf-8') as f:
        data = json.load(f)
        assert 'sub_stages' in data
        assert data['group'] == f'stageD group{i}'
    results.append(f'OPT-12 stageD-group{i}.json: PASS')

with open('.claude/shared/flow/stageD-detail.json', encoding='utf-8') as f:
    data = json.load(f)
    assert 'sub_stages_ref' in data and 'sub_stages' not in data
    results.append('OPT-12 stageD-detail.json metadata: PASS')

with open('.claude/shared/context-layers.json', encoding='utf-8') as f:
    data = json.load(f)
    assert '2.0K' in data['layers']['L2_stage']['stages']['stageD']['budget']
    results.append('OPT-12 context-layers.json: PASS')

# Total steps
total = 0
for i in range(1, 6):
    with open(f'.claude/shared/flow/stageD-group{i}.json', encoding='utf-8') as f:
        total += len(json.load(f)['sub_stages'])
assert total == 20
results.append(f'OPT-12 total steps: {total}/20 PASS')

# OPT-13: e-stage R-02
with open('.claude/shared/flow/e-stage-detail.json', encoding='utf-8') as f:
    data = json.load(f)
    rrm = data['tree_todolist']['rule_reload_mechanism']
    r02 = [f for f in rrm['reload_files'] if f['id'] == 'R-02'][0]
    assert 'note' in r02
    results.append('OPT-13 e-stage R-02 note: PASS')

# OPT-15: area-estimation
with open('.claude/shared/flow/area-estimation.json', encoding='utf-8') as f:
    data = json.load(f)
    assert 'data_source_note' in data['estimation_framework']
    results.append('OPT-15 area-estimation: PASS')

# OPT-16: execution-hints
with open('.claude/shared/flow/execution-hints.json', encoding='utf-8') as f:
    data = json.load(f)
    assert 'stageA_ref_version' in data
    results.append('OPT-16 execution-hints: PASS')

for r in results:
    print(r)
print('\\nAll batch D verifications PASSED')
"
)
