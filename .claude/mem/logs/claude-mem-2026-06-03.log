import json, sys, os
sys.stdout.reconfigure(encoding='utf-8')

files = [
    '.claude/shared/flow/stageB-detail.json',
    '.claude/shared/flow/stageD-detail.json',
    '.claude/shared/flow/stage-definition.json',
    '.claude/shared/flow/e-stage-detail.json',
    '.claude/shared/solution-template.json',
    '.claude/shared/requirement-template.json',
    '.claude/shared/requirement-checklist.json',
    '.claude/shared/conflict-detection-rules.json',
    '.claude/shared/flow/stageC-detail.json',
    '.claude/shared/change-propagation-v2.md',
    '.claude/evaluation_criteria/chip-requirement-arch-eva.md',
    '.claude/agents/chip-requirement-arch.md',
]

print('=== 修改验证 ===')
for f in files:
    path = f
    if os.path.exists(path):
        if path.endswith('.json'):
            try:
                with open(path, 'r', encoding='utf-8') as fh:
                    json.load(fh)
                print(f'✅ {f} — JSON 合法')
            except json.JSONDecodeError as e:
                print(f'❌ {f} — JSON 错误: {e}')
        else:
            size = os.path.getsize(path)
            print(f'✅ {f} — {size} bytes')
    else:
        print(f'⚠️ {f} — 文件不存在')

# Specific consistency checks
print()
print('=== 一致性检查 ===')

# Check DFX/DFT
with open('.claude/shared/flow/stageD-detail.json', 'r', encoding='utf-8') as f:
    d = json.load(f)
wiki_map = d.get('wiki_brainstorm_integration', {}).get('wiki_search_mapping', {}).get('stageD group5-step3', [])
print(f'DFX wiki mapping: {wiki_map}')

# Check recommended_execution_order
rec = d.get('recommended_execution_order', {})
g2 = rec.get('stageD group2', [])
print(f'group2 execution order: {g2}')

# Check parent_requirement_sync in todolist template
with open('.claude/shared/flow/e-stage-detail.json', 'r', encoding='utf-8') as f:
    e = json.load(f)
template = e['tree_todolist']['standardized_template']['template']
has_sync = 'parent_requirement_sync' in template
print(f'Todolist template has parent_requirement_sync: {has_sync}')

# Check submodule deliverables count
deliverables = e['submodule_deliverables']['required_files']
print(f'Submodule deliverables count: {len(deliverables)}')

# Check max_recursion_depth fallback
fallback = e['e_stage_definition'].get('max_recursion_depth_fallback', 'NOT DEFINED')
print(f'Max recursion fallback: {fallback[:60]}...')
")
