[2026-06-03 11:31:05.470] [INFO ] [HOOK  ] → PostToolUse: Bash(cd "D:\work\ai\fnw\arch" && python -c "
import json
f = json.load(open('.claude/shared/flow/stageD-detail.json', encoding='utf-8'))
subs = {s['id']: s for s in f['sub_stages']}

# Check for self-references
print('=== Self-reference check ===')
for s in f['sub_stages']:
    if s['id'] in s.get('depends_on', []):
        print(f'  SELF-REF: {s[\"id\"]} depends_on itself!')
    else:
        pass
print('  No self-references found')

# Check group4-step3 (was phase4-3) depends_on
g4s3 = subs.get('stageD group4-step3', {})
print(f'\\n=== group4-step3 depends_on: {g4s3.get(\"depends_on\", [])} ===')

# Check group3-step4 (was phase3-1) depends_on
g3s4 = subs.get('stageD group3-step4', {})
print(f'=== group3-step4 depends_on: {g3s4.get(\"depends_on\", [])} ===')

# Check all depends_on resolve to valid IDs
all_ids = set(subs.keys())
print('\\n=== Unresolved depends_on ===')
unresolved = 0
for s in f['sub_stages']:
    for dep in s.get('depends_on', []):
        if dep not in all_ids:
            print(f'  UNRESOLVED: {s[\"id\"]} depends on {dep}')
            unresolved += 1
if unresolved == 0:
