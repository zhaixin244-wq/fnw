    '.claude/shared/flow/protocol-mapping.json',
]
print('=== JSON Validation ===')
for f in json_files:
    try:
        json.load(open(f, encoding='utf-8'))
        print('  OK  ' + os.path.basename(f))
    except Exception as e:
        errors.append(f + ': ' + str(e))
        print('  FAIL ' + os.path.basename(f) + ': ' + str(e))

print()
print('=== Old Encoding Residue ===')
shared_dir = '.claude/shared'
has_residue = False
for root, dirs, files in os.walk(shared_dir):
    for fname in files:
        if not (fname.endswith('.json') or fname.endswith('.md')):
            continue
        fpath = os.path.join(root, fname)
        try:
            content = open(fpath, encoding='utf-8').read()
        except:
            continue
        if '14条' in content:
            errors.append(fname + ': has 14条')
            print('  FAIL ' + fname + ': has 14条')
            has_residue = True
        if '\"max_rounds\": 3' in content or 'max_rounds.*3' in content:
            if '\"max_rounds\": 3' in content:
                errors.append(fname + ': max_rounds=3')
                print('  FAIL ' + fname + ': max_rounds=3')
                has_residue = True
if not has_residue:
    print('  OK  No old encoding residues')

print()
print('=== stageD Encoding ===')
stageD = json.load(open('.claude/shared/flow/stageD-detail.json', encoding='utf-8'))
subs = stageD['sub_stages']
gp = sum(1 for s in subs if re.match(r'stageD group\d+-step\d+', s['id']))
ph = sum(1 for s in subs if re.match(r'stageD phase\d+-\d+', s['id']))
print('  Sub_stages: ' + str(len(subs)) + ' total, ' + str(gp) + ' group/step, ' + str(ph) + ' phase/sub-stage')
if ph > 0:
    errors.append('stageD-detail.json: ' + str(ph) + ' old phase IDs')
    print('  FAIL ' + str(ph) + ' old phase IDs remain')
else:
    print('  OK  All use group/step encoding')

sd = json.load(open('.claude/shared/flow/stage-definition.json', encoding='utf-8'))
sd_groups = sd['stage_definitions']['stageD'].get('groups', {})
sd_steps = sum(len(g.get('steps', {})) for g in sd_groups.values())
print('  stage-definition.json: ' + str(sd_steps) + ' steps, ' + str(len(sd_groups)) + ' groups')
if sd_steps == 20:
    print('  OK  Matches agent (20 steps)')

print()
print('=== Cross-File Consistency ===')
agent = open('.claude/agents/chip-requirement-arch.md', encoding='utf-8').read()

if 'stageD group{N}-step{M}' in agent:
    print('  OK  Agent uses group/step encoding')
else:
    errors.append('Agent encoding table not group/step')
    print('  FAIL Agent encoding table not group/step')

if 'protocol-mapping.json' in agent:
    print('  OK  Agent L2 has protocol-mapping.json')

cr = json.load(open('.claude/shared/conflict-detection-rules.json', encoding='utf-8'))
actual = len(cr['detection_rules'])
if '17' in cr['description']:
    print('  OK  conflict-rules: 17 in desc, actual=' + str(actual))
else:
    errors.append('conflict-rules desc mismatch')
    print('  FAIL conflict-rules desc mismatch')

sc1 = open('.claude/shared/flow/stageC-phase1-detail.json', encoding='utf-8').read()
if '17' in sc1:
    print('  OK  stageC-phase1-detail says 17')

rt = json.load(open('.claude/shared/requirement-template.json', encoding='utf-8'))
sbd = json.load(open('.claude/shared/flow/stageB-detail.json', encoding='utf-8'))
rt_mr = rt['flow']['stageB phase2']['new_req_rules']['max_rounds']
sbd_mr = sbd['post_stageB_brainstorming']['new_req_rules']['max_rounds']
sbd_mr2 = sbd['post_stageB_brainstorming']['multi_round_rules']['max_rounds']
print('  max_rounds: template=' + str(rt_mr) + ' stageB-detail=' + str(sbd_mr) + ' multi_round=' + str(sbd_mr2))
if rt_mr == sbd_mr == sbd_mr2 == 5:
    print('  OK  max_rounds consistent at 5')
else:
    errors.append('max_rounds inconsistency')
    print('  FAIL max_rounds inconsistency')

scd = json.load(open('.claude/shared/flow/stageC-detail.json', encoding='utf-8'))
if 'grey_expression_handling' in scd.get('confirmation_rules', {}):
    errors.append('grey_expression_handling still present')
    print('  FAIL grey_expression_handling still present')
else:
    print('  OK  grey_expression_handling removed')

print()
print('=== SUMMARY ===')
print('  Errors: ' + str(len(errors)))
print('  Warnings: ' + str(len(warnings)))
if not errors:
    print('  ALL CHECKS PASSED')
else:
    for e in errors:
        print('  FAIL: ' + e)
