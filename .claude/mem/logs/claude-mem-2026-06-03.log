[2026-06-03 11:12:49.002] [INFO ] [HOOK  ] → PostToolUse: Bash(cd "D:/work/ai/fnw/arch" && python -c "
import json
f=open('.claude/shared/flow/stageD-detail.json','r',encoding='utf-8')
d=json.load(f)
f.close()

# Collect all valid IDs
ids = {s['id'] for s in d['sub_stages']}

# Check depends_on references
print('=== depends_on check ===')
ok = True
for s in d['sub_stages']:
    for dep in s.get('depends_on', []):
        if dep not in ids:
            print(f'  BROKEN: {s[\"id\"]} depends on {dep}')
            ok = False
if ok:
    print('  All depends_on references valid')

# Check for any remaining 'phase' references in IDs
print()
print('=== Old phase references check ===')
import re
text = json.dumps(d)
old_refs = re.findall(r'stageD phase\d+-\d+', text)
if old_refs:
    print(f'  FOUND old references: {set(old_refs)}')
else:
    print('  No old stageD phase{N}-{M} references found')

# Check phases sub_stages match
print()
print('=== Phase sub_stages check ===')
for pname, phase in d['phases'].items():
    for sid in phase['sub_stages']:
        if sid not in ids:
            print(f'  BROKEN: {pname} references {sid} not in sub_stages')
    print(f'  {pname}: {len(phase[\"sub_stages\"])} sub_stages')

# Check min_qa_pairs coverage
print()
print('=== min_qa_pairs coverage ===')
adr_ids = set(d['adr_brainstorm_record_format']['min_qa_pairs']['overrides'].keys())
depth_ids = set(d['substage_depth_requirements']['min_qa_pairs'].keys()) - {'default'}
print(f'  adr overrides: {len(adr_ids)} entries')
print(f'  depth requirements: {len(depth_ids)} entries')
missing_adr = ids - adr_ids - {'stageD group1-step1'}  # group1-step1 is in adr as 'stageD group1-step1'
# Actually check properly
for sid in ids:
    adr_key = sid
    if adr_key not in adr_ids:
        print(f'  Missing in adr overrides: {sid}')
    if adr_key not in depth_ids:
        print(f'  Missing in depth requirements: {sid}')
print('  Coverage check complete')
")
