print('Has phases:', 'phases' in d)
print('Lines:', len(open('.claude/shared/flow/stageD-detail.json', encoding='utf-8').readlines()))

# Check each group file
for i in range(1, 6):
    with open(f'.claude/shared/flow/stageD-group{i}.json', 'r', encoding='utf-8') as f:
        g = json.load(f)
    steps = [s['id'] for s in g['sub_stages']]
    print(f'=== stageD-group{i}.json: {g[\"name\"]} ({len(steps)} steps) ===')
    for s in steps:
        print(f'  - {s}')

# Check context-layers.json stageD section
with open('.claude/shared/context-layers.json', 'r', encoding='utf-8') as f:
    c = json.load(f)
sd = c['layers']['L2_stage']['stages']['stageD']
print('=== context-layers.json stageD ===')
print('files:', [f['path'] for f in sd['files']])
print('budget:', sd['budget'])

# Check execution-hints.json
with open('.claude/shared/flow/execution-hints.json', 'r', encoding='utf-8') as f:
    h = json.load(f)
print('=== execution-hints.json ===')
print('Has stageA_ref_version:', 'stageA_ref_version' in h)

# Check area-estimation.json
with open('.claude/shared/flow/area-estimation.json', 'r', encoding='utf-8') as f:
    a = json.load(f)
print('=== area-estimation.json ===')
print('Has data_source_note:', 'data_source_note' in a['estimation_framework'])
" 2>&1
)
