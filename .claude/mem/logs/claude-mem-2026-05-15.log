[2026-05-15 10:37:36.918] [INFO ] [HOOK  ] → PostToolUse: Bash(cd "D:\work\ai\fnw\arch" && python -c "
import os, re

agents_dir = '.claude/agents'
files_to_remove = [
    'wiki-mandatory-search.md',
    'degradation-strategy.md', 
    'interaction-style.md',
    'file-permission.md'
]
replacement = 'agent-common-base.md'

count = 0
for fname in os.listdir(agents_dir):
    if not fname.startswith('chip-') or not fname.endswith('.md'):
        continue
    fpath = os.path.join(agents_dir, fname)
    with open(fpath, 'r', encoding='utf-8') as f:
        content = f.read()
    
    modified = False
    # Check if all 4 files are in includes
    has_all = all('  - .claude/shared/' + ft in content for ft in files_to_remove)
    
    if has_all:
        # Remove all 4 lines and add replacement
        lines = content.split('\n')
        new_lines = []
        added_replacement = False
        for line in lines:
            stripped = line.strip()
            should_remove = False
            for ft in files_to_remove:
                if stripped == '- .claude/shared/' + ft:
                    should_remove = True
                    break
            if should_remove:
                if not added_replacement:
                    new_lines.append('  - .claude/shared/' + replacement)
                    added_replacement = True
            else:
                new_lines.append(line)
        
        new_content = '\n'.join(new_lines)
        if new_content != content:
            with open(fpath, 'w', encoding='utf-8') as f:
                f.write(new_content)
            count += 1
            print(f'Updated: {fname}')
    else:
        # Check which ones are present
        present = [ft for ft in files_to_remove if '  - .claude/shared/' + ft in content]
        if present:
            print(f'Partial match in {fname}: {present}')
        else:
            print(f'No match in {fname}')

print(f'\nTotal updated: {count}')
"
)
