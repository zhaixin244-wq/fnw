    '详细规则见 \`.claude/shared/file-permission.md\`': '详细规则见 \`.claude/shared/agent-common-base.md\` §四',
    '遵循 \`.claude/shared/wiki-mandatory-search.md\`': '遵循 \`.claude/shared/agent-common-base.md\` §三',
    '遵循 \`.claude/shared/degradation-strategy.md\`': '遵循 \`.claude/shared/agent-common-base.md\` §二',
    '遵循 \`.claude/shared/interaction-style.md\`': '遵循 \`.claude/shared/agent-common-base.md\` §一',
}

count = 0
for fname in sorted(os.listdir(agents_dir)):
    if not fname.startswith('chip-') or not fname.endswith('.md'):
        continue
    fpath = os.path.join(agents_dir, fname)
    with open(fpath, 'r', encoding='utf-8') as f:
        content = f.read()
    
    original = content
    for old, new in replacements.items():
        content = content.replace(old, new)
    
    if content != original:
        with open(fpath, 'w', encoding='utf-8') as f:
            f.write(content)
        count += 1
        print(f'Updated body refs: {fname}')

print(f'\nTotal: {count}')
"
)
