with open('.claude/shared/vcoding-style.md', 'r', encoding='utf-8') as f:
    lines = f.readlines()

# Find section boundaries
sec_starts = {}
for i, line in enumerate(lines):
    if line.startswith('## '):
        sec_num = line.split('.')[0].replace('## ', '').strip()
        sec_starts[sec_num] = i

# Core: header + §1-§10 + §19-§22
# Advanced: §11-§18 + §23

# Find line indices
s1 = sec_starts['1']
s11 = sec_starts['11']
s19 = sec_starts['19']
s23 = sec_starts['23']

header = lines[0:s1]
sec1_10 = lines[s1:s19]
sec11_18 = lines[s11:s23]
sec19_22 = lines[s19:s23]
sec23 = lines[s23:]

# Core = header + §1-10 + §19-22 + footer
core_header = '''---
name: UVM Verification Coding Style (Core)
description: UVM-1.2 验证环境编码规范核心版。覆盖日常编码必需的 §1-§10 + §19-§22。
---

# 验证环境编码规范（UVM 1.2）— 核心版

> 适用范围：所有 UVM 验证环境代码。语言：SystemVerilog（IEEE 1800-2012）+ UVM 1.2。
> 本规范与 `rules/coding-style.md`（RTL 编码规范）互补——RTL 管可综合代码，本规范管验证环境。
>
> **高级内容**（Interface/BFM、参数化、复位、Objection、Phase、TLM、宏、报告、RAL）见 `vcoding-style-advanced.md`，按需加载。

---

'''

core_footer = '''
---

> **本文件为核心版，覆盖日常 UVM 编码的 14 个关键章节。**
> **高级内容**（§11 Interface/BFM、§12 参数化、§13 复位、§14 Objection、§15 Phase、§16 TLM、§17 宏、§18 报告、§23 RAL）见 `vcoding-style-advanced.md`。
'''

advanced_header = '''---
name: UVM Verification Coding Style (Advanced)
description: UVM-1.2 验证环境编码规范高级版。覆盖 Interface/BFM、参数化、复位、Objection、Phase、TLM、宏、报告、RAL。
---

# 验证环境编码规范（UVM 1.2）— 高级版

> 本文件为 `vcoding-style-core.md` 的补充，覆盖特殊场景的 9 个章节。
> **仅在需要时加载**（如编写 Interface、RAL 模型、自定义 Phase 等）。

---

'''

# Write core
with open('.claude/shared/vcoding-style-core.md', 'w', encoding='utf-8') as f:
    f.write(core_header)
    f.writelines(sec1_10)
    f.write('\n---\n\n')
    f.writelines(sec19_22)
    f.write(core_footer)

# Write advanced
with open('.claude/shared/vcoding-style-advanced.md', 'w', encoding='utf-8') as f:
    f.write(advanced_header)
    f.writelines(sec11_18)
    f.write('\n---\n\n')
    f.writelines(sec23)

import os
core_size = os.path.getsize('.claude/shared/vcoding-style-core.md')
adv_size = os.path.getsize('.claude/shared/vcoding-style-advanced.md')
orig_size = os.path.getsize('.claude/shared/vcoding-style.md')

print(f'Original:  {orig_size:>6} bytes ({orig_size//4} tokens)')
print(f'Core:      {core_size:>6} bytes ({core_size//4} tokens)')
print(f'Advanced:  {adv_size:>6} bytes ({adv_size//4} tokens)')
print(f'Core only saves: ~{(orig_size - core_size)//4} tokens per agent')
"
)
