[2026-06-02 23:00:36.115] [INFO ] [HOOK  ] → PostToolUse: Bash(wsl -d Ubuntu -- bash -c "cat > /root/gem5/resilient_build.sh << 'SCRIPT'
#!/bin/bash
# 自愈构建脚本 — scons 被杀后自动重试直到 gem5.opt 生成
cd /root/gem5
export srctree=/root/gem5
LOG=/root/gem5/build_persistent.log
MAX_RETRIES=50
RETRY=0

echo \"[\$(date)] === Resilient gem5 build started ===\" >> \$LOG

while [ \$RETRY -lt \$MAX_RETRIES ]; do
    # 检查是否已完成
    if [ -f build/ARM/gem5.opt ]; then
        echo \"[\$(date)] BUILD SUCCESS! gem5.opt exists.\" >> \$LOG
        exit 0
    fi

    RETRY=\$((RETRY + 1))
    echo \"[\$(date)] Attempt \$RETRY/\$MAX_RETRIES\" >> \$LOG

    # 运行 scons，记录退出码
    scons build/ARM/gem5.opt -j12 >> \$LOG 2>&1
    EXIT_CODE=\$?

    echo \"[\$(date)] scons exited with code \$EXIT_CODE\" >> \$LOG

    # 退出码 0 = 成功
    if [ \$EXIT_CODE -eq 0 ]; then
        if [ -f build/ARM/gem5.opt ]; then
            echo \"[\$(date)] BUILD SUCCESS!\" >> \$LOG
            exit 0
        fi
    fi

    # 被信号杀死（SIGTERM=143, SIGKILL=137）= WSL 崩溃，重试
    if [ \$EXIT_CODE -eq 137 ] || [ \$EXIT_CODE -eq 143 ]; then
        echo \"[\$(date)] Killed by signal, retrying in 3s...\" >> \$LOG
        sleep 3
        continue
    fi

    # 其他错误（编译错误），等久一点再试
    echo \"[\$(date)] Error \$EXIT_CODE, retrying in 10s...\" >> \$LOG
    sleep 10
done

echo \"[\$(date)] BUILD FAILED after \$MAX_RETRIES attempts\" >> \$LOG
exit 1
SCRIPT
chmod +x /root/gem5/resilient_build.sh && echo 'Script created'")
