import sys, io
sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')
from docx import Document

# Extract PMU section from Santorini Function Spec
doc = Document('.raw/sources/jm-chip-str/sdae/Santorini SDAE Function Specification.docx')
in_pmu = False
pmu_lines = []
for para in doc.paragraphs:
    if 'PMU' in para.text and para.style.name.startswith('Heading'):
        in_pmu = True
    elif para.style.name.startswith('Heading') and in_pmu and 'PMU' not in para.text:
        in_pmu = False
    if in_pmu and para.text.strip():
        pmu_lines.append(para.text.strip())

print('=== PMU Section ===')
for line in pmu_lines[:50]:
    print(line)

# Extract register sections
in_reg = False
reg_lines = []
for para in doc.paragraphs:
    if '寄存器' in para.text and para.style.name.startswith('Heading'):
        in_reg = True
    elif para.style.name.startswith('Heading') and in_reg and '寄存器' not in para.text:
        in_reg = False
    if in_reg and para.text.strip():
        reg_lines.append(para.text.strip())

print()
print('=== Register Sections ===')
for line in reg_lines[:60]:
    print(line)
" 2>&1 | head -150
)
