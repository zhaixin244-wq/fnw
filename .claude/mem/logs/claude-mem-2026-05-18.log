from docx import Document
import sys

files = [
    'tools/claude-obsidian/.raw/sources/jm-chip-str/sdae/Greenland1.0 SDAE软硬件协同详细设计-v0.5.docx',
    'tools/claude-obsidian/.raw/sources/jm-chip-str/sdae/Santorini SDAE Function Specification.docx',
    'tools/claude-obsidian/.raw/sources/jm-chip-str/sdae/Santorini SDAE初始化.docx',
]

for f in files:
    print('='*80)
    print(f'FILE: {f}')
    print('='*80)
    doc = Document(f)
    for i, para in enumerate(doc.paragraphs):
        if para.text.strip():
            style = para.style.name if para.style else ''
            prefix = ''
            if 'Heading' in style:
                level = style.replace('Heading ', '')
                prefix = '#' * int(level) + ' ' if level.isdigit() else '## '
            print(f'{prefix}{para.text}')
    # Also extract tables
    for ti, table in enumerate(doc.tables):
        print(f'\n--- Table {ti+1} ---')
        for ri, row in enumerate(table.rows):
            cells = [cell.text.strip().replace('\\n',' ') for cell in row.cells]
            print(' | '.join(cells))
    print()
" 2>&1 | head -3000)
