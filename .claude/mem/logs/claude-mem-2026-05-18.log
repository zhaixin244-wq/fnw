import sys, io
sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')
import openpyxl

wb = openpyxl.load_workbook('.raw/sources/jm-chip-str/sdae/Greenland1.0 SDAE数据面描述符-v0.5.xlsx', data_only=True)

# Extract DoorBell sheet
ws = wb['DoorBell ']
print('=== DoorBell Sheet ===')
for row in ws.iter_rows(min_row=1, max_row=ws.max_row, values_only=False):
    vals = [str(cell.value) if cell.value is not None else '' for cell in row]
    if any(v for v in vals):
        print(' | '.join(vals[:10]))

print()

# Extract 12-Dif Check for flags detail
ws2 = wb['12-Dif Check']
print('=== DIF Check Sheet ===')
for row in ws2.iter_rows(min_row=1, max_row=ws2.max_row, values_only=False):
    vals = [str(cell.value) if cell.value is not None else '' for cell in row]
    if any(v for v in vals):
        print(' | '.join(vals[:10]))
" 2>&1 | head -200
)
