import os

d = r'D:\work\ai\fnw\arch\tools\claude-obsidian\_attachments\pcie'
files = sorted(os.listdir(d))

# Remove small images (likely logos/icons) - under 5KB for embedded, under 30KB for renders
removed = 0
kept = 0
for f in files:
    path = os.path.join(d, f)
    size = os.path.getsize(path)
    is_render = '_render.png' in f
    threshold = 30000 if is_render else 5000
    if size < threshold:
        os.remove(path)
        removed += 1
    else:
        kept += 1

