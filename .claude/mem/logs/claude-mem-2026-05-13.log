import json, math, urllib.request, sys, io
sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')

texts = ["芯片设计", "集成电路设计", "RTL编码", "今天天气很好", "CPU架构设计"]

# Test SiliconFlow API with bge-large-zh-v1.5
payload = {
    "model": "BAAI/bge-large-zh-v1.5",
    "input": texts,
    "encoding_format": "float"
}
req = urllib.request.Request(
    "https://api.siliconflow.cn/v1/embeddings",
    data=json.dumps(payload).encode(),
    headers={
        "Content-Type": "application/json",
        "Authorization": "Bearer sk-xnostmggqxrpgqxojzowuwwpvvtdgcvwpszieffkjqmmoldn"
    }
)
resp = urllib.request.urlopen(req)
data = json.loads(resp.read())
embeddings = [item["embedding"] for item in data["data"]]

def cosine_sim(a, b):
    dot = sum(x*y for x,y in zip(a,b))
    norm_a = math.sqrt(sum(x*x for x in a))
    norm_b = math.sqrt(sum(x*x for x in b))
    return dot / (norm_a * norm_b)

print("=== SiliconFlow bge-large-zh-v1.5 (API) ===\n")

