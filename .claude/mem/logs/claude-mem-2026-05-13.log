import fitz
import os

output_dir = r'D:\work\ai\fnw\arch\tools\claude-obsidian\_attachments\pcie'

# Try DM databook and user guide with render approach
pdfs = {
    'dm': {
        'path': r'D:\work\ai\fnw\arch\tools\claude-obsidian\.raw\sources\pice\DWC_pcie_ctl_dm_databook.pdf',
        'pages': [10, 11, 15, 16, 19, 21, 22, 26, 27, 28, 39, 40, 41, 42, 43, 48, 49, 55, 56, 57, 60],
        'prefix': 'dm'
    },
    'user': {
        'path': r'D:\work\ai\fnw\arch\tools\claude-obsidian\.raw\sources\pice\DWC_pcie_ctl_user.pdf',
        'pages': [10, 14, 40, 48, 56, 64, 88, 126, 140, 166, 176, 226, 260],
        'prefix': 'user'
    }
}

total = 0
for name, info in pdfs.items():
    doc = fitz.open(info['path'])
    prefix = info['prefix']
    extracted = 0
    for page_idx in info['pages']:
        if page_idx >= doc.page_count:
            continue
        page = doc[page_idx]
        # Try extracting embedded images
        imgs = page.get_images(full=True)
        for img_idx, img in enumerate(imgs):
            xref = img[0]
            try:
                base_image = doc.extract_image(xref)
                if base_image and base_image['image']:
                    ext = base_image['ext']
                    w, h = base_image['width'], base_image['height']
                    if w < 50 or h < 50:
                        continue
                    fname = f'{prefix}_p{page_idx+1}_img{img_idx+1}.{ext}'
                    fpath = os.path.join(output_dir, fname)
                    with open(fpath, 'wb') as f:
                        f.write(base_image['image'])
                    extracted += 1
            except:
                pass
        
        # If no embedded images, render the page as image
        if not imgs:
            try:
                mat = fitz.Matrix(2, 2)  # 2x zoom
                pix = page.get_pixmap(matrix=mat)
                fname = f'{prefix}_p{page_idx+1}_render.png'
                fpath = os.path.join(output_dir, fname)
                pix.save(fpath)
                extracted += 1
            except:
                pass
    
    doc.close()
    total += extracted
    print(f'{name}: extracted {extracted} items')

print(f'Total: {total}')
