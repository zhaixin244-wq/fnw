import json, os

cache_hooks_path = os.path.expanduser("~/.claude/plugins/cache/thedotmack/claude-mem/13.2.0/hooks/hooks.json")
if not os.path.exists(cache_hooks_path):
    print("Cache hooks.json not found")
    exit(0)

with open(cache_hooks_path, "r", encoding="utf-8") as f:
    data = json.load(f)

scripts_dir = os.path.expanduser("~/.claude/plugins/marketplaces/thedotmack/plugin/scripts")
scripts_dir = scripts_dir.replace("\\", "/")

count = 0
for event, hooks in data.get("hooks", {}).items():
    if not isinstance(hooks, list):
        continue
    for hg in hooks:
        for h in hg.get("hooks", []):
            cmd = h.get("command", "")
            if "printf" in cmd and ("bun-runner" in cmd or "worker-service" in cmd or "version-check" in cmd):
                idx = cmd.find('node "$_P/scripts/')
                if idx >= 0:
                    node_part = cmd[idx:]
                    path_prefix = ""
                    if cmd.startswith("export PATH="):
                        path_end = cmd.find("; ", cmd.find("export PATH="))
                        if path_end > 0:
                            path_prefix = cmd[:path_end + 2]
                    h["command"] = path_prefix + '_P="' + scripts_dir + '"; ' + node_part
                    count += 1
                    print(f"Fixed: {event}")

with open(cache_hooks_path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
print(f"Fixed {count} hooks in cache hooks.json")
ENDSCRIPT
python /tmp/fix_cache_hooks.py)
