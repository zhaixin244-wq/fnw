import json, os

hooks_path = os.path.expanduser("~/.claude/plugins/marketplaces/thedotmack/plugin/hooks/hooks.json")
with open(hooks_path, "r", encoding="utf-8") as f:
    data = json.load(f)

# The known-good path to claude-mem scripts
SCRIPTS_DIR = os.path.expanduser("~/.claude/plugins/marketplaces/thedotmack/plugin/scripts")
SCRIPTS_DIR_POSIX = SCRIPTS_DIR.replace("\\", "/")

# New simplified command that bypasses the broken printf pipeline
# Uses direct path instead of dynamic resolution
FIXED_PREFIX = '_P="' + SCRIPTS_DIR_POSIX + '"; '

count = 0
for event_name, event_hooks in data["hooks"].items():
    if not isinstance(event_hooks, list):
        continue
    for hook_group in event_hooks:
        if "hooks" not in hook_group:
            continue
        for hook in hook_group["hooks"]:
            cmd = hook.get("command", "")
            if "bun-runner.js" in cmd and "printf" in cmd:
                # Extract the final node command part (after the path resolution)
                # Find "node \"$_P/scripts/bun-runner.js\"..."
                idx = cmd.find('node "$_P/scripts/bun-runner.js"')
                if idx >= 0:
                    node_part = cmd[idx:]
                    # Replace with simplified version
                    hook["command"] = FIXED_PREFIX + node_part
                    count += 1
                    print(f"Fixed: {event_name} hook")

with open(hooks_path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2, ensure_ascii=False)

print(f"\nTotal fixed: {count} hooks")
ENDSCRIPT
python /tmp/fix_hooks.py)
