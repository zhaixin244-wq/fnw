import json, os

settings_path = os.path.expanduser("~/.claude/settings.json")
with open(settings_path, "r", encoding="utf-8") as f:
    settings = json.load(f)

scripts_dir = os.path.expanduser("~/.claude/plugins/marketplaces/thedotmack/plugin/scripts")
scripts_dir = scripts_dir.replace("\\", "/")

count = 0
hooks = settings.get("hooks", {})
for event, hook_list in hooks.items():
    if not isinstance(hook_list, list):
        continue
    for hg in hook_list:
        for h in hg.get("hooks", []):
            cmd = h.get("command", "")
            # Check for the problematic printf pipeline pattern
            if "printf" in cmd and ("bun-runner" in cmd or "worker-service" in cmd):
                # Find the final node command
                idx = cmd.find('node "$_P/scripts/')
                if idx >= 0:
                    node_part = cmd[idx:]
                    # Extract the export PATH prefix if present
                    path_prefix = ""
                    if cmd.startswith("export PATH="):
                        path_end = cmd.find("; ", cmd.find("export PATH="))
                        if path_end > 0:
                            path_prefix = cmd[:path_end + 2]
                    h["command"] = path_prefix + '_P="' + scripts_dir + '"; ' + node_part
                    count += 1
                    print(f"Fixed: {event} hook")

with open(settings_path, "w", encoding="utf-8") as f:
    json.dump(settings, f, indent=2, ensure_ascii=False)
print(f"\nFixed {count} hooks in settings.json")
