    grade=$(grep -oP '(?:等级|Grade).*?\*\*([SABCD])' "$score_file" | grep -oP '[SABCD]' | head -1)
    if [ -z "$grade" ]; then
      grade=$(grep -oP 'S\s*级|A\s*级|B\s*级|C\s*级|D\s*级' "$score_file" | head -1 | cut -c1)
    fi
    echo "$case_id|$total|$grade"
  fi
done | sort) | depth=1
