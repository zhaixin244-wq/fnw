{
  "version": "1.0",
  "description": "D 阶段上下文隔离配置 — 每个 Phase 使用独立 subagent，Phase 间传递精简摘要",

  "enabled": true,

  "execution_model": {
    "description": "每个 Phase（group1~group5）使用独立 subagent 执行，拥有全新上下文窗口",
    "phase_summary_max_size": "≤1K tokens",
    "phase_summary_output_path": "flow/group{N}_summary.md",
    "max_context_per_phase": "15K tokens"
  },

  "phase_input_output": {
    "stageD group1": {
      "input_files": ["outputs/{module}_requirement_summary_v1.0.md"],
      "output_summary": "flow/stageD_group1_summary.md"
    },
    "stageD group2": {
      "input_files": ["flow/stageD_group1_summary.md"],
      "output_summary": "flow/stageD_group2_summary.md"
    },
    "stageD group3": {
      "input_files": ["flow/stageD_group2_summary.md"],
      "output_summary": "flow/stageD_group3_summary.md"
    },
    "stageD group4": {
      "input_files": ["flow/stageD_group2_summary.md"],
      "output_summary": "flow/stageD_group4_summary.md"
    },
    "stageD group5": {
      "input_files": ["flow/stageD_group1_summary.md", "flow/stageD_group2_summary.md"],
      "output_summary": "flow/stageD_group5_summary.md"
    }
  },

  "anti_drift_mechanism": {
    "description": "每个 subagent 仅接收精简摘要，不传递父级完整历史，确保注意力集中",
    "rules": [
      "摘要必须包含：关键 REQ 约束、已确认的设计决策、待确认项",
      "摘要不含：完整 Q&A 记录、头脑风暴原始对话、中间推导过程",
      "每个 subagent 启动时重新读取 Agent 定义（规则重载）"
    ]
  }
}
