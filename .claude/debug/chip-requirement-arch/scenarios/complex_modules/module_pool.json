  "test_dimensions": {
    "D1": "需求采集完整性（stage0/stageA/stageB/stageB phase2）",
    "D2": "需求一致性（stageC phase1 矛盾检测）",
    "D3": "需求文档质量（REQ 编号、schema_version、规格自检）",
    "D4": "方案细化质量（stageD 子阶段、Q&A、RTL 就绪度）",
    "D5": "子模块分解质量（E 阶段递归分解、目录结构）",
    "D6": "顶层集成质量（F 阶段接口一致性、拓扑图）",
    "D7": "ADR 文档质量（Nygard 格式、头脑风暴记录）",
    "D8": "方案验证与评审（devils-advocate、Critical 规则）",
    "D9": "追溯完整性（REQ 编号、trace_graph、RTM）",
    "D10": "过程规范性（代办清单、文件管理、记忆集成）"
  },

  "user_personas": {
    "E": "clear_expert — 清晰表达的芯片专家",
    "V": "vague_beginner — 模糊表达的新手",
    "C": "challenging_reviewer — 挑战性审查者"
